    /* ===================== UTILITARIOS ===================== */

    function clean(v) { return (v || "").replace(/\s+/g, " ").trim(); }

    function isVisible(el) {
        if (!el) return false;
        const rect = el.getBoundingClientRect();
        const css = getComputedStyle(el);
        return rect.width > 0 && rect.height > 0 &&
            css.display !== "none" &&
            css.visibility !== "hidden" &&
            Number(css.opacity) !== 0;
    }

    function readPage() {
        const clone = document.body.cloneNode(true);
        ["#pgFloat","#pgToggle","#pgNotify","script","style","noscript","svg","iframe"]
            .forEach(sel => clone.querySelectorAll(sel).forEach(el => el.remove()));
        return (clone.innerText || "")
            .replace(/\n{3,}/g, "\n\n").trim().slice(0, 30000);
    }

    async function clickEl(el) {
        if (!el) return false;
        try {
            el.scrollIntoView({ block: "center", behavior: "instant" });
            await wait(60);
            el.dispatchEvent(new PointerEvent("pointerdown", { bubbles: true }));
            el.dispatchEvent(new MouseEvent("mousedown", { bubbles: true }));
            el.dispatchEvent(new MouseEvent("mouseup", { bubbles: true }));
            el.dispatchEvent(new PointerEvent("pointerup", { bubbles: true }));
            el.click();
            return true;
        } catch {
            return false;
        }
    }

    /* ===================== DROPDOWNS (V/F) ===================== */

    function getDropdowns() {
        const results = [];
        const seen = new Set();

        const primary = [
            ...document.querySelectorAll('button.options-dropdown'),
            ...document.querySelectorAll('[data-cy^="dropdown-"]')
        ];

        for (const el of primary) {
            if (!el || seen.has(el)) continue;
            if (el.closest("#pgFloat")) continue;
            if (!isVisible(el)) continue;
            seen.add(el);
            results.push(el);
        }

        if (results.length === 0) {
            const fallbacks = [
                ...document.querySelectorAll('[role="combobox"]'),
                ...document.querySelectorAll('[aria-haspopup="listbox"]')
            ];
            for (const el of fallbacks) {
                if (!el || seen.has(el)) continue;
                if (el.closest("#pgFloat")) continue;
                if (!isVisible(el)) continue;
                seen.add(el);
                results.push(el);
            }
        }

        results.sort((a, b) => {
            const ra = a.getBoundingClientRect();
            const rb = b.getBoundingClientRect();
            if (Math.abs(ra.top - rb.top) > 8) return ra.top - rb.top;
            return ra.left - rb.left;
        });

        return results;
    }

    function findOptionsFor(btn) {
        if (!btn) return [];
        const describedBy = btn.getAttribute("aria-describedby");
        if (describedBy) {
            const popper = document.getElementById(describedBy);
            if (popper) {
                const opts = [...popper.querySelectorAll("button.dropdown-option, [role='option']")]
                    .filter(isVisible);
                if (opts.length) {
                    return opts.map(el => ({
                        text: clean(el.innerText || el.textContent),
                        element: el
                    })).filter(o => o.text);
                }
                const anyBtn = [...popper.querySelectorAll("button")]
                    .filter(isVisible)
                    .map(el => ({ text: clean(el.innerText || el.textContent), element: el }))
                    .filter(o => o.text && o.text.length < 120);
                if (anyBtn.length) return anyBtn;
            }
        }
        return [...document.querySelectorAll("button.dropdown-option, [role='option']")]
            .filter(isVisible)
            .map(el => ({ text: clean(el.innerText || el.textContent), element: el }))
            .filter(o => o.text);
    }

    function waitForOptions(btn, timeoutMs = 1200) {
        return new Promise(resolve => {
            const t0 = Date.now();
            const tick = () => {
                const opts = findOptionsFor(btn);
                if (opts.length > 0) return resolve(opts);
                if (Date.now() - t0 >= timeoutMs) return resolve([]);
                setTimeout(tick, 100);
            };
            tick();
        });
    }

    function waitForClose(btn, timeoutMs = 1500) {
        return new Promise(resolve => {
            if (!btn) return resolve(true);
            const t0 = Date.now();
            const tick = () => {
                if (!btn.getAttribute("aria-describedby")) return resolve(true);
                if (Date.now() - t0 >= timeoutMs) return resolve(false);
                setTimeout(tick, 100);
            };
            tick();
        });
    }

    async function scanDropdowns() {
        document.dispatchEvent(new KeyboardEvent("keydown", { key: "Escape", bubbles: true }));
        await wait(300);

        const buttons = getDropdowns();
        if (buttons.length === 0) return [];

        const fields = [];
        for (let i = 0; i < buttons.length; i++) {
            const fresh = getDropdowns();
            const btn = fresh[i];
            if (!btn || !isVisible(btn)) continue;

            const pgid = "pgd_" + i + "_" + Math.random().toString(36).slice(2, 8);
            try { btn.setAttribute("data-pgid", pgid); } catch {}

            const currentLabel = clean(btn.innerText || btn.textContent);
            const opened = await clickEl(btn);
            if (!opened) {
                fields.push({
                    campo: i + 1,
                    valorAtual: currentLabel || "(sem texto)",
                    opcoesDetectadas: [],
                    element: btn,
                    pgid,
                    erro: "Não foi possível abrir o menu."
                });
                continue;
            }

            const optEls = await waitForOptions(btn, 1200);
            const options = optEls.map(o => o.text);

            fields.push({
                campo: i + 1,
                valorAtual: currentLabel || "(sem texto)",
                opcoesDetectadas: options,
                element: btn,
                pgid,
                erro: options.length === 0 ? "Nenhuma opção detectada." : ""
            });

            document.dispatchEvent(new KeyboardEvent("keydown", { key: "Escape", bubbles: true }));
            await waitForClose(btn, 1000);
            await wait(120);
        }
        return fields;
    }

