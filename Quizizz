            '[data-cy*="option"]',
            '[class*="AnswerOption"]',
            '[class*="answer-option"]',
            '[class*="option-container"]',
            '[role="radio"]',
            '[role="checkbox"]'
        ];

        for (const sel of specificSelectors) {
            let list;
            try { list = document.querySelectorAll(sel); } catch { continue; }
            const items = [];
            const seen = new Set();
            for (const el of list) {
                if (!el || seen.has(el)) continue;
                if (el.closest("#pgFloat")) continue;
                if (!isVisible(el)) continue;
                if (el.matches("button.options-dropdown, [data-cy^='dropdown-'], .match-order-option-inner")) continue;

                const text = clean(el.innerText || el.textContent);
                if (!text || text.length > 500) continue;
                if (/^(enviar|submit|undo|menu|bars|bônus|bonus)/i.test(text)) continue;
                if (/^\d+$/.test(text)) continue;

                seen.add(el);
                items.push({ element: el, text });
            }
            const deduped = dedupeChoices(items);
            if (deduped.length >= 2) return deduped;
        }

        const letterRe = /^\s*([A-Ea-e])\s*[\.\)\-:]\s*(.+)$/;
        const lettered = [];
        const seen = new Set();
        for (const el of document.querySelectorAll('button, [role="button"], [role="radio"], [role="checkbox"]')) {
            if (seen.has(el)) continue;
            if (el.closest("#pgFloat")) continue;
            if (!isVisible(el)) continue;
            if (el.matches(".match-order-option-inner")) continue;
            const text = clean(el.innerText || el.textContent);
            if (!text || text.length > 500) continue;
            if (!letterRe.test(text)) continue;
            seen.add(el);
            lettered.push({ element: el, text });
        }
        const dedupedLettered = dedupeChoices(lettered);
        if (dedupedLettered.length >= 2) return dedupedLettered;

        return [];
    }

    function dedupeChoices(items) {
        if (!items.length) return items;

        const filtered = items.filter(item =>
            !items.some(other =>
                other !== item && item.element.contains(other.element) &&
                clean(other.text) === clean(item.text)
            )
        );

        const byText = new Map();
        for (const it of filtered) {
            const k = it.text.toLowerCase();
            if (!byText.has(k)) byText.set(k, it);
        }
        const out = [...byText.values()];

        out.sort((a, b) => {
            const ra = a.element.getBoundingClientRect();
            const rb = b.element.getBoundingClientRect();
            if (Math.abs(ra.top - rb.top) > 8) return ra.top - rb.top;
            return ra.left - rb.left;
        });

        return out;
    }

    /* ===================== MATCH / ASSOCIACAO ===================== */

    function getMatchData() {
        const all = [...document.querySelectorAll(".match-order-option-inner")];
        const prompts = [];
        const tiles = [];
        const seenP = new Set();
        const seenT = new Set();

        for (const el of all) {
            if (el.closest("#pgFloat")) continue;
            if (!isVisible(el)) continue;

            const text = clean(el.innerText || el.textContent);
            if (!text) continue;

            const isTile = el.classList.contains("is-drop-tile");
            if (isTile) {
                if (seenT.has(text)) continue;
                seenT.add(text);
                tiles.push({ element: el, text });
            } else {
                if (seenP.has(text)) continue;
                seenP.add(text);
                prompts.push({ element: el, text });
            }
        }

        const sortByPos = arr => arr.sort((a, b) => {
            const ra = a.element.getBoundingClientRect();
            const rb = b.element.getBoundingClientRect();
            if (Math.abs(ra.top - rb.top) > 8) return ra.top - rb.top;
            return ra.left - rb.left;
        });

        sortByPos(prompts);
        sortByPos(tiles);

        if (prompts.length === 0 && tiles.length === 0) return null;
        return { prompts, tiles };
    }

    function isMatchFilled(promptEl) {
        if (!promptEl) return false;
        if (!promptEl.isConnected) return true;
        const cls = (promptEl.className || "") + "";
        if (/matched|paired|is-matched|has-match|done/i.test(cls)) return true;
        return false;
    }

    async function applyMatchPair(promptText, tileText, promptIndex) {
        if (!promptText || !tileText) return { ok: false, motivo: "Sem texto para associar." };

        const data = getMatchData();
        if (!data) return { ok: false, motivo: "Questão de associação não encontrada." };

        const prompt = data.prompts.find(p => normalize(p.text) === normalize(promptText))
            || data.prompts.find(p => {
                const a = normalize(p.text);
                const b = normalize(promptText);
                return a.length >= 3 && b.length >= 3 && (a.includes(b) || b.includes(a));
            })
            || data.prompts[promptIndex];

        const tile = data.tiles.find(t => normalize(t.text) === normalize(tileText))
            || data.tiles.find(t => {
                const a = normalize(t.text);
                const b = normalize(tileText);
                return a.length >= 3 && b.length >= 3 && (a.includes(b) || b.includes(a));
            });

        if (!prompt) return { ok: false, motivo: "Prompt não encontrado: " + promptText.slice(0, 40) };
        if (!tile) return { ok: false, motivo: "Região não encontrada: " + tileText.slice(0, 40) };

        await pointerDrag(prompt.element, tile.element);
        await wait(300);
        if (isMatchFilled(prompt.element)) return { ok: true };

        const ok1 = await clickEl(prompt.element);
        if (ok1) {
            await wait(250);
            const ok2 = await clickEl(tile.element);
            if (ok2) {
                await wait(450);
                return { ok: true };
            }
        }

        try {
            const dt = new DataTransfer();
            const opts = { bubbles: true, cancelable: true, dataTransfer: dt };
            prompt.element.dispatchEvent(new DragEvent("dragstart", opts));
            await wait(60);
            tile.element.dispatchEvent(new DragEvent("dragenter", opts));
            tile.element.dispatchEvent(new DragEvent("dragover", opts));
            tile.element.dispatchEvent(new DragEvent("drop", opts));
            await wait(60);
            prompt.element.dispatchEvent(new DragEvent("dragend", opts));
        } catch {}
        await wait(350);

        return { ok: true };
    }

    /* ===================== DRAG-AND-DROP ===================== */

    function getDroppableBlanks() {
        const list = [
            ...document.querySelectorAll('[data-cy^="droppable-blank"]'),
            ...document.querySelectorAll('[class*="droppable-blank"]'),
            ...document.querySelectorAll('[class*="drag-and-drop-blank"]')
        ];
        const seen = new Set();
        const out = [];
        for (const el of list) {
            if (!el || seen.has(el)) continue;
            if (el.closest("#pgFloat")) continue;
            if (!isVisible(el)) continue;
            seen.add(el);
            out.push(el);
        }
        out.sort((a, b) => {
            const ra = a.getBoundingClientRect();
            const rb = b.getBoundingClientRect();
            if (Math.abs(ra.top - rb.top) > 8) return ra.top - rb.top;
            return ra.left - rb.left;
        });
        return out;
    }

    function getDraggableItems() {
        const candidates = [];
        const seen = new Set();

        const specificSelectors = [
            '[data-cy*="drag-item"]',
            '[data-cy*="dragItem"]',
            '[data-cy*="drag-option"]',
            '[data-cy*="option-item"]',
            '[draggable="true"]',
            '[class*="drag-item"]',
            '[class*="DragItem"]',
            '[class*="draggable"]'
        ];

        for (const sel of specificSelectors) {
            let list;
            try { list = document.querySelectorAll(sel); } catch { continue; }
            for (const el of list) {
                if (!el || seen.has(el)) continue;
                if (el.closest("#pgFloat")) continue;
                if (!isVisible(el)) continue;
                if (el.matches('[data-cy^="droppable-blank"]')) continue;

                const text = clean(el.innerText || el.textContent);
                if (!text || text.length > 200) continue;
                if (/^(enviar|submit|undo|menu|bars|bônus|bonus|placeholder)$/i.test(text)) continue;
                if (/^\d+$/.test(text)) continue;

                seen.add(el);
                candidates.push({ element: el, text });
            }
            if (candidates.length >= 2) break;
        }

        if (candidates.length < 2) {
            for (const el of document.querySelectorAll('button, [role="button"], div[class*="option"], div[class*="Option"]')) {
                if (seen.has(el)) continue;
                if (el.closest("#pgFloat")) continue;
                if (!isVisible(el)) continue;
                if (el.matches("button.options-dropdown, [data-cy^='dropdown-'], [data-cy^='droppable-blank'], [aria-label='Enviar'], [aria-label='undo'], [aria-label='bars'], .match-order-option-inner")) continue;

                const rect = el.getBoundingClientRect();
                if (rect.width < 40 || rect.height < 20) continue;

                const text = clean(el.innerText || el.textContent);
                if (!text || text.length > 60) continue;
                if (/^(enviar|submit|undo|menu|bars|bônus|bonus|placeholder|question\s*\d+)/i.test(text)) continue;
                if (/^\d+\s*(of|\/)\s*\d+$/i.test(text)) continue;
                if (/^\d+$/.test(text)) continue;

                seen.add(el);
                candidates.push({ element: el, text });
            }
        }

        const cleaned = candidates.filter(c =>
            !candidates.some(o =>
                o !== c && c.element.contains(o.element) &&
                clean(o.text) === clean(c.text) &&
                o.element.getBoundingClientRect().width > c.element.getBoundingClientRect().width
            )
        );

        const byText = new Map();
        for (const c of cleaned) {
            const k = c.text.toLowerCase();
            if (!byText.has(k)) byText.set(k, c);
        }
        const out = [...byText.values()];

        out.sort((a, b) => {
            const ra = a.element.getBoundingClientRect();
            const rb = b.element.getBoundingClientRect();
            if (Math.abs(ra.top - rb.top) > 8) return ra.top - rb.top;
            return ra.left - rb.left;
        });

        return out;
    }

    function isBlankFilled(blank) {
        if (!blank) return false;
        if (!blank.isConnected) return true;

        const text = clean(blank.innerText || blank.textContent);
        if (text && !/^placeholder$/i.test(text) && text.length >= 1) return true;

        const cls = (blank.className || "") + "";
        if (/filled|dropped|has-item|dropped-item|with-item/i.test(cls)) return true;

        const filho = [...blank.querySelectorAll("*")].find(el => {
            if (!isVisible(el)) return false;
            if (el.tagName === "SPAN" && /placeholder/i.test(el.className)) return false;
            const t = clean(el.innerText || el.textContent);
            return t && t.length >= 1 && !/^placeholder$/i.test(t);
        });
        if (filho) return true;

        return false;
    }

    async function pointerDrag(source, target) {
        const sRect = source.getBoundingClientRect();
        const tRect = target.getBoundingClientRect();
        const startX = Math.round(sRect.left + sRect.width / 2);
        const startY = Math.round(sRect.top + sRect.height / 2);
        const endX = Math.round(tRect.left + tRect.width / 2);
        const endY = Math.round(tRect.top + tRect.height / 2);

        const PID = 1;

        const firePointer = (type, x, y, el) => {
            try {
                el.dispatchEvent(new PointerEvent(type, {
                    bubbles: true, cancelable: true, composed: true,
                    pointerId: PID, pointerType: "mouse",
                    clientX: x, clientY: y,
                    button: 0, buttons: type === "pointerup" ? 0 : 1,
                    isPrimary: true
                }));
            } catch {}
        };
        const fireMouse = (type, x, y, el) => {
            try {
                el.dispatchEvent(new MouseEvent(type, {
                    bubbles: true, cancelable: true, composed: true,
                    clientX: x, clientY: y, button: 0,
                    buttons: type === "mouseup" ? 0 : 1
                }));
            } catch {}
        };
        const fireTouch = (type, x, y, el) => {
            try {
                const t = new Touch({ identifier: 1, target: el, clientX: x, clientY: y });
                el.dispatchEvent(new TouchEvent(type, {
                    bubbles: true, cancelable: true, composed: true,
                    touches: type === "touchend" ? [] : [t],
                    targetTouches: type === "touchend" ? [] : [t],
                    changedTouches: [t]
                }));
            } catch {}
        };

        source.scrollIntoView({ block: "center", behavior: "instant" });
        await wait(80);

        firePointer("pointerdown", startX, startY, source);
        fireMouse("mousedown", startX, startY, source);
        fireTouch("touchstart", startX, startY, source);
        await wait(60);

        const STEPS = 18;
        for (let i = 1; i <= STEPS; i++) {
            const p = i / STEPS;
            const x = Math.round(startX + (endX - startX) * p);
            const y = Math.round(startY + (endY - startY) * p);
            const elUnder = document.elementFromPoint(x, y) || target;

            firePointer("pointermove", x, y, elUnder);
            fireMouse("mousemove", x, y, elUnder);
            fireTouch("touchmove", x, y, elUnder);

            if (i === 1) {
                try {
                    const dt = new DataTransfer();
                    source.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer: dt }));
                    elUnder.dispatchEvent(new DragEvent("dragenter", { bubbles: true, cancelable: true, dataTransfer: dt }));
                } catch {}
            }
            if (i === STEPS) {
                try {
                    const dt = new DataTransfer();
                    elUnder.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: dt }));
                    elUnder.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer: dt }));
                } catch {}
            }
            await wait(18);
        }

        await wait(80);
        firePointer("pointerup", endX, endY, target);
        fireMouse("mouseup", endX, endY, target);
        fireTouch("touchend", endX, endY, target);

        try {
            const dt = new DataTransfer();
            source.dispatchEvent(new DragEvent("dragend", { bubbles: true, cancelable: true, dataTransfer: dt }));
        } catch {}

        await wait(200);
    }

    async function applyDragDropAnswer(itemText, blankIndex) {
        if (!itemText) return { ok: false, motivo: "Sem item para arrastar." };

        const blanks = getDroppableBlanks();
        if (blanks.length === 0) return { ok: false, motivo: "Nenhum blank encontrado." };
        const blank = blanks[blankIndex];
        if (!blank || !isVisible(blank)) return { ok: false, motivo: "Blank não está visível." };

        const items = getDraggableItems();
        const target = items.find(it => normalize(it.text) === normalize(itemText))
            || items.find(it => {
                const a = normalize(it.text);
                const b = normalize(itemText);
                return a.length >= 3 && b.length >= 3 && (a.includes(b) || b.includes(a));
            });

        if (!target) return { ok: false, motivo: "Item não encontrado: " + itemText };

        await pointerDrag(target.element, blank);
        await wait(300);
        if (isBlankFilled(blank)) return { ok: true };

        const ok1 = await clickEl(target.element);
        if (ok1) {
            await wait(250);
            const ok2 = await clickEl(blank);
            if (ok2) {
                await wait(450);
                if (isBlankFilled(blank)) return { ok: true };
            }
        }

        try {
            const dt = new DataTransfer();
            const opts = { bubbles: true, cancelable: true, dataTransfer: dt };
            target.element.dispatchEvent(new DragEvent("dragstart", opts));
            await wait(60);
            blank.dispatchEvent(new DragEvent("dragenter", opts));
            blank.dispatchEvent(new DragEvent("dragover", opts));
            blank.dispatchEvent(new DragEvent("drop", opts));
            await wait(60);
            target.element.dispatchEvent(new DragEvent("dragend", opts));
        } catch {}
        await wait(350);

        if (isBlankFilled(blank)) return { ok: true };

        return { ok: false, motivo: "Nenhuma estratégia de drop funcionou." };
    }

    /* ===================== BOTAO ENVIAR ===================== */

    function findSubmitButton() {
        const candidatos = [];

        document.querySelectorAll('[data-cy="submit-button"], button[aria-label="Enviar"], button[aria-label="Submit"]')
            .forEach(el => candidatos.push(el));

        if (candidatos.length === 0) {
            for (const el of document.querySelectorAll('button, [role="button"]')) {
                if (el.closest("#pgFloat")) continue;
                if (!isVisible(el)) continue;
                const text = clean(el.innerText || el.textContent);
                if (/^(enviar|submit|confirmar|confirm|responder)$/i.test(text)) {
                    candidatos.push(el);
                }
            }
        }

        for (const el of candidatos) {
            if (el.closest("#pgFloat")) continue;
            if (!isVisible(el)) continue;
            return el;
        }
        return null;
    }

    async function clickSubmit() {
        let submit = null;
        for (let i = 0; i < 15; i++) {
            submit = findSubmitButton();
            if (submit && !submit.disabled) break;
            await wait(200);
        }
        if (!submit) return { ok: false, motivo: "Botão Enviar não encontrado." };
        if (submit.disabled) return { ok: false, motivo: "Botão Enviar ainda desabilitado." };
        const ok = await clickEl(submit);
        if (ok) {
            notify("Resposta enviada!");
            return { ok: true };
        }
        return { ok: false, motivo: "Falha ao clicar em Enviar." };
    }

    /* ===================== MATCH HELPERS ===================== */

    function extractLetter(v) {
        const s = clean(v);
        if (!s) return null;
        if (/^[a-eA-E]$/.test(s)) return { letter: s.toLowerCase(), rest: "" };
        const m = s.match(/^([a-eA-E])\s*[\.\)\-:]\s*(.*)$/);
        if (m) return { letter: m[1].toLowerCase(), rest: (m[2] || "").trim() };
        return null;
    }

    function stripLetterPrefix(v) {
        const s = clean(v);
        const m = s.match(/^([a-eA-E])\s*[\.\)\-:]\s*(.*)$/);
        if (m) return (m[2] || "").trim();
        return s;
    }

    function normalize(v) {
        return stripLetterPrefix(v)
            .toLowerCase()
            .replace(/[“”"']/g, "")
            .replace(/\s+/g, " ")
            .trim();
    }

    function matchOption(suggestion, options) {
        if (!suggestion || !Array.isArray(options) || options.length === 0) return "";
        const raw = clean(suggestion);
        if (!raw || /^indeterminado$/i.test(raw)) return "";

        const letterInfo = extractLetter(raw);
        if (letterInfo) {
            const targetLetter = letterInfo.letter;
            for (const opt of options) {
                const ol = extractLetter(opt);
                if (ol && ol.letter === targetLetter) return opt;
            }
            const anyHasLetter = options.some(opt => extractLetter(opt));
            if (!anyHasLetter && !letterInfo.rest) {
                const idx = targetLetter.charCodeAt(0) - 97;
                if (idx >= 0 && idx < options.length) return options[idx];
            }
        }

        const s = normalize(raw);
        if (!s) return "";
        for (const opt of options) if (normalize(opt) === s) return opt;
        for (const opt of options) {
            const o = normalize(opt);
            if (o.length >= 3 && s.length >= 3 && (s.includes(o) || o.includes(s))) return opt;
        }
        for (const opt of options) {
            const o = normalize(opt);
            if (o.length < 6 || s.length < 6) continue;
            if (o.slice(0, 6) === s.slice(0, 6)) return opt;
        }
        return "";
    }

    function parseNumberedAnswers(text) {
        if (!text) return [];
        const map = {};
        const re = /^\s*(\d{1,3})\s*[\.\)\-:]\s*(.+?)\s*$/gm;
        let m;
        while ((m = re.exec(text)) !== null) {
            const n = parseInt(m[1], 10);
            const val = m[2].trim();
            if (!val) continue;
            if (!map[n]) map[n] = val;
        }
        return Object.keys(map).map(Number).sort((a, b) => a - b)
            .map(n => ({ n, text: map[n] }));
    }

    /* ===================== PROMPT (BLINDADO) ===================== */

    function buildPrompt(data, extra) {
        // Blindagem total contra dados malformados
        data = data || {};
        const type = typeof data.tipoQuestao === "string" ? data.tipoQuestao : "";
        const fields = Array.isArray(data.menus) ? data.menus : [];
        const choices = Array.isArray(data.alternativas) ? data.alternativas : [];
        const blanks = Array.isArray(data.blanks) ? data.blanks : [];
        const draggables = Array.isArray(data.itensArrastaveis) ? data.itensArrastaveis : [];

        const match = (data.associacao && typeof data.associacao === "object") ? data.associacao : null;
        const matchPrompts = (match && Array.isArray(match.prompts)) ? match.prompts : [];
        const matchRegioes = (match && Array.isArray(match.regioes)) ? match.regioes : [];

        const fotoNote = data.temFoto ? `
ATENCAO: o usuario anexou uma FOTO da questao. Use a FOTO como FONTE PRIMARIA.
Leia com atencao TODAS as alternativas/textos visiveis na foto antes de responder.
Se o conteudo do DOM nao bater com a foto, priorize a foto.
` : "";

        const instructions = {
            vf: `\nAnalise cada afirmação separadamente.\nOrganize na ordem em que aparecem: número, sugestão (Verdadeira/Falsa/Indeterminada)\ne uma justificativa curta.\n`,
            alternativa: `\nIdentifique a alternativa CORRETA.\nResponda com a LETRA e o TEXTO exato. Ex.: "B) Falso".\n`,
            multi: `\nAnalise as alternativas e diga quais devem ser assinaladas.\nUse a LETRA e o TEXTO de cada uma.\n`,
            match: `\nAssocie cada característica à sua região correta.\n`
