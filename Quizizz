    /* ===================== RENDER ===================== */

    function renderFields() {
        const container = $("pgFields");
        if (!container) return;
        container.innerHTML = "";

        if (autoApply) {
            const hint = document.createElement("div");
            hint.className = "pgHint";
            hint.textContent = "Resposta automática ativada. O script aplica sozinho.";
            container.appendChild(hint);
            return;
        }

        if (!lastAnswer) {
            const hint = document.createElement("div");
            hint.className = "pgHint";
            hint.textContent = "Clique em LER E PERGUNTAR A IA para gerar a resposta.";
            container.appendChild(hint);
            return;
        }

        const row = document.createElement("div");
        row.className = "pgField";

        const title = document.createElement("div");
        title.className = "pgFieldTitle";
        title.textContent = "RESPOSTA PRONTA";

        const sug = document.createElement("div");
        sug.className = "pgFieldSug";
        sug.textContent = lastAnswer.slice(0, 200) + (lastAnswer.length > 200 ? "..." : "");

        const matchLine = document.createElement("div");
        matchLine.className = "pgFieldMatch";
        matchLine.textContent = "Tipo: " + (modeNames[lastType] || lastType || "?");

        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "pgApply";
        btn.textContent = "APLICAR RESPOSTA";

        btn.addEventListener("click", async () => {
            btn.disabled = true;
            const oldText = btn.textContent;
            btn.textContent = "APLICANDO...";
            try {
                await autoApplyAnswers(lastAnswer, true);
                btn.textContent = "APLICADO";
                btn.classList.add("pgDone");
                notify("Resposta aplicada.");
            } catch (e) {
                btn.textContent = oldText;
                btn.disabled = false;
                notify("Falha ao aplicar.", 2600);
            }
        });

        row.appendChild(title);
        row.appendChild(sug);
        row.appendChild(matchLine);
        row.appendChild(btn);
        container.appendChild(row);
    }

    /* ===================== APLICAR DROPDOWN ===================== */

    async function applyFieldAnswer(field, targetText) {
        if (!targetText) return { ok: false, motivo: "Sem texto para aplicar." };

        let button = null;
        if (field.pgid) {
            try { button = document.querySelector(`[data-pgid="${field.pgid}"]`); } catch {}
        }
        if (!button || !button.isConnected || !isVisible(button)) button = field.element;
        if (!button || !button.isConnected || !isVisible(button)) {
            const all = getDropdowns();
            button = all[field.campo - 1] || null;
        }
        if (!button || !button.isConnected || !isVisible(button)) {
            return { ok: false, motivo: "Campo não está mais na página." };
        }

        document.dispatchEvent(new KeyboardEvent("keydown", { key: "Escape", bubbles: true }));
        await wait(250);

        const opened = await clickEl(button);
        if (!opened) return { ok: false, motivo: "Não foi possível abrir o menu." };

        const optEls = await waitForOptions(button, 1200);
        if (optEls.length === 0) {
            document.dispatchEvent(new KeyboardEvent("keydown", { key: "Escape", bubbles: true }));
            await wait(200);
            return { ok: false, motivo: "Nenhuma opção disponível." };
        }

        const targetNorm = normalize(targetText);
        const tLetter = (extractLetter(targetText) || {}).letter || "";

        let chosen = optEls.find(o => normalize(o.text) === targetNorm);
        if (!chosen && tLetter) {
            chosen = optEls.find(o => {
                const ol = extractLetter(o.text);
                return ol && ol.letter === tLetter;
            });
        }
        if (!chosen) {
            chosen = optEls.find(o => {
                const o2 = normalize(o.text);
                return o2.length >= 3 && targetNorm.length >= 3 &&
                    (o2.includes(targetNorm) || targetNorm.includes(o2));
            });
        }
        if (!chosen) {
            document.dispatchEvent(new KeyboardEvent("keydown", { key: "Escape", bubbles: true }));
            await wait(200);
            return { ok: false, motivo: "Opção não encontrada no menu." };
        }

        const clicked = await clickEl(chosen.element);
        if (!clicked) {
            document.dispatchEvent(new KeyboardEvent("keydown", { key: "Escape", bubbles: true }));
            await wait(200);
            return { ok: false, motivo: "Falha ao clicar na opção." };
        }

        await waitForClose(button, 1500);
        await wait(150);
        return { ok: true };
    }

    /* ===================== APLICAR ALTERNATIVA ===================== */

    async function applyChoiceAnswer() {
        if (lastChoices.length === 0) return { ok: false, motivo: "Sem alternativas." };

        const parsed = parseNumberedAnswers(lastAnswer);
        const answers = parsed.length > 0 ? parsed.map(p => p.text) : [lastAnswer];

        let clickedAny = false;

        for (const ans of answers) {
            if (!ans) continue;

            const letterInfo = extractLetter(ans);
            let targetIdx = -1;

            if (letterInfo) {
                const letter = letterInfo.letter;
                for (let i = 0; i < lastChoices.length; i++) {
                    const cl = extractLetter(lastChoices[i].text);
                    if (cl && cl.letter === letter) { targetIdx = i; break; }
                }
                if (targetIdx === -1) {
                    const anyHasLetter = lastChoices.some(c => extractLetter(c.text));
                    if (!anyHasLetter) {
                        const idx = letter.charCodeAt(0) - 97;
                        if (idx >= 0 && idx < lastChoices.length) targetIdx = idx;
                    }
                }
            }

            if (targetIdx === -1) {
                const s = normalize(ans);
                for (let i = 0; i < lastChoices.length; i++) {
                    if (normalize(lastChoices[i].text) === s) { targetIdx = i; break; }
                }
                if (targetIdx === -1) {
                    for (let i = 0; i < lastChoices.length; i++) {
                        const o = normalize(lastChoices[i].text);
                        if (o.length >= 3 && s.length >= 3 && (o.includes(s) || s.includes(o))) {
                            targetIdx = i; break;
                        }
                    }
                }
            }

            if (targetIdx === -1) continue;

            const fresh = getChoices();
            const target = fresh[targetIdx] || lastChoices[targetIdx];
            if (!target || !isVisible(target.element)) continue;

            const ok = await clickEl(target.element);
            if (ok) {
                clickedAny = true;
                await wait(350);
            }
        }

        return clickedAny
            ? { ok: true }
            : { ok: false, motivo: "Nenhuma alternativa pôde ser clicada." };
    }

    /* ===================== AUTO-APLICAR ===================== */

    async function autoApplyAnswers(aiText, forceSubmit) {
        if (!autoApply && !forceSubmit) return;

        if (lastType === "vf" && lastFields.length > 0) {
            const parsed = parseNumberedAnswers(aiText);
            const byNumber = {};
            parsed.forEach(item => { byNumber[item.n] = item.text; });

            for (const field of lastFields) {
                const suggestion = byNumber[field.campo] || "";
                if (!suggestion) continue;
                const matched = matchOption(suggestion, field.opcoesDetectadas);
                if (!matched) continue;
                const r = await applyFieldAnswer(field, matched);
                if (r.ok) notify("Campo " + field.campo + " preenchido.");
                await wait(250);
            }

            await wait(400);
            const sub = await clickSubmit();
            if (!sub.ok) notify("Auto-envio: " + sub.motivo, 2600);
            return;
        }

        if (lastType === "dragdrop" && lastBlanks.length > 0) {
            const parsed = parseNumberedAnswers(aiText);
            const byNumber = {};
            parsed.forEach(item => { byNumber[item.n] = item.text; });

            const opts = lastDraggables.map(d => d.text);

            for (let i = 0; i < lastBlanks.length; i++) {
                const campo = i + 1;
                const suggestion = byNumber[campo] || "";
                if (!suggestion) continue;
                const matched = matchOption(suggestion, opts);
                if (!matched) continue;
                const r = await applyDragDropAnswer(matched, i);
                if (r.ok) notify("Blank " + campo + " preenchido.");
                await wait(300);
            }

            await wait(400);
            const sub = await clickSubmit();
            if (!sub.ok) notify("Auto-envio: " + sub.motivo, 2600);
            return;
        }

        if (lastType === "match" && lastMatch && Array.isArray(lastMatch.prompts) && Array.isArray(lastMatch.tiles)) {
            const parsed = parseNumberedAnswers(aiText);
            const byNumber = {};
            parsed.forEach(item => { byNumber[item.n] = item.text; });

            const tileTexts = lastMatch.tiles.map(t => t.text);

            for (let i = 0; i < lastMatch.prompts.length; i++) {
                const campo = i + 1;
                const suggestion = byNumber[campo] || "";
                if (!suggestion) continue;
                const matched = matchOption(suggestion, tileTexts);
                if (!matched) continue;
                const r = await applyMatchPair(lastMatch.prompts[i].text, matched, i);
                if (r.ok) notify("Par " + campo + " associado.");
                await wait(350);
            }

            await wait(400);
            const sub = await clickSubmit();
            if (!sub.ok) notify("Auto-envio: " + sub.motivo, 2600);
            return;
        }

        if ((lastType === "alternativa" || lastType === "multi") && lastChoices.length > 0) {
            const r = await applyChoiceAnswer();
            if (r.ok) notify("Alternativa clicada automaticamente.");
        }
    }

    /* ===================== BOTAO PRINCIPAL ===================== */

    $("pgGo").onclick = async () => {
        if (busy) return;

        if (!apiKey) {
            const value = prompt("Cole sua chave da OpenRouter:");
            if (!value || !value.trim()) { notify("API Key não informada."); return; }
            apiKey = value.trim();
            store.set("apikey", apiKey);
        }

        setBusy(true);
        toggle.classList.remove("pgOk", "pgErr");

        try {
            $("pgAnswer").value = "1. Lendo o conteúdo da página...\nAguarde.";
            $("pgFields").innerHTML = '<div class="pgHint">Analisando a questão...</div>';

            const pageText = readPage();
            $("pgAnswer").value = imageData
                ? "1. Página lida.\n2. Foto anexada.\n3. Identificando tipo de questão..."
                : "1. Página lida.\n2. Identificando tipo de questão...";

            const dropdowns = getDropdowns();
            const blanks = getDroppableBlanks();
            const matchData = getMatchData();

            let fields = [];
            let choices = [];
            let draggables = [];
            let match = null;
            let type = "";

            if (dropdowns.length > 0) {
                type = "vf";
                $("pgAnswer").value = "1. Página lida.\n2. V/F detectado.\n3. Lendo opções...";
                fields = await scanDropdowns();
            } else if (matchData && matchData.prompts.length > 0 && matchData.tiles.length > 0) {
                type = "match";
                match = matchData;
                $("pgAnswer").value = "1. Página lida.\n2. Associação detectada.\n3. Lendo pares...";
            } else if (blanks.length > 0) {
                type = "dragdrop";
                draggables = getDraggableItems();
                $("pgAnswer").value = "1. Página lida.\n2. Drag-and-drop detectado.\n3. Lendo itens arrastáveis...";
            } else {
                choices = getChoices();
                if (choices.length > 0) {
                    const text = (document.body.innerText || "").toLowerCase();
                    type = /selecione todas|marque todas|assinale todas|múltiplas|multiple choice/i.test(text)
                        ? "multi"
                        : "alternativa";
                } else {
                    type = "alternativa";
                }
            }

            modo = type;
            lastType = type;
            lastFields = Array.isArray(fields) ? fields : [];
            lastChoices = Array.isArray(choices) ? choices : [];
            lastBlanks = Array.isArray(blanks) ? blanks : [];
            lastDraggables = Array.isArray(draggables) ? draggables : [];
            lastMatch = match || null;
            lastAnswer = "";

            // === BLINDADO: monta associacao com checagem de arrays ===
            const safeAssoc = (match && Array.isArray(match.prompts) && Array.isArray(match.tiles)) ? {
                prompts: match.prompts.map((p, i) => ({
                    campo: i + 1,
                    texto: (p && p.text) ? p.text : ""
                })),
                regioes: match.tiles.map((t, i) => ({
                    indice: i + 1,
                    texto: (t && t.text) ? t.text : ""
                }))
            } : null;

            report = {
                modo: modeNames[modo] || modo,
                pagina: location.href,
                tipoQuestao: type || "desconhecido",
                temFoto: !!imageData,
                textoDaPagina: pageText,
                menus: (Array.isArray(fields) ? fields : []).map(f => ({
                    campo: f.campo,
                    valorAtual: f.valorAtual,
                    opcoesDetectadas: Array.isArray(f.opcoesDetectadas) ? f.opcoesDetectadas : [],
                    erro: f.erro || ""
                })),
                alternativas: (Array.isArray(choices) ? choices : []).map(c => c.text),
                blanks: (Array.isArray(blanks) ? blanks : []).map((b, i) => ({ campo: i + 1, valorAtual: "" })),
                itensArrastaveis: (Array.isArray(draggables) ? draggables : []).map(d => d.text),
                associacao: safeAssoc
            };

            $("pgAnswer").value = imageData
                ? "1. Foto pronta.\n2. Consultando a IA (modelo com visão)..."
                : `1. Tipo: ${modeNames[type] || type}.\n2. Consultando a IA...`;

            const userText = buildPrompt(report, $("pgQuestion").value.trim());
            const userContent = imageData
                ? [
                    { type: "text", text: userText },
                    { type: "image_url", image_url: { url: imageData.dataUrl } }
                  ]
                : userText;

            const modelToUse = imageData ? MODEL_VISION : MODEL;

            const response = await fetch(API_URL, {
                method: "POST",
                headers: {
                    "Authorization": "Bearer " + apiKey,
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    model: modelToUse,
                    messages: [
                        {
                            role: "system",
                            content:
                                "Você é um assistente de estudos. Analise o conteúdo recebido (texto e/ou imagem). " +
                                "Não invente perguntas nem opções. Se houver dropdowns, responda " +
                                "com lista numerada. Se houver alternativas clicáveis, responda " +
                                "com LETRA e TEXTO exato da correta. Se houver blanks de drag-and-drop, " +
                                "responda com lista numerada indicando o item exato para cada blank. " +
                                "Se houver associação (match), responda com lista numerada pareando " +
                                "cada prompt com o texto exato da região. " +
                                "Se houver foto da questão, leia com atenção antes de responder."
                        },
                        {
                            role: "user",
                            content: userContent
                        }
                    ],
                    temperature: 0.2
                })
            });

            const data = await response.json().catch(() => ({}));
            if (!response.ok) {
                if (response.status === 401 || response.status === 403) {
                    apiKey = ""; store.del("apikey");
                }
                throw new Error(data?.error?.message || "Erro HTTP " + response.status);
            }

            let answer = data?.choices?.[0]?.message?.content;
            if (Array.isArray(answer)) answer = answer.map(p => (p && p.text) ? p.text : "").join("\n");
            if (typeof answer !== "string" || !answer.trim()) {
                throw new Error("A IA não retornou uma resposta.");
            }

            lastAnswer = answer.trim();
            $("pgAnswer").value = lastAnswer;

            try { renderFields(); }
            catch (err) {
                console.error("[PortugaIA] renderFields", err);
                $("pgFields").innerHTML =
                    '<div class="pgHint">Não foi possível montar a lista.</div>';
            }

            if (autoApply) {
                try { await autoApplyAnswers(lastAnswer); }
                catch (err) { console.error("[PortugaIA] autoApply", err); }
            }

            toggle.classList.add("pgOk");
            notify("Análise concluída!", 2800);

        } catch (error) {
            $("pgAnswer").value =
                "Não foi possível concluir a análise.\n\n" + (error.message || String(error));
            $("pgFields").innerHTML = '<div class="pgHint">Falha na leitura ou na consulta.</div>';
            toggle.classList.add("pgErr");
            notify("Erro na leitura ou consulta à IA.", 2800);
            console.error("[PortugaIA]", error);
        } finally {
            setBusy(false);
            setTimeout(() => toggle.classList.remove("pgOk", "pgErr"), 2600);
        }
    };

    /* ===================== COPIAR ===================== */

