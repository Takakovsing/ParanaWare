        let extra_instructions = "";

        if (type === "vf" && fields.length > 0) {
            extra_instructions = `
ATENCAO: a pagina tem ${fields.length} dropdown(s) "Selecione a resposta".
Voce DEVE responder CADA CAMPO, na ordem.

FORMATO OBRIGATORIO (sem texto adicional):
1. <texto exato de uma das opções do CAMPO 1>
2. <texto exato de uma das opções do CAMPO 2>
...

Regras:
- Uma linha por campo, formato "<número>. <texto>".
- O texto deve ser copiado LITERALMENTE de "opcoesDetectadas".
- Se não houver dados, escreva "INDETERMINADO".
`;
        } else if ((type === "alternativa" || type === "multi") && choices.length > 0) {
            extra_instructions = `
ATENCAO: a pagina tem ${choices.length} alternativa(s) clicavel(is).
Voce DEVE responder com LETRA e TEXTO EXATO da(s) alternativa(s) correta(s).
${type === "multi" ? "Se houver mais de uma correta, responda em linhas numeradas:\n1. A) <texto>\n2. C) <texto>\n" : "Responda em UMA linha: LETRA) TEXTO. Ex.: \"B) Falso\".\n"}
- O texto deve ser copiado LITERALMENTE de "alternativas".
`;
        } else if (type === "dragdrop" && blanks.length > 0) {
            extra_instructions = `
ATENCAO: a pagina tem ${blanks.length} espaco(s) em branco para preencher
(arrastar e soltar). Existem ${draggables.length} itens disponiveis para arrastar:
${JSON.stringify(draggables)}

Voce DEVE responder CADA BLANK, na ordem em que aparecem no texto da pergunta.

FORMATO OBRIGATORIO (sem texto adicional):
1. <texto exato de um dos itens arrastáveis>
2. <texto exato de um dos itens arrastáveis>
...

Regras:
- Uma linha por blank, formato "<número>. <texto>".
- O texto deve ser copiado LITERALMENTE de "itensArrastaveis".
- Se não houver dados, escreva "INDETERMINADO".
`;
        } else if (type === "match" && matchPrompts.length > 0 && matchRegioes.length > 0) {
            const pLines = matchPrompts
                .map((p, i) => `PROMPT ${i + 1}: ${(p && p.texto) ? p.texto : ""}`)
                .join("\n");
            const tLines = matchRegioes
                .map((t, i) => `REGIAO ${i + 1}: ${(t && t.texto) ? t.texto : ""}`)
                .join("\n");

            extra_instructions = `
ATENCAO: a pagina tem uma questao de ASSOCIACAO (match).
Cada prompt abaixo precisa ser pareado com UMA regiao.

PROMPTS (lado esquerdo):
