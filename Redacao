/* IMAGEM */
#pgToggle img{
    position:relative;
    z-index:1;
    width:100%;
    height:100%;
    display:block;
    object-fit:cover;
    border-radius:50%;
    pointer-events:none;
    transition:filter .18s ease;
}

@keyframes pgRingRotate{
    from{transform:rotate(0deg)}
    to{transform:rotate(360deg)}
}

/* ANIMAÇÃO AO APERTAR */
#pgToggle.pgPressed{
    transform:scale(.88);
    filter:brightness(1.5);
    box-shadow:0 0 12px #fff,0 0 28px #ffffff70,0 8px 25px #000b;
}

#pgToggle.pgPressed img{
    filter:brightness(1.25);
}

#pgToggle.pgReleased{
    transform:scale(1.06);
}

/* BRILHO EM REPOUSO */
#pgToggle.pgAura{
    animation:pgAura 3s ease-in-out infinite;
}

@keyframes pgAura{
    0%,100%{
        box-shadow:0 0 7px #ffffff18,0 8px 25px #000b;
    }
    50%{
        box-shadow:0 0 18px #ffffff50,0 0 30px #ffffff16,0 8px 25px #000b;
    }
}

/* ESPIRAL VERDE MAIOR DURANTE A GERAÇÃO */
#pgToggle.pgWorking:before{
    inset:-8px;
    background:conic-gradient(
        from 0deg,
        #003b19 0deg,
        #006b2b 45deg,
        #00a83b 90deg,
        #39ff78 135deg,
        #008f35 180deg,
        #004d20 225deg,
        #20e85b 270deg,
        #003b19 315deg,
        #003b19 360deg
    );
    animation:pgRingRotate .8s linear infinite;
    box-shadow:
        0 0 8px #00ff5570,
        0 0 18px #00ff5545;
