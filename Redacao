/* BRILHO DO BOTÃO DURANTE A GERAÇÃO */
#pgToggle.pgWorking{
    animation:pgWorkingPulse .7s ease-in-out infinite alternate;
}

@keyframes pgWorkingPulse{
    from{
        filter:brightness(1);
        transform:scale(1);
    }
    to{
        filter:brightness(1.2);
        transform:scale(1.025);
    }
