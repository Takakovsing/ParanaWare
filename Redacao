
javascript:(async()=>{

"use strict";

const KEY_CORRETA="rzinmodder";
const ICONE="https://media.tenor.com/m11vauEEbcUAAAAM/meow-neko-arc.gif";

if(document.getElementById("pgFloat"))return;

if(prompt("Digite a Key:")!==KEY_CORRETA){
    alert("Key inválida!");
    return;
}

let minimized=false;
let hidden=false;
let apiKey="";
let nivel="medio";
let busy=false;
let notifyTimer=null;

let iconPointerId=null;
let iconStartX=0,iconStartY=0;
let iconOffsetX=0,iconOffsetY=0;
let iconMoved=false,iconDragging=false;

let panelPointerId=null;
let panelOffsetX=0,panelOffsetY=0;
let panelDragging=false;

const $=id=>document.getElementById(id);

/* FAVICON */
let favicon=document.querySelector('link[rel~="icon"]');

if(!favicon){
    favicon=document.createElement("link");
    favicon.rel="icon";
    document.head.appendChild(favicon);
}

favicon.href=ICONE;

/* ESTILOS */
const style=document.createElement("style");

style.textContent=`
