#pgFloat button:not(#pgEditApi):hover{
    background:#ffffff24;
    box-shadow:0 6px 18px #0005;
}

#pgFloat button:not(#pgEditApi):active{
    transform:scale(.97);
}

#pgGerar{
    background:linear-gradient(110deg,#fff,#c8c8d0)!important;
    color:#101014!important;
    border-color:#fff!important;
}

#pgFloat button:disabled{
    opacity:.65;
    cursor:wait;
}

/* BOTÃO FLUTUANTE */
#pgToggle{
    position:fixed;
    right:20px;
    bottom:25px;
    width:62px;
    height:62px;
    padding:4px;
    border:1px solid #000;
    border-radius:50%;
    background:#050505;
    z-index:2147483641;
    cursor:grab;
    display:flex;
    align-items:center;
    justify-content:center;
    isolation:isolate;
    overflow:visible;
    touch-action:none;
    -webkit-tap-highlight-color:transparent;
    user-select:none;
    -webkit-user-select:none;
    box-shadow:0 5px 20px #000b;
    transition:
        transform .18s cubic-bezier(.2,.8,.2,1),
        filter .18s ease,
        box-shadow .18s ease;
}

/* ESPIRAL NORMAL: BRANCO E CINZA-ESCURO */
#pgToggle:before{
    content:"";
    position:absolute;
    inset:-4px;
    border-radius:50%;
    background:conic-gradient(
        from 0deg,
        #101010 0deg,
        #44444a 45deg,
        #bdbdc8 90deg,
        #fff 135deg,
        #65656d 180deg,
        #171717 225deg,
        #aaaab4 270deg,
        #353535 315deg,
        #101010 360deg
    );
    animation:pgRingRotate 2.2s linear infinite;
    z-index:-1;
    pointer-events:none;
    transition:inset .25s ease,box-shadow .25s ease;
}

/* BORDA PRETA FINA */
#pgToggle:after{
    content:"";
    position:absolute;
    inset:0;
    border:1px solid #000;
    border-radius:50%;
    pointer-events:none;
    z-index:3;
