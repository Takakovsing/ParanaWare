`;

document.head.appendChild(style);

/* PAINEL */
const gui=document.createElement("div");
gui.id="pgFloat";

gui.innerHTML=`
    <div id="pgHead">
        <span>PORTUGA IA</span>
        <button id="pgEditApi" type="button" title="Alterar API Key">✎</button>
    </div>
    <div id="pgLine"></div>
    <button id="pgNivel" type="button">NÍVEL: MÉDIO</button>
    <button id="pgGerar" type="button">GERAR REDAÇÃO</button>
`;

document.body.appendChild(gui);

/* ÍCONE FLUTUANTE */
const toggle=document.createElement("button");
toggle.id="pgToggle";
toggle.type="button";
toggle.setAttribute("aria-label","Abrir ou minimizar PORTUGA IA");
toggle.innerHTML=`<img src="${ICONE}" alt="">`;
toggle.classList.add("pgAura");
document.body.appendChild(toggle);

/* NOTIFICAÇÕES */
const notifyBox=document.createElement("div");
notifyBox.id="pgNotify";
document.body.appendChild(notifyBox);

function notify(message="Feito!",persist=false){
    notifyBox.textContent=message;
    notifyBox.style.opacity="1";
    notifyBox.style.transform="translateX(-50%) translateY(0)";
    clearTimeout(notifyTimer);

    if(!persist){
        notifyTimer=setTimeout(()=>{
            notifyBox.style.opacity="0";
            notifyBox.style.transform="translateX(-50%) translateY(-20px)";
        },2200);
    }
}

function setBusy(value){
    busy=value;
    toggle.classList.toggle("pgWorking",value);
    toggle.classList.toggle("pgAura",!value);
    $("pgGerar").disabled=value;
}

function setMinimized(value){
    minimized=value;
    gui.classList.toggle("pgMini",minimized);
}

/* NÍVEIS */
const niveis=["baixo","medio","alto"];

const nomesNivel={
    baixo:"BAIXO",
    medio:"MÉDIO",
    alto:"ALTO"
};

const descNivel={
    baixo:"Use linguagem simples, frases curtas, vocabulário básico e estrutura direta.",
    medio:"Use vocabulário intermediário, boa coesão e argumentação equilibrada.",
    alto:"Use argumentação aprofundada, repertório sociocultural, conectivos variados e excelente coesão."
};

$("pgNivel").onclick=()=>{
    const i=niveis.indexOf(nivel);
    nivel=niveis[(i+1)%niveis.length];
    $("pgNivel").textContent="NÍVEL: "+nomesNivel[nivel];
    notify("Nível: "+nomesNivel[nivel]);
};

/* ALTERAR API KEY */
$("pgEditApi").addEventListener("pointerdown",event=>{
    event.stopPropagation();
});

$("pgEditApi").onclick=event=>{
    event.stopPropagation();
    const value=prompt("Cole sua chave da OpenRouter:");

    if(value&&value.trim()){
        apiKey=value.trim();
        notify("API Key atualizada nesta sessão.");
    }
};

/* LER PÁGINA */
function lerPagina(){
    const clone=document.body.cloneNode(true);

    [
        "#pgFloat","#pgToggle","#pgNotify",
        "script","style","noscript"
    ].forEach(selector=>{
        clone.querySelectorAll(selector).forEach(el=>el.remove());
    });

    return (clone.innerText||"")
        .replace(/\n{3,}/g,"\n\n")
        .trim()
        .slice(0,30000);
}

/* ENCONTRAR CAMPO DE TEXTO */
function acharCampo(){
    const preferidos=[
        'textarea[name*="redac" i]',
        'textarea[id*="redac" i]',
        'textarea[class*="redac" i]',
        'textarea[placeholder*="redac" i]',
        'textarea[placeholder*="digite" i]',
        'textarea[placeholder*="escreva" i]',
        'textarea[placeholder*="texto" i]',
        'textarea[aria-label*="redac" i]',
        'textarea[aria-label*="resposta" i]'
    ];

    for(const selector of preferidos){
        try{
            const el=document.querySelector(selector);
            if(el&&el.getClientRects().length&&!el.disabled&&!el.readOnly)return el;
        }catch(e){}
    }

    const areas=[...document.querySelectorAll("textarea,input")]
        .filter(el=>
            el.getClientRects().length&&
            !el.disabled&&
            !el.readOnly&&
            !["password","hidden","button","submit","checkbox","radio"].includes(el.type)
        );

    if(areas.length){
        return areas.sort((a,b)=>
            b.clientWidth*b.clientHeight-a.clientWidth*a.clientHeight
        )[0];
    }

    return [...document.querySelectorAll('[contenteditable="true"]')]
        .find(el=>el.getClientRects().length)||null;
}

/* DESTAQUE DO CAMPO */
function destacarCampo(campo){
    const antigo=campo.style.outline;
    campo.style.outline="3px solid lime";
    setTimeout(()=>campo.style.outline=antigo,1500);
}

/* INSERIR TEXTO */
function aplicarTexto(campo,texto){
    if(campo.matches("textarea,input")){
        const proto=campo.tagName==="TEXTAREA"
            ?HTMLTextAreaElement.prototype
            :HTMLInputElement.prototype;

        const setter=Object.getOwnPropertyDescriptor(proto,"value")?.set;

        if(setter)setter.call(campo,texto);
        else campo.value=texto;

        campo.dispatchEvent(new Event("input",{bubbles:true}));
        campo.dispatchEvent(new Event("change",{bubbles:true}));
        return;
    }

    campo.focus();

    let inseriu=false;

    try{
        const selection=window.getSelection();
        const range=document.createRange();
        range.selectNodeContents(campo);
        selection.removeAllRanges();
        selection.addRange(range);
        inseriu=document.execCommand("insertText",false,texto);
    }catch(e){}

    if(!inseriu)campo.textContent=texto;

    campo.dispatchEvent(new Event("input",{bubbles:true}));
    campo.dispatchEvent(new Event("change",{bubbles:true}));
}

/* GERAR REDAÇÃO */
$("pgGerar").onclick=async()=>{
    if(busy)return;

    if(!apiKey){
        const value=prompt("Cole sua chave da OpenRouter:");
        if(!value||!value.trim())return;
        apiKey=value.trim();
    }

    const campo=acharCampo();

    if(!campo){
        alert("Não encontrei um campo de texto editável nesta página.");
        return;
    }

    destacarCampo(campo);
    setBusy(true);
    $("pgGerar").textContent="LENDO PÁGINA...";
    notify("Lendo conteúdo da página...",true);

    try{
        const pageText=lerPagina();

        if(!pageText){
            throw new Error("Não consegui ler o conteúdo da página.");
        }

        $("pgGerar").textContent="GERANDO REDAÇÃO...";
        notify("Gerando redação...",true);

        const response=await fetch(
            "https://openrouter.ai/api/v1/chat/completions",
            {
                method:"POST",
                headers:{
                    "Authorization":"Bearer "+apiKey,
                    "Content-Type":"application/json"
                },
                body:JSON.stringify({
                    model:"openrouter/free",
                    messages:[
                        {
                            role:"system",
                            content:
                                "Escreva diretamente a redação solicitada com base no tema e nas informações da página. "+
                                "Retorne SOMENTE o conteúdo da redação, sem título, sem cabeçalho, sem nome de seção, "+
                                "sem perguntas ao usuário, sem pedidos de tema, sem explicações e sem comentários. "+
                                "Não escreva frases como 'Aqui está a redação'. "+
                                "Comece diretamente pelo primeiro parágrafo e separe os parágrafos com uma linha em branco. "+
                                "Use português correto e respeite o nível de escrita: "+descNivel[nivel]
                        },
                        {
                            role:"user",
                            content:
                                "Identifique o tema da atividade a partir do conteúdo abaixo e escreva a redação diretamente. "+
                                "Não me pergunte nada. Se o tema estiver implícito, deduza-o pelo contexto.\n\n"+
                                "CONTEÚDO DA PÁGINA:\n"+pageText
                        }
                    ]
                })
            }
        );

        const data=await response.json();

        if(!response.ok){
            if(response.status===401||response.status===403)apiKey="";
            throw new Error(data?.error?.message||"Erro HTTP "+response.status);
        }

        let texto=data?.choices?.[0]?.message?.content;

        if(Array.isArray(texto)){
            texto=texto.map(item=>item.text||"").join("\n");
        }

        if(typeof texto!=="string"||!texto.trim()){
            throw new Error("A IA não retornou uma redação.");
        }

        texto=texto
            .replace(/^```[\w-]*\s*/,"")
            .replace(/\s*```$/,"")
            .replace(/^\s*(título|titulo)\s*:\s*.*(?:\r?\n)+/i,"")
            .replace(/^\s*redação\s*:\s*/i,"")
            .trim();

        $("pgGerar").textContent="INSERINDO...";
        notify("Inserindo redação...",true);

        aplicarTexto(campo,texto);
        notify("Redação pronta!");

    }catch(error){
        notify("Não foi possível gerar a redação.");
        alert("Erro ao gerar redação:\n\n"+(error.message||error));
    }finally{
        setBusy(false);
        $("pgGerar").textContent="GERAR REDAÇÃO";
    }
};

/* ANIMAÇÃO AO APERTAR E ARRASTAR */
toggle.addEventListener("pointerdown",event=>{
    if(event.button!==undefined&&event.button!==0)return;

    iconPointerId=event.pointerId;
    iconStartX=event.clientX;
    iconStartY=event.clientY;

    const rect=toggle.getBoundingClientRect();

    iconOffsetX=event.clientX-rect.left;
    iconOffsetY=event.clientY-rect.top;

    iconMoved=false;
    iconDragging=true;

    toggle.classList.add("pgPressed");
    toggle.classList.remove("pgReleased");

    try{
        toggle.setPointerCapture(event.pointerId);
    }catch(e){}

    event.preventDefault();
});

toggle.addEventListener("pointermove",event=>{
    if(!iconDragging||event.pointerId!==iconPointerId)return;

    const dx=event.clientX-iconStartX;
    const dy=event.clientY-iconStartY;

    if(Math.abs(dx)>7||Math.abs(dy)>7)iconMoved=true;
    if(!iconMoved)return;

    const width=toggle.offsetWidth;
    const height=toggle.offsetHeight;

    const x=Math.max(0,Math.min(
        window.innerWidth-width,
        event.clientX-iconOffsetX
    ));

    const y=Math.max(0,Math.min(
        window.innerHeight-height,
        event.clientY-iconOffsetY
    ));

    toggle.style.left=x+"px";
    toggle.style.top=y+"px";
    toggle.style.right="auto";
    toggle.style.bottom="auto";
});

function finishIconPointer(event){
    if(!iconDragging||event.pointerId!==iconPointerId)return;

    const dragged=iconMoved;

    iconDragging=false;
    iconPointerId=null;

    toggle.classList.remove("pgPressed");
    toggle.classList.add("pgReleased");

    requestAnimationFrame(()=>{
        requestAnimationFrame(()=>{
            toggle.classList.remove("pgReleased");
        });
    });

    if(!dragged)setMinimized(!minimized);
    iconMoved=false;
}

toggle.addEventListener("pointerup",finishIconPointer);

toggle.addEventListener("pointercancel",event=>{
    if(event.pointerId===iconPointerId){
        iconDragging=false;
        iconPointerId=null;
        iconMoved=false;
    }

    toggle.classList.remove("pgPressed","pgReleased");
});

toggle.addEventListener("click",event=>{
    event.preventDefault();
    event.stopPropagation();
});

/* ARRASTAR PAINEL */
const head=$("pgHead");

head.addEventListener("pointerdown",event=>{
    if(event.target.closest("button"))return;

    panelPointerId=event.pointerId;
    panelDragging=true;

    const rect=gui.getBoundingClientRect();

    panelOffsetX=event.clientX-rect.left;
    panelOffsetY=event.clientY-rect.top;

    try{
        head.setPointerCapture(event.pointerId);
    }catch(e){}

    event.preventDefault();
});

head.addEventListener("pointermove",event=>{
    if(!panelDragging||event.pointerId!==panelPointerId)return;

    const width=gui.offsetWidth;
    const height=gui.offsetHeight;

    const x=Math.max(0,Math.min(
        window.innerWidth-width,
        event.clientX-panelOffsetX
    ));

    const y=Math.max(0,Math.min(
        window.innerHeight-height,
        event.clientY-panelOffsetY
    ));

    gui.style.left=x+"px";
    gui.style.top=y+"px";
    gui.style.transform="none";
});

function finishPanelDrag(event){
    if(event.pointerId!==panelPointerId)return;

    panelDragging=false;
    panelPointerId=null;
}

head.addEventListener("pointerup",finishPanelDrag);
head.addEventListener("pointercancel",finishPanelDrag);

/* ATALHOS */
function toggleHiddenMode(){
    hidden=!hidden;
    gui.style.display=hidden?"none":"";
    toggle.style.display=hidden?"none":"";
    notifyBox.style.display=hidden?"none":"";
}

document.addEventListener("keydown",event=>{
    if(event.key==="Escape")setMinimized(!minimized);
    if(event.key==="Alt")toggleHiddenMode();
});

document.addEventListener("mousedown",event=>{
    if(event.button===1){
        event.preventDefault();
        toggleHiddenMode();
    }
});

/* AJUSTAR À TELA */
window.addEventListener("resize",()=>{
    const rect=gui.getBoundingClientRect();

    if(rect.right>window.innerWidth){
        gui.style.left=Math.max(0,window.innerWidth-gui.offsetWidth)+"px";
        gui.style.transform="none";
    }

    if(rect.bottom>window.innerHeight){
        gui.style.top=Math.max(0,window.innerHeight-gui.offsetHeight)+"px";
    }
});

notify("PORTUGA IA carregada!");

})();
