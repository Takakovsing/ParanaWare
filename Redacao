/* RESTAURAR TAMANHO NORMAL */
#pgToggle:not(.pgWorking):before{
    inset:-4px;
    box-shadow:none;
}

/* NOTIFICAÇÕES */
#pgNotify{
    position:fixed;
    top:25px;
    left:50%;
    transform:translateX(-50%) translateY(-20px);
    background:rgba(18,18,21,.97);
    color:#fff;
    padding:11px 20px;
    border:1px solid #ffffff30;
    border-radius:11px;
    font-family:"Trebuchet MS",Arial,sans-serif;
    font-weight:bold;
    font-size:14px;
    z-index:2147483642;
    opacity:0;
    transition:opacity .3s,transform .35s;
    box-shadow:0 8px 25px #0008;
    pointer-events:none;
    max-width:85vw;
    text-align:center;
    overflow-wrap:anywhere;
}

@media(max-width:360px){
    #pgFloat{padding:13px}
    #pgHead{font-size:16px}
    #pgFloat button:not(#pgEditApi){padding:10px}
