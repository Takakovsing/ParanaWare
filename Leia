
(async function PORTUGA_IA() {
    if (window.__PORTUGA_IA) {
        window.__PORTUGA_IA.destroy();
        return;
    }

    const ID = "__portuga_ia_panel";
    const state = {
        pages: [],
        hash: "",
        key: sessionStorage.getItem("__portuga_or_key") || "",
        timer: null,
        busy: false,
        minimized: false
    };

    const old = document.getElementById(ID);
    if (old) old.remove();

    const panel = document.createElement("div");
    panel.id = ID;
    panel.style.cssText = `
        position:fixed;right:12px;bottom:12px;
        width:min(360px,calc(100vw - 24px));
        max-height:82vh;overflow:auto;z-index:2147483647;
        background:rgba(12,13,17,.97);color:#f5f5f7;
        border:1px solid #373943;border-radius:17px;
        box-shadow:0 12px 55px #000b;
        font:13px/1.5 system-ui,sans-serif;
        backdrop-filter:blur(18px);
    `;

    panel.innerHTML = `
        <div id="head" style="
            padding:14px;display:flex;align-items:center;
            gap:9px;cursor:move;background:linear-gradient(110deg,#242630,#101116);
            border-bottom:1px solid #343640;touch-action:none">
            <span style="font-size:22px">🕸️</span>
            <div style="flex:1">
                <b style="font-size:15px;letter-spacing:1px">
                    PORTUGA <span style="color:#aaa">IA</span>
                </b>
                <div style="font-size:10px;color:#aaa">
                    REDAÇÃO PARANÁ • READER
                </div>
            </div>
            <button id="min">—</button>
            <button id="close">×</button>
        </div>

        <div id="body" style="padding:14px">
            <div id="status" style="color:#ccc;margin-bottom:12px">
                Leitor inicializando...
            </div>

            <div style="display:flex;gap:8px;margin-bottom:12px">
                <div style="flex:1;background:#202128;padding:10px;border-radius:10px">
                    <small style="color:#aaa">PÁGINAS</small>
                    <div id="pages" style="font-size:22px;font-weight:bold">0</div>
                </div>
                <div style="flex:1;background:#202128;padding:10px;border-radius:10px">
                    <small style="color:#aaa">MEMÓRIA</small>
                    <div id="chars" style="font-size:22px;font-weight:bold">0</div>
                </div>
            </div>

            <textarea id="question" placeholder="Escreva sua pergunta para a IA..."
                style="box-sizing:border-box;width:100%;height:80px;
                resize:vertical;background:#191a20;color:white;
                border:1px solid #41434e;border-radius:10px;
                padding:10px;font:13px system-ui"></textarea>

            <button id="ask" class="main">
                ✦ ANALISAR COM IA
            </button>

            <div class="buttons">
                <button id="read">↻ LER AGORA</button>
                <button id="key">⚙ API KEY</button>
                <button id="clear">⌫ LIMPAR MEMÓRIA</button>
                <button id="copy">▣ COPIAR TEXTO</button>
            </div>

            <div id="result" style="
                display:none;white-space:pre-wrap;overflow-wrap:anywhere;
                margin-top:12px;padding:11px;border:1px solid #333540;
                background:#17181e;border-radius:10px;max-height:230px;overflow:auto">
            </div>

            <div style="margin-top:10px;font-size:10px;color:#888">
                Leitura automática • Análise manual
            </div>
        </div>
    `;

    const style = document.createElement("style");
    style.textContent = `
        #${ID} button {
            cursor:pointer;background:#292a32;color:white;
            border:1px solid #41434c;border-radius:8px;
            padding:9px;font-size:11px;
        }
        #${ID} .main {
            width:100%;margin-top:9px;background:#eee;color:#111;
            padding:11px;font-weight:bold;border:0;
        }
        #${ID} .buttons {
            display:grid;grid-template-columns:1fr 1fr;
            gap:7px;margin-top:8px;
        }
        #${ID} button:disabled {opacity:.5}
    `;

    document.documentElement.append(style, panel);

    const $ = id => panel.querySelector("#" + id);

    function setStatus(text) {
        $("status").textContent = text;
    }

    function showResult(text) {
        $("result").style.display = "block";
        $("result").textContent = text;
    }

    function readPage() {
        try {
            const clone = document.body.cloneNode(true);

            clone.querySelectorAll(
                "#" + ID + ",script,style,noscript,svg,nav,footer,header,input,textarea,select"
            ).forEach(el => el.remove());

            const text = (clone.innerText || clone.textContent || "")
                .split("\n")
                .map(line => line.trim())
                .filter(line => line.length > 2 && line.length < 1200)
                .join("\n")
                .slice(0, 18000);

            if (!text) return;

            const hash =
                text.length + "|" +
                text.slice(0, 180) + "|" +
                text.slice(-180);

            if (hash !== state.hash) {
                state.hash = hash;
                state.pages.push(text);

                if (state.pages.length > 30) {
                    state.pages.shift();
                }
            }

            $("pages").textContent = state.pages.length;

            const total = state.pages.reduce(
                (sum, page) => sum + page.length, 0
            );

            $("chars").textContent =
                total > 9999
                    ? (total / 1000).toFixed(1) + "k"
                    : total;

            setStatus("Leitor ativo • " + new Date().toLocaleTimeString());
        } catch (error) {
            setStatus("Erro ao ler a página.");
        }
    }

    function getContext() {
        return state.pages
            .slice(-12)
            .join("\n\n--- Página capturada ---\n\n")
            .slice(-14000);
    }

    function configureKey() {
        const key = prompt(
            "Cole sua chave da OpenRouter:",
            state.key
        );

        if (key && key.trim()) {
            state.key = key.trim();
            sessionStorage.setItem("__portuga_or_key", state.key);
            setStatus("API configurada nesta sessão.");
        }
    }

    async function askAI() {
        if (state.busy) return;

        if (!state.key) {
            configureKey();
            if (!state.key) return;
        }

        const question = $("question").value.trim();

        if (!question) {
            setStatus("Escreva uma pergunta primeiro.");
            $("question").focus();
            return;
        }

        readPage();

        state.busy = true;
        $("ask").disabled = true;
        $("ask").textContent = "ANALISANDO...";
        setStatus("Consultando a OpenRouter...");

        try {
            const response = await fetch(
                "https://openrouter.ai/api/v1/chat/completions",
                {
                    method: "POST",
                    headers: {
                        "Authorization": "Bearer " + state.key,
                        "Content-Type": "application/json",
                        "HTTP-Referer": location.origin,
                        "X-Title": "PORTUGA IA Reader"
                    },
                    body: JSON.stringify({
                        model: "openrouter/free",
                        messages: [
                            {
                                role: "system",
                                content:
                                    "Você é um assistente educacional brasileiro. " +
                                    "Ajude o estudante a compreender textos e perguntas. " +
                                    "Responda em português claro e direto. " +
                                    "Use o contexto disponível e não invente informações. " +
                                    "Se faltarem dados, informe isso."
                            },
                            {
                                role: "user",
                                content:
                                    "CONTEXTO DA LEITURA:\n" +
                                    (getContext() || "Nenhum texto capturado.") +
                                    "\n\nPERGUNTA:\n" + question
                            }
                        ],
                        temperature: 0.2,
                        max_tokens: 1200
                    })
                }
            );

            const data = await response.json();

            if (!response.ok) {
                throw new Error(
                    data?.error?.message || "HTTP " + response.status
                );
            }

            const answer = data?.choices?.[0]?.message?.content;

            if (!answer) {
                throw new Error("A IA retornou uma resposta vazia.");
            }

            showResult(
                Array.isArray(answer)
                    ? answer.map(item => item.text || "").join("\n")
                    : answer
            );

            setStatus("Análise concluída.");
        } catch (error) {
            showResult(
                "Falha na consulta:\n" +
                String(error.message || error) +
                "\n\nVerifique a conexão, a chave e a disponibilidade do modelo."
            );

            setStatus("Erro na consulta à IA.");
        } finally {
            state.busy = false;
            $("ask").disabled = false;
            $("ask").textContent = "✦ ANALISAR COM IA";
        }
    }

    $("read").onclick = readPage;
    $("ask").onclick = askAI;
    $("key").onclick = configureKey;

    $("clear").onclick = () => {
        if (!confirm("Apagar todas as páginas guardadas?")) return;

        state.pages = [];
        state.hash = "";

        $("pages").textContent = "0";
        $("chars").textContent = "0";

        setStatus("Memória apagada.");
    };

    $("copy").onclick = async () => {
        try {
            await navigator.clipboard.writeText(getContext());
            setStatus("Texto copiado.");
        } catch (error) {
            showResult(getContext() || "Nenhum texto capturado.");
            setStatus("Selecione e copie o texto exibido.");
        }
    };

    $("min").onclick = () => {
        state.minimized = !state.minimized;
        $("body").style.display = state.minimized ? "none" : "block";
        $("min").textContent = state.minimized ? "+" : "—";
    };

    function destroy() {
        clearInterval(state.timer);
        panel.remove();
        style.remove();
        sessionStorage.removeItem("__portuga_or_key");
        delete window.__PORTUGA_IA;
    }

    $("close").onclick = destroy;

    // Arrastar o painel com mouse ou toque.
    let drag = null;
    const head = $("head");

    head.addEventListener("pointerdown", event => {
        if (event.target.closest("button")) return;

        const rect = panel.getBoundingClientRect();

        drag = {
            x: event.clientX - rect.left,
            y: event.clientY - rect.top
        };

        panel.style.right = "auto";
        panel.style.bottom = "auto";

        head.setPointerCapture(event.pointerId);
    });

    head.addEventListener("pointermove", event => {
        if (!drag) return;

        panel.style.left = Math.max(
            0,
            Math.min(innerWidth - panel.offsetWidth, event.clientX - drag.x)
        ) + "px";

        panel.style.top = Math.max(
            0,
            Math.min(innerHeight - 45, event.clientY - drag.y)
        ) + "px";
    });

    head.addEventListener("pointerup", () => drag = null);
    head.addEventListener("pointercancel", () => drag = null);

    state.timer = setInterval(readPage, 3000);

    window.__PORTUGA_IA = { destroy };

    readPage();
})();
