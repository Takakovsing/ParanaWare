(() => {
  if (window.__arInit) { console.log('[AR] Já rodando.'); return; }
  window.__arInit = true;

  // ============ CONFIG ============
  const MODELO = 'openrouter/auto';
  const INTERVALO_MS = 5000;
  const MAX_PAGINAS = 4;
  const MAX_CHARS_PAGINA = 1500;
  let API_KEY = localStorage.getItem('__arKey') || '';
  // ================================

  const respondidas = new Set();
  const bufferPaginas = [];
  let ultimaPaginaLida = '';
  let ocupado = false;
  let ligado = false;
  let timer = null;

  // ---------- helpers ----------
  const naTela = (el) => {
    if (!el) return false;
    const r = el.getBoundingClientRect();
    if (!r.width || !r.height) return false;
    if (r.right <= 0 || r.bottom <= 0 || r.left >= innerWidth || r.top >= innerHeight) return false;
    const s = getComputedStyle(el);
    if (s.display === 'none' || s.visibility === 'hidden' || parseFloat(s.opacity) < 0.1) return false;
    return true;
  };
  const visivel = (el) => {
    if (!el) return false;
    const r = el.getBoundingClientRect();
    if (!r.width || !r.height) return false;
    const s = getComputedStyle(el);
    return s.display !== 'none' && s.visibility !== 'hidden';
  };
  const limpar = (s) => s.toLowerCase().replace(/[“”"'`´]/g, '').replace(/\s+/g, ' ').trim();
  const esperar = (ms) => new Promise(r => setTimeout(r, ms));

  const acharBotao = (texto, dentro) => Array.from((dentro || document).querySelectorAll('button'))
    .find(b => new RegExp('^\\s*' + texto + '\\s*$', 'i').test(b.innerText || '') && naTela(b) && !b.disabled);

  // ---------- leitura de página ----------
  function lerPagina() {
    const clone = document.body.cloneNode(true);
    clone.querySelectorAll(
      'button, input, select, md-icon, svg, md-dialog, md-backdrop, .md-dialog-container, ' +
      '[class*="controls"], [class*="toolbar"], [class*="tooltip"], [class*="overlay"], ' +
      '[class*="switch-overlay"], .step-wizard, .finish-btn, .md-icon-button, ' +
      '[class*="header"], [class*="footer"], [class*="sidebar"], [class*="tts"], [class*="toast"]'
    ).forEach(e => e.remove());

    return (clone.innerText || '')
      .split('\n').map(s => s.trim()).filter(Boolean)
      .filter(l => !/^\d+%$/.test(l))
      .filter(l => !/^\d+x$/.test(l))
      .filter(l => !/páginas? para terminar/i.test(l))
      .filter(l => !/^As aventuras de Mike/i.test(l))
      .filter(l => l.length > 2)
      .join('\n').trim();
  }

  function atualizarBuffer() {
    if (detectarPergunta() || detectarTelaEnviar()) return;
    const txt = lerPagina();
    if (!txt || txt.length < 40) return;
    if (txt === ultimaPaginaLida) return;
    ultimaPaginaLida = txt;
    bufferPaginas.push(txt.slice(0, MAX_CHARS_PAGINA));
    if (bufferPaginas.length > MAX_PAGINAS) bufferPaginas.shift();
    status('📖 ' + bufferPaginas.length + ' pág.');
  }

  // ---------- OpenRouter ----------
  async function perguntarIA(pergunta, opcoes, contexto) {
    if (!API_KEY) throw new Error('sem chave');
    const ctx = contexto && contexto.length
      ? 'Contexto do livro (últimas páginas lidas):\n"""\n' + contexto.join('\n---\n') + '\n"""\n\n'
      : '';
    const prompt = ctx + 'Pergunta: ' + pergunta + '\n\nOpções:\n' +
      opcoes.map((o, i) => (i + 1) + '. ' + o).join('\n');

    const res = await fetch('https://openrouter.ai/api/v1/chat/completions', {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + API_KEY, 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: MODELO,
        messages: [
          { role: 'system', content: 'Você responde questões de múltipla escolha sobre um livro. Use o contexto. Retorne apenas o texto exato de uma das alternativas.' },
          { role: 'user', content: prompt }
        ]
      })
    });
    if (!res.ok) throw new Error(res.status + ' ' + res.statusText);
    return ((await res.json()).choices?.[0]?.message?.content || '').trim();
  }

  // ---------- achar container da questão ativa ----------
  function acharContainerQuestao(radio) {
    let el = radio, achado = null;
    while (el && el !== document.body) {
      const txt = el.innerText || '';
      const marcadores = (txt.match(/^\s*\d+\.\s*-\s/gm) || []).length;
      if (marcadores === 1) { achado = el; break; }
      if (marcadores > 1) break; // container-pai pegou outras questões: para
      el = el.parentElement;
    }
    return achado || radio.closest('md-dialog') || document.body;
  }

  // ---------- detectar pergunta (só a ativa) ----------
  function detectarPergunta() {
    const radios = Array.from(document.querySelectorAll('md-radio-button.choice-radio-button'))
      .filter(naTela);
    if (!radios.length) return null;

    const container = acharContainerQuestao(radios[0]);
    const linhas = (container.innerText || '').split('\n').map(s => s.trim()).filter(Boolean);

    let qIdx = linhas.findIndex(l => /^\d+\.\s*-/.test(l));
    if (qIdx < 0) {
      let m = -1, t = 0;
      linhas.forEach((l, i) => { if (l.endsWith('?') && l.length > t) { m = i; t = l.length; } });
      qIdx = m;
    }
    if (qIdx < 0) return null;

    const pergunta = linhas[qIdx].replace(/^\d+\.\s*-\s*/, '');
    const opcoes = [];
    for (let i = qIdx + 1; i < linhas.length; i++) {
      const l = linhas[i];
      if (/^(Tentativas|TERMINAR|Terminar|Enviar|Tente|Sua pontuação)/i.test(l)) break;
      opcoes.push(l.replace(/^[“”"']+|[“”"']+$/g, '').trim());
    }

    const radiosContainer = Array.from(container.querySelectorAll('md-radio-button.choice-radio-button'))
      .filter(naTela);

    const botaoTerminar = acharBotao('terminar', container);
    const botaoProximo = acharBotao('próximo', container) || acharBotao('proximo', container);

    return { pergunta, opcoes, radios: radiosContainer, botaoTerminar, botaoProximo, container };
  }

  // ---------- tela de pontuação ----------
  function detectarTelaEnviar() {
    const enviar = acharBotao('enviar');
    const temPontuacao = /Sua pontuação atual/i.test(document.body.innerText || '');
    return (enviar && temPontuacao) ? enviar : null;
  }

  // ---------- responder ----------
  async function responder() {
    const q = detectarPergunta();
    if (!q) return false;

    const chave = q.pergunta.slice(0, 120);

    // Já respondida mas ainda na tela → avança ou fecha
    if (respondidas.has(chave)) {
      if (q.botaoProximo) {
        q.botaoProximo.click();
        status('➡️ Próxima Q');
        await esperar(600);
        return true;
      }
      const fechar = Array.from(document.querySelectorAll('button[aria-label=" Fechar"], button[aria-label="Fechar"]'))
        .find(naTela);
      if (fechar) {
        fechar.click();
        status('✕ Fechando');
        await esperar(500);
        return true;
      }
      return false;
    }

    status('🤔 Pensando...');

    try {
      const resp = await perguntarIA(q.pergunta, q.opcoes, bufferPaginas);
      const alvo = limpar(resp);
      let idx = q.opcoes.findIndex(o => limpar(o) === alvo);
      if (idx < 0) idx = q.opcoes.findIndex(o => limpar(o).includes(alvo) || alvo.includes(limpar(o)));
      if (idx < 0 && /^\d+$/.test(resp.trim())) idx = parseInt(resp.trim(), 10) - 1;

      if (idx < 0 || idx >= q.radios.length) {
        status('⚠️ Sem match');
        respondidas.add(chave);
        return true;
      }

      q.radios[idx].click();
      await esperar(700);

      // Se o bloco tem próxima questão, avança em vez de terminar
      if (q.botaoProximo) {
        q.botaoProximo.click();
        status('✅ ' + (idx + 1) + ' → próxima Q');
        respondidas.add(chave);
        await esperar(700);
        return true;
      }

      // Senão, termina o bloco
      const terminar = q.botaoTerminar
        || Array.from(document.querySelectorAll('button'))
             .find(b => /^\s*terminar\s*$/i.test(b.innerText || '') && naTela(b));
      if (!terminar || terminar.disabled) {
        status('⚠️ Terminar indisponível');
        respondidas.add(chave);
        return true;
      }
      terminar.click();
      status('📤 Terminar...');

      let enviar = null;
      for (let i = 0; i < 15; i++) {
        await esperar(300);
        enviar = detectarTelaEnviar();
        if (enviar) break;
      }
      if (enviar) { enviar.click(); status('✅ Enviado'); }
      else status('⚠️ Enviar não apareceu');

      respondidas.add(chave);

      // espera o modal fechar
      for (let i = 0; i < 20; i++) {
        await esperar(300);
        const aberto = document.querySelectorAll('md-radio-button.choice-radio-button').length > 0
          || detectarTelaEnviar();
        if (!aberto) break;
      }
      status('➡️ Próxima...');
    } catch (e) {
      console.warn('[AR]', e);
      status('❌ ' + e.message);
      respondidas.add(chave);
    }
    return true;
  }

  // ---------- ações ----------
  function abrir() {
    const b = Array.from(document.querySelectorAll('button[aria-label="Pergunta"]')).find(naTela);
    if (b) { b.click(); return true; }
    return false;
  }
  function proxima() {
    const b = document.querySelector('#right-page-btn')
      || document.querySelector('.page-switch-overlay-icon.embedded.next');
    if (b && !b.disabled) { b.click(); return true; }
    return false;
  }

  // ---------- loop ----------
  async function loop() {
    if (ocupado || !ligado) return;
    ocupado = true;
    try {
      const enviar = detectarTelaEnviar();
      if (enviar) { enviar.click(); status('📤 Enviar'); await esperar(1200); return; }

      if (await responder()) return;

      atualizarBuffer();

      if (abrir()) return;
      if (proxima()) status('➡️ Página');
      else status('⏳ Aguardando');
    } catch (e) { console.warn('[AR]', e); }
    finally { ocupado = false; }
  }

  // ---------- UI ----------
  function status(txt) {
    const el = document.getElementById('__arStatus');
    if (el) el.textContent = txt;
  }

  function ui() {
    if (document.getElementById('__arBox')) return;
    const box = document.createElement('div');
    box.id = '__arBox';
    box.style.cssText = [
      'position:fixed','top:10px','right:10px','z-index:999999',
      'background:#111','color:#eee','font:12px/1.4 system-ui,sans-serif',
      'padding:8px 10px','border-radius:10px','box-shadow:0 4px 14px rgba(0,0,0,.4)',
      'display:flex','flex-direction:column','gap:6px',
      'cursor:move','user-select:none','min-width:230px'
    ].join(';');
    box.innerHTML = `
      <div style="display:flex;gap:6px;align-items:center">
        <input id="__arKey" type="password" placeholder="sk-or-v1-..."
          style="flex:1;all:unset;background:#222;color:#eee;padding:4px 6px;border-radius:6px;font:11px monospace;min-width:0" />
        <button id="__arSave" title="Salvar chave"
          style="all:unset;cursor:pointer;padding:4px 8px;background:#333;border-radius:6px;font-size:11px">💾</button>
      </div>
      <div style="display:flex;gap:6px;align-items:center">
        <button id="__arBtn"
          style="all:unset;padding:4px 10px;border-radius:6px;background:#0a0;color:#fff;font-weight:600;cursor:pointer">Iniciar</button>
        <span id="__arStatus" style="opacity:.8;flex:1">Pronto</span>
        <button id="__arX" style="all:unset;cursor:pointer;opacity:.5;padding:0 4px">✕</button>
      </div>
      <div id="__arBuf" style="opacity:.6;font-size:10px">📖 0 páginas no contexto</div>
    `;
    document.body.appendChild(box);

    const keyInput = document.getElementById('__arKey');
    keyInput.value = API_KEY;
    keyInput.addEventListener('focus', () => keyInput.select());

    document.getElementById('__arSave').onclick = () => {
      API_KEY = keyInput.value.trim();
      localStorage.setItem('__arKey', API_KEY);
      status(API_KEY ? '🔑 Salva' : '⚠️ Vazia');
    };
    keyInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') document.getElementById('__arSave').click();
    });

    document.getElementById('__arBtn').onclick = () => {
      if (!API_KEY) { status('⚠️ Cole a chave'); keyInput.focus(); return; }
      ligado = !ligado;
      const b = document.getElementById('__arBtn');
      b.textContent = ligado ? 'Parar' : 'Iniciar';
      b.style.background = ligado ? '#c00' : '#0a0';
      if (ligado) {
        loop();
        if (timer) clearInterval(timer);
        timer = setInterval(loop, INTERVALO_MS);
      } else {
        if (timer) clearInterval(timer);
        timer = null;
        status('Parado');
      }
    };

    document.getElementById('__arX').onclick = () => {
      if (timer) clearInterval(timer);
      box.remove();
      window.__arInit = false;
      ligado = false;
    };

    let dx = 0, dy = 0, down = false;
    box.onmousedown = (e) => {
      if (e.target.tagName === 'BUTTON' || e.target.tagName === 'INPUT') return;
      down = true;
      dx = e.clientX - box.offsetLeft;
      dy = e.clientY - box.offsetTop;
    };
    document.addEventListener('mousemove', (e) => {
      if (!down) return;
      box.style.left = (e.clientX - dx) + 'px';
      box.style.top = (e.clientY - dy) + 'px';
      box.style.right = 'auto';
    });
    document.addEventListener('mouseup', () => { down = false; });
  }

  setInterval(() => {
    const el = document.getElementById('__arBuf');
    if (el) el.textContent = '📖 ' + bufferPaginas.length + ' páginas no contexto';
  }, 1500);

  ui();
  console.log('%c[AR] Pronto. Suporta múltiplas questões por bloco.', 'color:#0a0;font-weight:bold');
})();