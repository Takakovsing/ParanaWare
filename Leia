javascript:(async function autoReaderFinal() {
    if (window.__autoIA) {
        window.__autoIA.parar();
        return;
    }

    const SEGUNDOS_PAGINA = 5;
    const MAX_PAGINAS = 40;
    const MAX_CHARS = 12000;

    let API_KEY = localStorage.getItem("__or_key") || "";
    if (!API_KEY) {
        API_KEY = prompt("Cole sua chave OpenRouter:");
        if (!API_KEY) return;
        localStorage.setItem("__or_key", API_KEY);
    }

    const memoria = [];
    let ativo = true;
    let contador = SEGUNDOS_PAGINA;
    let paginasViradas = 0;
    let ultimoHash = "";

    const sleep = ms => new Promise(r => setTimeout(r, ms));

    const painel = document.createElement("div");
    painel.id = "__autoIA_painel";
    painel.style.cssText = `
        position:fixed;bottom:20px;right:20px;z-index:2147483647;
        width:290px;background:#111;color:#fff;
        font:12px/1.5 system-ui,sans-serif;padding:15px;
        border:1px solid #333;border-radius:12px;
        box-shadow:0 8px 30px #0009;user-select:none;
    `;

    painel.innerHTML = `
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
            <span id="__dot" style="width:10px;height:10px;background:#4caf50;
            border-radius:50%;animation:__pulse 1s infinite"></span>
            <strong id="__titulo">📖 Folheando</strong>
            <span style="margin-left:auto;color:#888">PREMIUM</span>
        </div>

        <div id="__contador" style="font-size:34px;font-weight:800;
        text-align:center;color:#4caf50;padding:4px">5</div>

        <div style="height:4px;background:#292929;border-radius:9px;overflow:hidden">
            <div id="__barra" style="height:100%;width:100%;background:#4caf50;
            transition:width .3s"></div>
        </div>

        <div id="__mensagem" style="margin:10px 0;color:#ccc;min-height:35px;
        white-space:pre-wrap">Iniciando leitura...</div>

        <div style="background:#1b1b1b;border-radius:7px;padding:9px;
        margin-bottom:10px">
            📄 Páginas visitadas: <b id="__total">0</b><br>
            🧠 Memória: <b id="__mem" style="color:#4caf50">0 caracteres</b>
        </div>

        <div style="display:flex;gap:6px;margin-bottom:7px">
            <button id="__btnRepetir" style="flex:2;background:#ff9800;color:white;
            border:0;padding:9px;border-radius:6px;font-weight:bold">
                🔄 DE NOVO
            </button>
            <button id="__btnKey" style="flex:1;background:#292929;color:white;
            border:1px solid #444;padding:9px;border-radius:6px">
                🔑
            </button>
        </div>

        <button id="__btnParar" style="width:100%;background:#e53955;color:white;
        border:0;padding:9px;border-radius:6px;font-weight:bold">
            ⏹ PARAR
        </button>

        <style>
            @keyframes __pulse {
                0%,100% {opacity:1;transform:scale(1)}
                50% {opacity:.4;transform:scale(1.3)}
            }
            #__autoIA_painel button {cursor:pointer}
            #__autoIA_painel button:active {transform:scale(.98)}
        </style>
    `;

    document.body.appendChild(painel);

    const $ = id => painel.querySelector("#__" + id);

    function status(txt) {
        $("mensagem").textContent = txt;
    }

    function setModo(nome) {
        $("titulo").textContent = nome;
        const lendo = nome.includes("Folheando");
        $("dot").style.background = lendo ? "#4caf50" : "#2196f3";
        $("contador").style.color = lendo ? "#4caf50" : "#2196f3";
    }

    function capturarTexto() {
        const clone = document.body.cloneNode(true);

        clone.querySelectorAll(
            "#__autoIA_painel,script,style,nav,header,footer"
        ).forEach(el => el.remove());

        return (clone.innerText || "")
            .split("\n")
            .map(s => s.trim())
            .filter(s => s.length > 2 && s.length < 800)
            .filter(s => !/^(próxima página|página anterior|terminar)$/i.test(s))
            .join("\n");
    }

    function guardarPagina() {
        const texto = capturarTexto();
        if (!texto || texto.length < 20) return;

        const hash = texto.length + "|" + texto.slice(0, 100) +
            "|" + texto.slice(-100);

        if (hash === ultimoHash) return;

        ultimoHash = hash;
        memoria.push(texto);

        while (memoria.length > MAX_PAGINAS) memoria.shift();

        const total = memoria.reduce((s, p) => s + p.length, 0);
        $("mem").textContent = total + " caracteres";
    }

    function obterContexto() {
        return memoria.join("\n\n--- Página seguinte ---\n\n")
            .slice(-MAX_CHARS);
    }

    function avancarPagina() {
        const seletores = [
            "#right-page-btn",
            ".page-switch-overlay-icon.next",
            ".page-switch-overlay-icon.embedded.next",
            '[aria-label="Next page"]',
            '[aria-label="Próxima página"]',
            'button[title="Next page"]'
        ];

        for (const seletor of seletores) {
            const el = document.querySelector(seletor);
            if (!el || el.disabled) continue;

            const estilo = getComputedStyle(el);
            if (estilo.display === "none" ||
                estilo.visibility === "hidden") continue;

            if (el.getClientRects().length) {
                el.click();
                return true;
            }
        }

        document.dispatchEvent(new KeyboardEvent("keydown", {
            key: "ArrowRight",
            code: "ArrowRight",
            keyCode: 39,
            which: 39,
            bubbles: true
        }));

        return false;
    }

    async function consultarIA(pergunta) {
        const contexto = obterContexto();

        const resposta = await fetch(
            "https://openrouter.ai/api/v1/chat/completions",
            {
                method: "POST",
                headers: {
                    "Authorization": "Bearer " + API_KEY,
                    "Content-Type": "application/json",
                    "HTTP-Referer": location.origin,
                    "X-Title": "Leitor de Estudos"
                },
                body: JSON.stringify({
                    model: "openrouter/free",
                    messages: [
                        {
                            role: "system",
                            content:
                                "Você é um tutor. Explique o conteúdo de forma clara, " +
                                "use o texto de apoio quando relevante e não invente informações."
                        },
                        {
                            role: "user",
                            content:
                                "Texto de apoio:\n" + contexto +
                                "\n\nPergunta para estudar:\n" + pergunta +
                                "\n\nExplique o raciocínio e a resposta."
                        }
                    ],
                    temperature: 0.2,
                    max_tokens: 700
                })
            }
        );

        if (!resposta.ok) {
            throw new Error("OpenRouter HTTP " + resposta.status);
        }

        const dados = await resposta.json();
        return dados.choices?.[0]?.message?.content ||
            "A IA não retornou uma resposta.";
    }

    async function perguntar() {
        const pergunta = prompt("Digite a pergunta para a IA:");
        if (!pergunta) return;

        setModo("🧠 Consultando IA...");
        status("Analisando o texto guardado...");

        try {
            const resultado = await consultarIA(pergunta);
            status(resultado);
        } catch (e) {
            status("Erro: " + e.message);
        } finally {
            setModo("📖 Folheando");
        }
    }

    function parar() {
        ativo = false;
        window.__autoIA = null;
        painel.remove();
    }

    $("btnParar").onclick = parar;
    $("btnKey").onclick = () => {
        const nova = prompt("Nova chave OpenRouter:", API_KEY);
        if (nova && nova.trim()) {
            API_KEY = nova.trim();
            localStorage.setItem("__or_key", API_KEY);
            status("Chave atualizada.");
        }
    };

    $("btnRepetir").onclick = perguntar;

    window.__autoIA = { parar };

    try {
        status("Guardando o conteúdo da página...");
        guardarPagina();

        while (ativo) {
            guardarPagina();
            $("total").textContent = paginasViradas;

            $("contador").textContent = contador;
            $("barra").style.width =
                (contador / SEGUNDOS_PAGINA * 100) + "%";

            await sleep(1000);
            if (!ativo) break;

            contador--;

            if (contador <= 0) {
                guardarPagina();

                const antes = capturarTexto();
                avancarPagina();

                await sleep(1200);
                guardarPagina();

                const depois = capturarTexto();

                if (depois !== antes) {
                    paginasViradas++;
                    $("total").textContent = paginasViradas;
                    status("Página nova guardada na memória.");
                } else {
                    status("Aguardando mudança de página...");
                }

                contador = SEGUNDOS_PAGINA;
            }
        }
    } catch (e) {
        console.error(e);
        status("Erro: " + e.message);
    }
})();