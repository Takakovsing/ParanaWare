
(async function PORTUGA_IA() {
    if (window.__PORTUGA_IA) {
        window.__PORTUGA_IA.destroy();
        return;
    }

    const ID = "__portuga_ia_panel";
    const state = {
        pages: [],
        hash: "",
        key: sessionStorage.getItem("__portuga_or_key") || "",
        timer: null,
        busy: false,
        minimized: false
    };

    const panel = document.createElement("div");
    panel.id = ID;

    panel.style.cssText = `
        position:fixed;
        right:8px;
        bottom:8px;
        width:180px;
        max-width:calc(100vw - 16px);
        max-height:45vh;
        overflow:auto;
        z-index:2147483647;
        background:rgba(12,13,17,.97);
        color:#f5f5f7;
        border:1px solid #373943;
        border-radius:12px;
        box-shadow:0 5px 25px #0009;
        font:10px/1.4 system-ui,sans-serif;
        backdrop-filter:blur(15px);
    `;

    panel.innerHTML = `
        <div id="head" style="
            display:flex;align-items:center;gap:5px;
            padding:7px;background:linear-gradient(110deg,#242630,#101116);
            border-bottom:1px solid #343640;
            cursor:move;touch-action:none">
            <span style="font-size:14px">🕸️</span>
            <div style="flex:1;min-width:0">
                <b style="font-size:11px">PORTUGA IA</b>
                <div style="font-size:8px;color:#aaa">READER PREMIUM</div>
            </div>
            <button id="min">−</button>
            <button id="close">×</button>
        </div>

        <div id="body" style="padding:7px">
            <div id="status" style="color:#bdbdc7;margin-bottom:7px">
                ● Leitor ativo
            </div>

            <div style="display:flex;gap:5px;margin-bottom:7px">
                <div style="flex:1;background:#202128;padding:5px;border-radius:6px">
                    <div style="font-size:8px;color:#aaa">PÁGINAS</div>
                    <div id="pages" style="font-size:14px;font-weight:bold">0</div>
                </div>
                <div style="flex:1;background:#202128;padding:5px;border-radius:6px">
                    <div style="font-size:8px;color:#aaa">MEMÓRIA</div>
                    <div id="chars" style="font-size:14px;font-weight:bold">0</div>
                </div>
            </div>

            <textarea id="question"
                placeholder="Digite sua pergunta..."
                style="box-sizing:border-box;width:100%;height:45px;
                resize:vertical;background:#191a20;color:white;
                border:1px solid #41434e;border-radius:7px;
                padding:6px;font:10px system-ui"></textarea>

            <button id="ask" class="main">
                ✦ ANALISAR COM IA
            </button>

            <div class="buttons">
                <button id="read">↻ LER</button>
                <button id="key">⚙ API</button>
                <button id="clear">⌫ LIMPAR</button>
                <button id="copy">▣ COPIAR</button>
            </div>

            <div id="result" style="
                display:none;white-space:pre-wrap;overflow-wrap:anywhere;
                margin-top:7px;padding:7px;border:1px solid #333540;
                background:#17181e;border-radius:7px;max-height:120px;overflow:auto">
            </div>

            <div style="margin-top:6px;font-size:8px;color:#777">
                PORTUGA IA • v2.0
            </div>
        </div>
    `;

    const style = document.createElement("style");

    style.textContent = `
        #${ID} button {
            cursor:pointer;
            background:#292a32;
            color:white;
            border:1px solid #41434c;
            border-radius:6px;
            padding:5px 3px;
            font-size:9px;
            touch-action:manipulation;
        }

        #${ID} .main {
            width:100%;
            margin-top:6px;
            background:#eee;
            color:#111;
            padding:7px 3px;
            font-size:10px;
            font-weight:bold;
            border:0;
        }

        #${ID} .buttons {
            display:grid;
            grid-template-columns:1fr 1fr;
            gap:5px;
            margin-top:6px;
        }

        #${ID} button:disabled {
            opacity:.5;
        }

        #${ID} textarea:focus {
            border-color:#aaa;
            outline:none;
        }
    `;

    document.documentElement.append(style, panel);

    const $ = id => panel.querySelector("#" + id);

    function setStatus(text) {
        $("status").textContent = text;
    }

    function showResult(text) {
        $("result").style.display = "block";
        $("result").textContent = text;
    }

    // LEITURA AUTOMÁTICA
    function readPage() {
        try {
            const clone = document.body.cloneNode(true);

            clone.querySelectorAll(
                "#" + ID +
                ",script,style,noscript,svg,nav,footer,header,input,textarea,select"
            ).forEach(el => el.remove());

            const text = (clone.innerText || clone.textContent || "")
                .split("\n")
                .map(line => line.trim())
                .filter(line => line.length > 2 && line.length < 1200)
                .join("\n")
                .slice(0, 18000);

            if (!text) return;

            const hash =
                text.length + "|" +
                text.slice(0, 180) + "|" +
                text.slice(-180);

            if (hash !== state.hash) {
                state.hash = hash;
                state.pages.push(text);

                if (state.pages.length > 30) {
                    state.pages.shift();
                }
            }

            $("pages").textContent = state.pages.length;

            const total = state.pages.reduce(
                (sum, page) => sum + page.length, 0
            );

            $("chars").textContent =
                total >= 10000
                    ? (total / 1000).toFixed(1) + "k"
                    : total;

            setStatus("● Leitor ativo");
        } catch (error) {
            setStatus("Erro na leitura");
        }
    }

    // MEMÓRIA
    function getContext() {
        return state.pages
            .slice(-12)
            .join("\n\n--- Página ---\n\n")
            .slice(-14000);
    }

    // CONFIGURAÇÃO DA API
    function configureKey() {
        const key = prompt(
            "Cole sua chave OpenRouter:",
            state.key
        );

        if (key && key.trim()) {
            state.key = key.trim();
            sessionStorage.setItem("__portuga_or_key", state.key);
            setStatus("● API configurada");
        }
    }

    // ANÁLISE COM IA
    async function askAI() {
        if (state.busy) return;

        if (!state.key) {
            configureKey();
            if (!state.key) return;
        }

        const question = $("question").value.trim();

        if (!question) {
            setStatus("Digite sua pergunta");
            $("question").focus();
            return;
        }

        readPage();

        state.busy = true;
        $("ask").disabled = true;
        $("ask").textContent = "ANALISANDO...";
        setStatus("Consultando IA...");

        try {
            const response = await fetch(
                "https://openrouter.ai/api/v1/chat/completions",
                {
                    method: "POST",
                    headers: {
                        "Authorization": "Bearer " + state.key,
                        "Content-Type": "application/json",
                        "HTTP-Referer": location.origin,
                        "X-Title": "PORTUGA IA"
                    },
                    body: JSON.stringify({
                        model: "openrouter/free",
                        messages: [
                            {
                                role: "system",
                                content:
                                    "Você é um assistente educacional brasileiro. " +
                                    "Ajude a interpretar textos e compreender perguntas. " +
                                    "Responda em português, com clareza e objetividade. " +
                                    "Use o contexto fornecido, não invente fatos e " +
                                    "avise quando faltar informação."
                            },
                            {
                                role: "user",
                                content:
                                    "TEXTO LIDO:\n" +
                                    (getContext() || "Nenhum texto capturado.") +
                                    "\n\nPERGUNTA:\n" + question
                            }
                        ],
                        temperature: 0.2,
                        max_tokens: 1200
                    })
                }
            );

            const data = await response.json();

            if (!response.ok) {
                throw new Error(
                    data?.error?.message || "HTTP " + response.status
                );
            }

            const answer = data?.choices?.[0]?.message?.content;

            if (!answer) {
                throw new Error("Resposta vazia da IA");
            }

            showResult(
                Array.isArray(answer)
                    ? answer.map(item => item.text || "").join("\n")
                    : answer
            );

            setStatus("● Análise concluída");

        } catch (error) {
            showResult(
                "ERRO:\n" +
                String(error.message || error).slice(0, 500) +
                "\n\nConfira sua API key, conexão e modelo."
            );

            setStatus("Falha na consulta");
        } finally {
            state.busy = false;
            $("ask").disabled = false;
            $("ask").textContent = "✦ ANALISAR COM IA";
        }
    }

    // BOTÕES
    $("read").onclick = () => {
        readPage();
        setStatus("● Leitura atualizada");
    };

    $("ask").onclick = askAI;
    $("key").onclick = configureKey;

    $("clear").onclick = () => {
        if (!confirm("Apagar a memória de leitura?")) return;

        state.pages = [];
        state.hash = "";

        $("pages").textContent = "0";
        $("chars").textContent = "0";

        setStatus("Memória apagada");
    };

    $("copy").onclick = async () => {
        const text = getContext();

        if (!text) {
            setStatus("Nenhum texto guardado");
            return;
        }

        try {
            await navigator.clipboard.writeText(text);
            setStatus("Texto copiado");
        } catch (error) {
            showResult(text);
            setStatus("Copie o texto exibido");
        }
    };

    // MINIMIZAR
    $("min").onclick = () => {
        state.minimized = !state.minimized;

        $("body").style.display =
            state.minimized ? "none" : "block";

        $("min").textContent =
            state.minimized ? "+" : "−";
    };

    // FECHAR E LIMPAR
    function destroy() {
        clearInterval(state.timer);
        panel.remove();
        style.remove();
        sessionStorage.removeItem("__portuga_or_key");
        delete window.__PORTUGA_IA;
    }

    $("close").onclick = destroy;

    // ARRASTAR COM TOQUE OU MOUSE
    let drag = null;
    const head = $("head");

    head.addEventListener("pointerdown", event => {
        if (event.target.closest("button")) return;

        const rect = panel.getBoundingClientRect();

        drag = {
            x: event.clientX - rect.left,
            y: event.clientY - rect.top
        };

        panel.style.right = "auto";
        panel.style.bottom = "auto";

        head.setPointerCapture(event.pointerId);
    });

    head.addEventListener("pointermove", event => {
        if (!drag) return;

        panel.style.left = Math.max(
            0,
            Math.min(
                innerWidth - panel.offsetWidth,
                event.clientX - drag.x
            )
        ) + "px";

        panel.style.top = Math.max(
            0,
            Math.min(
                innerHeight - 40,
                event.clientY - drag.y
            )
        ) + "px";
    });

    head.addEventListener("pointerup", () => drag = null);
    head.addEventListener("pointercancel", () => drag = null);

    // INICIAR
    state.timer = setInterval(readPage, 3000);
    window.__PORTUGA_IA = { destroy };

    readPage();

})();