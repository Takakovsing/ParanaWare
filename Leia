// ============ PARSER ROBUSTO ============
function extrairNumero(texto, totalOpcoes) {
    if (!texto) return null;
    const t = texto.trim();

    // 1) Número isolado no começo: "2", "2.", "2)", "2 -"
    let m = t.match(/^\s*(\d+)\b/);
    if (m) { const n = parseInt(m[1],10); if (n>=1 && n<=totalOpcoes) return n; }

    // 2) Qualquer número isolado no texto
    const nums = t.match(/\b(\d+)\b/g);
    if (nums) {
        for (const s of nums) {
            const n = parseInt(s,10);
            if (n>=1 && n<=totalOpcoes) return n;
        }
    }

    // 3) Letra no começo: "A", "A)", "B." → vira 1, 2, 3, 4
    m = t.match(/^\s*([A-Da-d])\b/);
    if (m) {
        const n = m[1].toUpperCase().charCodeAt(0) - 64; // A=1, B=2...
        if (n>=1 && n<=totalOpcoes) return n;
    }

    // 4) Números escritos por extenso ("um", "dois", "três", "quatro")
    const extenso = { um:1, 'primeiro':1, 'primeira':1,
                      dois:2, 'segundo':2, 'segunda':2,
                      tres:3, 'três':3, 'terceiro':3, 'terceira':3,
                      quatro:4, 'quarto':4, 'quarta':4 };
    const tl = t.toLowerCase();
    for (const palavra in extenso) {
        if (new RegExp('\\b'+palavra+'\\b').test(tl)) {
            const n = extenso[palavra];
            if (n>=1 && n<=totalOpcoes) return n;
        }
    }
    return null;
}