javascript:(()=>{
'use strict';

if(window.__LeiaParana?.stop)window.__LeiaParana.stop();

const ID='leia-parana-ai';
document.getElementById(ID)?.remove();

const state={active:true,timer:null,interval:null,key:localStorage.getItem('__leia_parana_openrouter_key')||'',seconds:180};
window.__LeiaParana={
 stop(){
  state.active=false;
  clearTimeout(state.timer);
  clearInterval(state.interval);
  document.getElementById(ID)?.remove();
 }
};

const box=document.createElement('div');
box.id=ID;
box.style.cssText='position:fixed;top:15%;left:50%;transform:translateX(-50%);width:min(340px,92vw);z-index:2147483647;background:#101014;color:#f5f5f5;border:1px solid #34343e;border-radius:12px;padding:15px;font:14px Arial;box-shadow:0 12px 45px #000b';

box.innerHTML=`
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
 <b style="font-size:17px">📘 Leia Paraná AI</b>
 <button id="lpClose" style="background:#282830;color:white;border:0;padding:6px 9px;border-radius:6px">✕</button>
</div>
<div style="color:#aaa;font-size:12px;margin-bottom:12px">Leitura • Estudo • OpenRouter</div>
<label style="display:block;margin-bottom:6px">Intervalo de avanço (segundos)</label>
<input id="lpSeconds" type="number" min="10" value="180" style="width:100%;box-sizing:border-box;background:#1c1c23;color:white;border:1px solid #383842;padding:9px;border-radius:7px;margin-bottom:10px">
<label style="display:flex;gap:8px;align-items:center;margin-bottom:12px">
 <input id="lpAutoNext" type="checkbox"> ⏭️ Avançar página automaticamente
</label>
<button id="lpKey" style="width:100%;padding:10px;background:#252530;color:white;border:1px solid #444451;border-radius:7px;margin-bottom:8px">🔑 Configurar OpenRouter</button>
<button id="lpRead" style="width:100%;padding:10px;background:#252530;color:white;border:1px solid #444451;border-radius:7px;margin-bottom:8px">📖 Ler página atual</button>
<button id="lpAsk" style="width:100%;padding:10px;background:#6246ea;color:white;border:0;border-radius:7px;margin-bottom:8px">🤖 Perguntar à IA</button>
<button id="lpStudy" style="width:100%;padding:10px;background:#252530;color:white;border:1px solid #444451;border-radius:7px">📝 Ajudar com questões</button>
<div id="lpStatus" style="margin-top:10px;color:#aaa;font-size:12px;white-space:pre-wrap">Pronto para estudar.</div>
<div id="lpAnswer" style="margin-top:10px;max-height:220px;overflow:auto;white-space:pre-wrap;line-height:1.5"></div>
`;

document.body.appendChild(box);

const $=id=>box.querySelector('#'+id);
const status=t=>$('lpStatus').textContent=t;
const answer=t=>$('lpAnswer').textContent=t;

function pageText(){
 const el=document.querySelector('iframe');
 let doc=document;
 try{if(el?.contentDocument?.body)doc=el.contentDocument}catch(e){}
 return (doc.body?.innerText||document.body.innerText||'').trim().slice(0,10000);
}

function nextPage(){
 try{
  if(window.ReadiumSDK?.reader?.openPageRight){
   window.ReadiumSDK.reader.openPageRight();return true;
  }
 }catch(e){}
 const selectors=['#right-page-btn','.page-switch-overlay-icon.next','.page-switch-overlay-icon.embedded.next'];
 for(const selector of selectors){
  const button=document.querySelector(selector);
  if(button){button.click();return true}
 }
 return false;
}

$('lpClose').onclick=()=>window.__LeiaParana.stop();

$('lpKey').onclick=()=>{
 const key=prompt('Cole sua chave de API do OpenRouter:',state.key);
 if(key===null)return;
 state.key=key.trim();
 localStorage.setItem('__leia_parana_openrouter_key',state.key);
 status(state.key?'Chave salva neste navegador.':'Chave removida.');
};

$('lpRead').onclick=()=>{
 const text=pageText();
 answer(text||'Não consegui encontrar o texto da página.');
 status(text?'Texto da página carregado.':'Nenhum texto encontrado.');
};

async function askAI(mode){
 if(!state.key){
  status('Configure primeiro sua chave do OpenRouter.');
  return;
 }
 const text=pageText();
 if(!text){
  status('Não consegui ler o texto da página.');
  return;
 }
 const question=prompt(mode==='study'
  ?'Qual questão ou dúvida você quer estudar?'
  :'O que você quer perguntar sobre esta página?');
 if(!question?.trim())return;

 status('Consultando a IA...');
 answer('');

 try{
  const response=await fetch('https://openrouter.ai/api/v1/chat/completions',{
   method:'POST',
   headers:{
    'Authorization':'Bearer '+state.key,
    'Content-Type':'application/json'
   },
   body:JSON.stringify({
    model:'openrouter/free',
    messages:[
     {
      role:'system',
      content:mode==='study'
       ?'Você é um tutor educacional. Explique o raciocínio, ajude o estudante a compreender a questão e indique como verificar a resposta. Não marque nem envie respostas na plataforma.'
       :'Você é um tutor educacional. Responda com clareza, usando o conteúdo da página e identificando quando faltar informação.'
     },
     {role:'user',content:'CONTEÚDO DA PÁGINA:\\n'+text+'\\n\\nPEDIDO DO ESTUDANTE:\\n'+question}
    ]
   })
  });

  const data=await response.json();
  if(!response.ok)throw Error(data?.error?.message||'Erro HTTP '+response.status);
  const result=data?.choices?.[0]?.message?.content;
  if(!result)throw Error('A IA não retornou uma resposta.');
  answer(result);
  status('Resposta recebida.');
 }catch(e){
  status('Erro: '+e.message);
 }
}

$('lpAsk').onclick=()=>askAI('ask');
$('lpStudy').onclick=()=>askAI('study');

$('lpAutoNext').onchange=()=>{
 clearInterval(state.interval);
 if(!$('lpAutoNext').checked){
  status('Avanço automático desativado.');
  return;
 }
 state.seconds=Math.max(10,Number($('lpSeconds').value)||180);
 let elapsed=0;
 status('Avanço automático ativado.');
 state.interval=setInterval(()=>{
  if(!state.active)return;
  elapsed++;
  if(elapsed>=state.seconds){
   elapsed=0;
   if(!nextPage())status('Não encontrei o botão de avançar nesta página.');
  }
 },1000);
};

})();