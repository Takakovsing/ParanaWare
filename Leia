  // arrastar
  let dx = 0, dy = 0, down = false;
  box.addEventListener('mousedown', (e) => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'BUTTON') return;
    down = true;
    dx = e.clientX - box.offsetLeft;
    dy = e.clientY - box.offsetTop;
  });
  document.addEventListener('mousemove', (e) => {
    if (!down) return;
    box.style.left = (e.clientX - dx) + 'px';
    box.style.top = (e.clientY - dy) + 'px';
    box.style.right = 'auto';
  });
  document.addEventListener('mouseup', () => down = false);

  $('arX').onclick = () => {
    autoAnswer = autoNextPage = timerBypass = false;
    [timerPage, timerAnswer, timerByp].forEach(t => t && clearInterval(t));
    box.remove();
    window.__arInit = false;
  };

  // toggles
  function sw(id, cb) {
    const el = $(id);
    el.onclick = () => { el.classList.toggle('on'); cb(el.classList.contains('on')); };
  }
  sw('sA', v => { autoAnswer = v; status('Auto Answer: ' + (v ? 'ON' : 'OFF')); });
  sw('sP', v => { autoNextPage = v; status('Auto Next Page: ' + (v ? 'ON' : 'OFF')); });
  sw('sT', v => {
    timerBypass = v;
    if (v) { iniciarBypass(); status('Timer Bypass: ON'); }
    else { if (timerByp) { clearInterval(timerByp); timerByp = null; } status('Timer Bypass: OFF'); }
  });
  $('arT').onchange = (e) => tempoPag = parseInt(e.target.value) || 1800;

  $('arGo').onclick = () => {
    if (!CHAVE || CHAVE === 'CHAVE_OPENROUTER') { status('⚠️ Falta a chave'); return; }
    status('▶ Rodando');
