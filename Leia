(function autoAvancar() {
    // Se já está rodando, para
    if (window.__autoTimer) {
        clearInterval(window.__autoTimer);
        window.__autoTimer = null;
        console.log('⏹ Auto-avançar PARADO');
        return;
    }

    const SEGUNDOS = 5;
    const INTERVALO = SEGUNDOS * 1000;

    console.log(`▶ Auto-avançar INICIADO (${SEGUNDOS}s por página)`);
    console.log('Rode o script de novo pra parar.');

    window.__autoTimer = setInterval(() => {
        // Tenta os seletores do Odilo (overlay de próxima página)
        let botao =
            document.querySelector('.page-switch-overlay-icon.embedded.next') ||
            document.querySelector('[ng-click*="goToNextPage"]') ||
            document.querySelector('#left-page-btn + button') ||
            document.querySelector('button[aria-label="Próximo"]');

        if (botao && botao.offsetParent !== null) {
            botao.click();
            console.log(`➡ Página avançada (${new Date().toLocaleTimeString()})`);
        } else {
            // Fallback: simula seta direita no teclado
            document.dispatchEvent(new KeyboardEvent('keydown', {
                key: 'ArrowRight', code: 'ArrowRight',
                keyCode: 39, which: 39, bubbles: true
            }));
            console.log('➡ Seta direita enviada (fallback)');
        }
    }, INTERVALO);
})();
