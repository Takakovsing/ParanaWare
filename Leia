(async function solverQuizIA() {
    if (window.__quizSolver) { window.__quizSolver.parar(); return; }

    // ============ CONFIG ============
    const MODELO = 'meta-llama/llama-3.3-70b-instruct:free';
    const AUTOSUBMIT = true;   // clicar em TERMINAR sozinho? (true/false)
    const DELAY_MS = 1500;     // espera antes de clicar na opção (ms)

    let API_KEY = localStorage.getItem('__or_key');
    if (!API_KEY) {
        API_KEY = prompt('Cole sua chave da OpenRouter (sk-or-v1-...):');
        if (!API_KEY) return;
        localStorage.setItem('__or_key', API_KEY);
    }

    // ============ PAINEL ============
    const painel = document.createElement('div');
    painel.style.cssText = `
        position:fixed; bottom:20px; right:20px; z-index:2147483647;
        background:#1a1a1a; color:#fff; font:12px/1.45 system-ui,sans-serif;
        padding:14px 16px; border-radius:10px; max-width:340px;
        box-shadow:0 6px 25px rgba(0,0,0,.6); user-select:none;
    `;
    painel.innerHTML = `
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
            <span id="__dot" style="width:10px;height:10px;background:#4caf50;
                  border-radius:50%;animation:pulse 1s infinite;"></span>
            <strong>Quiz IA</strong>
        </div>
        <div id="__status" style="color:#ccc;min-height:40px;
             white-space:pre-wrap;font-size:12px;margin-bottom:8px;">Vigiando tela...</div>
        <div style="display:flex;gap:6px;">
            <button id="__btnParar" style="flex:1;background:#e91e63;color:#fff;
                border:0;padding:8px;border-radius:6px;font:bold 11px sans-serif;
                cursor:pointer;">⏹ PARAR</button>
            <button id="__btnKey" style="background:#333;color:#fff;border:0;
                padding:8px 10px;border-radius:6px;font:bold 11px sans-serif;
                cursor:pointer;">🔑 key</button>
        </div>
        <style>
            @keyframes pulse{
                0%,100%{opacity:1;transform:scale(1)}
                50%{opacity:.4;transform:scale(1.3)}
            }
        </style>
    `;
    document.body.appendChild(painel);

    const elStatus = painel.querySelector('#__status');
    const elDot    = painel.querySelector('#__dot');

    function log(msg) {
        console.log('[QuizIA]', msg);
        elStatus.textContent = msg;
    }

    // ============ UTIL ============
    const sleep = ms => new Promise(r => setTimeout(r, ms));

    function acharBotaoTerminar() {
        const btns = document.querySelectorAll('button');
        for (const b of btns) {
            if (b.offsetParent === null) continue;
            const t = (b.textContent || '').trim();
            if (/^terminar$/i.test(t)) return b;
        }
        return null;
    }

    function acharContainerQuestao() {
        const btnT = acharBotaoTerminar();
        if (!btnT) return null;
        let c = btnT.parentElement;
        let i = 0;
        while (c && c !== document.body && i < 15) {
            const t = (c.innerText || '').trim();
            if (/tentativas\s+restantes/i.test(t) && t.length > 60) return c;
            c = c.parentElement; i++;
        }
        return null;
    }

    function extrairQuestao(container) {
        // pega texto "limpo" via innerText, remove linhas de interface
        const linhas = (container.innerText || '')
            .split('\n').map(s => s.trim()).filter(Boolean)
            .filter(s =>
                !/^tentativas\s+restantes/i.test(s) &&
                !/^terminar$/i.test(s) &&
                !/^bloco\s*\d+/i.test(s) &&
                s.length > 0
            );

        // Acha a pergunta: linha mais longa que termina em "?" ou tem "?"
        let pergunta = linhas.find(s => s.includes('?') && s.length > 20) || linhas[0];

        // Pega as opções: linhas depois da pergunta (até 8)
        const idxPerg = linhas.indexOf(pergunta);
        let opcoes = linhas.slice(idxPerg + 1)
            .filter(s => s.length > 2 && s.length < 250)
            .slice(0, 8);

        return { pergunta, opcoes };
    }

    function acharElementoPorTexto(texto, container) {
        if (!texto) return null;
        const alvo = texto.trim().toLowerCase();
        const todos = container.querySelectorAll('*');
        let melhor = null, melhorLen = Infinity;
        for (const el of todos) {
            if (el.children.length > 3) continue;
            const t = (el.innerText || '').trim().toLowerCase();
            if (!t) continue;
            // match exato ou muito próximo
            if (t === alvo || (t.length > 10 && t.includes(alvo.slice(0, Math.min(30, alvo.length))))) {
                if (t.length < melhorLen) {
                    melhor = el; melhorLen = t.length;
                }
            }
        }
        return melhor;
    }

    // ============ OPENROUTER ============
    async function perguntarIA(pergunta, opcoes) {
        const lista = opcoes.map((o, i) => `${i+1}. ${o}`).join('\n');
        const prompt =
`Você responde questões de múltipla escolha em português com base em interpretação de texto.

PERGUNTA:
${pergunta}

OPÇÕES:
${lista}

Responda APENAS com o número da opção correta (ex: 2). Sem explicação, sem texto extra.`;

        const r = await fetch('https://openrouter.ai/api/v1/chat/completions', {
            method: 'POST',
            headers: {
                'Authorization': 'Bearer ' + API_KEY,
                'Content-Type': 'application/json',
                'HTTP-Referer': location.origin,
                'X-Title': 'LeiaParana Quiz Solver'
            },
            body: JSON.stringify({
                model: MODELO,
                messages: [
                    { role: 'system', content: 'Responda apenas com um número.' },
                    { role: 'user', content: prompt }
                ],
                temperature: 0,
                max_tokens: 20
            })
        });

        if (!r.ok) {
            const erro = await r.text();
            throw new Error(`OpenRouter ${r.status}: ${erro.slice(0, 200)}`);
        }

        const data = await r.json();
        const txt = (data?.choices?.[0]?.message?.content || '').trim();
        const num = parseInt(txt.replace(/\D/g, ''), 10);
        return { num, raw: txt };
    }

    // ============ RESOLVER ============
    let resolvendo = false;

    async function tentarResolver() {
        if (resolvendo) return;
        const container = acharContainerQuestao();
        if (!container) return;

        resolvendo = true;
        elDot.style.background = '#2196f3';
        elDot.style.animation = 'none';

        try {
            const { pergunta, opcoes } = extrairQuestao(container);
            if (!pergunta || opcoes.length < 2) {
                log('❌ Não consegui extrair pergunta/opções.\n' +
                    'Pergunta: ' + (pergunta || '—').slice(0,80) + '\n' +
                    'Opções: ' + opcoes.length);
                resolvendo = false;
                return;
            }

            log(`🧠 Perguntando à IA...\n"${pergunta.slice(0, 70)}..."`);

            let ia;
            try {
                ia = await perguntarIA(pergunta, opcoes);
            } catch (e) {
                log('❌ Erro na API: ' + e.message);
                elDot.style.background = '#f44336';
                resolvendo = false;
                return;
            }

            const idx = ia.num - 1;
            if (isNaN(idx) || idx < 0 || idx >= opcoes.length) {
                log(`❌ IA respondeu "${ia.raw}" — fora do intervalo (1-${opcoes.length})`);
                elDot.style.background = '#f44336';
                resolvendo = false;
                return;
            }

            const textoOpcao = opcoes[idx];
            log(`✅ IA escolheu (${ia.num}):\n"${textoOpcao.slice(0, 80)}"`);

            // Acha e clica no elemento que contém essa opção
            const alvo = acharElementoPorTexto(textoOpcao, container);
            if (!alvo) {
                log('❌ Não achei o elemento clicável da opção.');
                elDot.style.background = '#f44336';
                resolvendo = false;
                return;
            }

            // Sobe até achar algo clicável (label, md-radio-button, button)
            let clicavel = alvo;
            let up = 0;
            while (clicavel && up < 6) {
                const tag = clicavel.tagName.toLowerCase();
                if (tag === 'button' || tag === 'label' ||
                    tag.includes('radio') ||
                    clicavel.getAttribute('role') === 'radio' ||
                    clicavel.getAttribute('ng-click')) break;
                clicavel = clicavel.parentElement; up++;
            }
            if (!clicavel) clicavel = alvo;

            await sleep(DELAY_MS);
            clicavel.click();
            log('👆 Opção clicada. Enviando...');

            if (AUTOSUBMIT) {
                await sleep(900);
                const btnT = acharBotaoTerminar();
                if (btnT) {
                    btnT.click();
                    log('📤 Enviado!');
                } else {
                    log('⚠️ Botão TERMINAR não encontrado — envie manualmente.');
                }
            } else {
                log('✋ Autosubmit desligado. Clique em TERMINAR manualmente.');
            }

            elDot.style.background = '#4caf50';
            elDot.style.animation = 'pulse 1s infinite';
        } catch (e) {
            log('❌ Erro inesperado: ' + e.message);
            console.error(e);
            elDot.style.background = '#f44336';
        } finally {
            // trava por alguns segundos pra não reprocessar a mesma questão
            setTimeout(() => { resolvendo = false; }, 8000);
        }
    }

    // ============ MONITOR ============
    const obs = new MutationObserver(() => tentarResolver());
    obs.observe(document.body, {
        childList: true, subtree: true,
        attributes: true, attributeFilter: ['style','class']
    });
    const timer = setInterval(tentarResolver, 1500);

    // ============ PARAR ============
    function parar() {
        clearInterval(timer);
        obs.disconnect();
        painel.remove();
        window.__quizSolver = null;
        console.log('[QuizIA] Parado.');
    }
    painel.querySelector('#__btnParar').onclick = parar;
    painel.querySelector('#__btnKey').onclick = () => {
        const nova = prompt('Nova chave OpenRouter:', API_KEY);
        if (nova) { API_KEY = nova; localStorage.setItem('__or_key', nova); log('🔑 Chave atualizada.'); }
    };

    window.__quizSolver = { parar };
    console.log('[QuizIA] Ativo. Modelo:', MODELO);
})();