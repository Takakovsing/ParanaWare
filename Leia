      '[id*="counter"]','[class*="counter"]','[id*="clock"]','[class*="clock"]'];
    sels.forEach(s => {
      try { document.querySelectorAll(s).forEach(el => {
        if (el.textContent && /\d{1,2}:\d{2}/.test(el.textContent)) els.push(el);
      }); } catch (e) {}
    });
    document.querySelectorAll('*').forEach(el => {
      if (el.textContent && /^\d{1,3}:\d{2}$/.test(el.textContent.trim()) && !els.includes(el))
        els.push(el);
    });
    return els;
  }
