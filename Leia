(function () {
  'use strict';
  if (window.top !== window.self) return;
  if (window.__arInit) return;
  window.__arInit = true;

  // ---------- Autenticação (mesma do PORTUGA IA) ----------
  const KEY_CORRETA = "rzinmodder";
  if (prompt("Digite a Key:") !== KEY_CORRETA) {
    alert("Key inválida!");
    return;
  }

  // ================= CONFIG =================
  const MODELO = 'openrouter/auto';
  const MAX_PAGINAS = 5;
  const MAX_CHARS = 2000;
  const ICONE = "https://media.tenor.com/m11vauEEbcUAAAAM/meow-neko-arc.gif";
  // ==========================================

  let autoAnswer = false;
  let autoNextPage = false;
  let timerBypass = false;
  let rodando = false;
  let processando = false;
  let timerPage = null;
  let timerAnswer = null;
  let bypassInterval = null;
  let tempoPag = 1800;
  let tempoOriginal = 0;
  let inicioBypass = 0;
  let minimized = false;
  let hidden = false;
  let notifyTimer;
  let apiKey = localStorage.getItem('__arKey') || '';
  let lockAte = 0;
  const buffer = [];
  let ultimaPagina = '';
  const respondidas = new Set();

  const $ = id => document.getElementById(id);
  const wait = ms => new Promise(r => setTimeout(r, ms));
  const hash = s => (s || '').trim().slice(0, 120);

  let favicon = document.querySelector('link[rel~="icon"]');
  if (!favicon) { favicon = document.createElement('link'); favicon.rel = 'icon'; document.head.appendChild(favicon); }
  favicon.href = ICONE;

  // ================= CSS =================
  const style = document.createElement('style');
  style.id = 'arStyle';
  style.textContent = `
#arFloat,#arToggle,#arNotify{box-sizing:border-box}
#arFloat{
  position:fixed;right:16px;bottom:96px;
  width:min(258px,calc(100vw - 24px));
  max-height:calc(100dvh - 116px);
  overflow-y:auto;overflow-x:hidden;padding:12px;color:#eee;
  background:rgba(18,18,22,.96);
  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
  border:1px solid #ffffff26;border-radius:14px;
  z-index:2147483640;font-family:"Trebuchet MS",Arial,sans-serif;
  box-shadow:0 10px 30px #000b;
  scrollbar-width:thin;scrollbar-color:#444 transparent;
  transition:opacity .2s,transform .2s,visibility .2s;isolation:isolate;
}
#arFloat.arMini{opacity:0;visibility:hidden;pointer-events:none;transform:scale(.82)}
#arHead{position:relative;min-height:26px;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:900;letter-spacing:1.4px;margin-bottom:10px}
#arDragHandle{cursor:grab;touch-action:none;padding:5px 12px;border-radius:8px;user-select:none;-webkit-user-select:none}
#arDragHandle:active{cursor:grabbing;background:#ffffff10}
#arEditApi{position:absolute;right:0;top:-2px;width:34px;height:24px;padding:0;border:1px solid #ffffff30;border-radius:7px;background:#ffffff10;color:#fff;font-size:10px;font-weight:bold;cursor:pointer;font-family:inherit;letter-spacing:.6px}
#arEditApi:hover{background:#ffffff22}
#arLine{height:1px;margin-bottom:10px;background:linear-gradient(90deg,transparent,#ffffff50,transparent)}
.arLabel{display:block;color:#a8a8b3;font-size:9px;font-weight:bold;letter-spacing:1.2px;margin:10px 0 6px}
.arToggleRow{display:flex;align-items:center;gap:8px;padding:7px 10px;margin-top:7px;background:#ffffff08;border:1px solid #ffffff18;border-radius:9px;font-size:11px;color:#ddd;font-weight:bold;cursor:pointer;user-select:none;-webkit-user-select:none;letter-spacing:.3px}
.arToggleRow input{width:14px;height:14px;margin:0;flex-shrink:0;accent-color:#39ff78;cursor:pointer}
.arToggleRow.arOn{border-color:#39ff7850;background:#39ff780f;color:#c8ffdc}
#arFloat input[type=number]{display:block;width:100%;box-sizing:border-box;background:rgba(0,0,0,.38);color:#eee;border:1px solid #ffffff20;border-radius:9px;padding:8px;outline:none;font-family:inherit;font-size:12px;text-align:center}
#arFloat input:focus{border-color:#ffffff65;box-shadow:0 0 12px #ffffff0c}
#arFloat button.arAction{display:block;width:100%;min-height:36px;border:1px solid #ffffff20;border-radius:10px;padding:9px;margin-top:8px;background:linear-gradient(135deg,#ffffff18,#ffffff08);color:#eee;font-family:inherit;font-weight:bold;font-size:12px;cursor:pointer;transition:background .2s,transform .2s;letter-spacing:.6px}
#arFloat button.arAction:active{transform:scale(.98)}
#arGo{background:linear-gradient(110deg,#fff,#c7c7d0)!important;color:#101014!important}
#arGo.arRunning{background:linear-gradient(110deg,#ff8a8a,#c7c7d0)!important;color:#101014!important}
#arGo.arPaused{background:linear-gradient(110deg,#f5d76e,#fff)!important;color:#101014!important}
.arStatus{font-size:10px;color:#9a9aa3;text-align:center;padding:6px 2px 2px;line-height:1.4;min-height:14px}
.arBuf{font-size:9px;color:#7f7f88;text-align:center;padding:1px 0}
#arToggle{position:fixed;right:20px;bottom:25px;width:62px;height:62px;padding:4px;border:1px solid #000;border-radius:50%;background:#050505;z-index:2147483641;cursor:grab;display:flex;align-items:center;justify-content:center;isolation:isolate;touch-action:none;box-shadow:0 5px 20px #000b;user-select:none;-webkit-user-select:none;transition:transform .18s cubic-bezier(.2,.8,.2,1),filter .18s ease,box-shadow .18s ease}
#arToggle:before{content:"";position:absolute;inset:-4px;border-radius:50%;background:conic-gradient(#101010,#44444a,#bdbdc8,#fff,#65656d,#171717,#aaaab4,#101010);animation:arRingRotate 2.2s linear infinite;z-index:-1;pointer-events:none;transition:inset .25s ease,box-shadow .25s ease}
#arToggle:after{content:"";position:absolute;inset:0;border:1px solid #000;border-radius:50%;pointer-events:none}
#arToggle img{width:100%;height:100%;object-fit:cover;border-radius:50%;pointer-events:none;transition:filter .18s ease}
@keyframes arRingRotate{to{transform:rotate(360deg)}}
#arToggle.arAura{animation:arAura 3s ease-in-out infinite}
@keyframes arAura{0%,100%{box-shadow:0 0 7px #ffffff18,0 8px 25px #000b}50%{box-shadow:0 0 18px #ffffff50,0 0 30px #ffffff16,0 8px 25px #000b}}
#arToggle.arPressed{transform:scale(.88);filter:brightness(1.5);box-shadow:0 0 12px #fff,0 0 28px #ffffff70,0 8px 25px #000b}
#arToggle.arPressed img{filter:brightness(1.25)}
#arToggle.arReleased{transform:scale(1.06)}
#arToggle.arWorking:before{inset:-8px;background:conic-gradient(#003b19,#006b2b,#00a83b,#39ff78,#008f35,#004d20,#20e85b,#003b19);animation:arRingRotate .8s linear infinite;box-shadow:0 0 8px #00ff5570,0 0 18px #00ff5545}
#arToggle.arWorking{animation:arWorkingPulse .7s ease-in-out infinite alternate}
@keyframes arWorkingPulse{from{filter:brightness(1);transform:scale(1)}to{filter:brightness(1.2);transform:scale(1.025)}}
#arToggle.arOk:before{background:conic-gradient(#003b19,#00ff70,#b0ffc9,#00a83b,#003b19);box-shadow:0 0 12px #00ff7070}
#arToggle.arErr:before{background:conic-gradient(#450000,#ff4545,#ffaaaa,#a00000,#450000);box-shadow:0 0 12px #ff454570}
#arToggle:not(.arWorking):before{inset:-4px;box-shadow:none}
#arNotify{position:fixed;top:22px;left:50%;transform:translateX(-50%) translateY(-20px);background:rgba(18,18,21,.97);color:#fff;padding:9px 16px;border:1px solid #ffffff30;border-radius:10px;font-family:"Trebuchet MS",Arial,sans-serif;font-weight:bold;font-size:12px;z-index:2147483642;opacity:0;transition:opacity .3s,transform .35s;box-shadow:0 6px 20px #0008;pointer-events:none;max-width:85vw;text-align:center;overflow-wrap:anywhere}
@media(max-width:360px){#arFloat{padding:10px}#arHead{font-size:13px}}
  `;
  document.head.appendChild(style);

  // ================= HTML =================
  const gui = document.createElement('div');
  gui.id = 'arFloat';
  gui.innerHTML = `
<div id="arHead">
    <span id="arDragHandle">LEIAWARE</span>
    <button id="arEditApi" type="button" title="Configurar API (atalho: K)">API</button>
</div>
<div id="arLine"></div>

<label class="arToggleRow" id="arRowA"><input type="checkbox" id="arAutoAnswer"><span>AUTO ANSWER</span></label>
<label class="arToggleRow" id="arRowP"><input type="checkbox" id="arAutoPage"><span>AUTO NEXT PAGE</span></label>
<label class="arToggleRow" id="arRowT"><input type="checkbox" id="arTimerBypass"><span>TIMER BYPASS</span></label>

<span class="arLabel">TEMPO POR PAGINA (S)</span>
<input id="arTempo" type="number" value="1800" min="1">

<button id="arGo" class="arAction" type="button">INICIAR</button>
<div class="arStatus" id="arStatus">Pronto</div>
<div class="arBuf" id="arBuf">0 paginas</div>
  `;
  document.body.appendChild(gui);

  const toggle = document.createElement('button');
  toggle.id = 'arToggle';
  toggle.type = 'button';
  toggle.setAttribute('aria-label', 'Abrir ou minimizar LeiaWare');
  toggle.innerHTML = `<img src="${ICONE}" alt="">`;
  toggle.classList.add('arAura');
  document.body.appendChild(toggle);

  const notifyBox = document.createElement('div');
  notifyBox.id = 'arNotify';
  document.body.appendChild(notifyBox);

  // ---------- Notify ----------
  function notify(msg, ms = 2200) {
    notifyBox.textContent = msg;
    notifyBox.style.opacity = '1';
    notifyBox.style.transform = 'translateX(-50%) translateY(0)';
    clearTimeout(notifyTimer);
    notifyTimer = setTimeout(() => {
      notifyBox.style.opacity = '0';
      notifyBox.style.transform = 'translateX(-50%) translateY(-20px)';
    }, ms);
  }

  const status = t => { $('arStatus').textContent = t; };
  const refreshBuf = () => $('arBuf').textContent = buffer.length + ' paginas';

  // ---------- API Key ----------
  function pedirChave() {
    const v = prompt('Cole sua chave da OpenRouter (sk-or-v1-...):', apiKey);
    if (v && v.trim()) {
      apiKey = v.trim();
      localStorage.setItem('__arKey', apiKey);
      notify('API Key salva.');
      status('Chave salva');
    }
  }
  $('arEditApi').addEventListener('pointerdown', e => e.stopPropagation());
  $('arEditApi').onclick = e => { e.stopPropagation(); pedirChave(); };

  // ---------- Toggles ----------
  function bindToggle(rowId, inputId, onChange) {
    const row = $(rowId), inp = $(inputId);
    row.addEventListener('click', e => {
      if (e.target !== inp) inp.checked = !inp.checked;
      row.classList.toggle('arOn', inp.checked);
      onChange(inp.checked);
    });
  }
  bindToggle('arRowA', 'arAutoAnswer', v => { autoAnswer = v; status('Auto Answer: ' + (v ? 'ON' : 'OFF')); });
  bindToggle('arRowP', 'arAutoPage',   v => { autoNextPage = v; status('Auto Next Page: ' + (v ? 'ON' : 'OFF')); });
  bindToggle('arRowT', 'arTimerBypass', v => {
    timerBypass = v;
    if (v) { iniciarBypass(); status('Timer Bypass: ON'); }
    else { if (bypassInterval) { clearInterval(bypassInterval); bypassInterval = null; } status('Timer Bypass: OFF'); }
  });

  $('arTempo').onchange = e => tempoPag = parseInt(e.target.value) || 1800;

  // ---------- Botão Iniciar/Pausar ----------
  const btnGo = $('arGo');

  function atualizarBotao() {
    if (rodando) {
      btnGo.textContent = 'PAUSAR';
      btnGo.classList.add('arRunning');
      btnGo.classList.remove('arPaused');
    } else if (timerPage || timerAnswer || bypassInterval) {
      btnGo.textContent = 'RETOMAR';
      btnGo.classList.add('arPaused');
      btnGo.classList.remove('arRunning');
    } else {
      btnGo.textContent = 'INICIAR';
      btnGo.classList.remove('arRunning', 'arPaused');
    }
  }

  function pausarTudo() {
    if (timerAnswer) { clearInterval(timerAnswer); timerAnswer = null; }
    if (timerPage) { clearInterval(timerPage); timerPage = null; }
    if (bypassInterval) { clearInterval(bypassInterval); bypassInterval = null; }
    rodando = false;
    atualizarBotao();
  }

  function iniciarTudo() {
    if (!apiKey) { notify('Configure a API primeiro'); pedirChave(); return; }
    rodando = true;
    lockAte = 0;
    if (autoAnswer && !timerAnswer) timerAnswer = setInterval(loopAnswer, 2000);
    if (autoNextPage && !timerPage) timerPage = setInterval(loopPage, 2000);
    if (timerBypass && !bypassInterval) iniciarBypass();
    atualizarBotao();
  }

  btnGo.onclick = () => {
    if (rodando) { pausarTudo(); status('Pausado'); notify('Pausado.'); }
    else { iniciarTudo(); status('Rodando'); notify('Rodando.'); }
  };

  // ---------- Helpers ----------
  const naTela = (el) => {
    if (!el) return false;
    const r = el.getBoundingClientRect();
    return r.width > 0 && r.height > 0;
  };
  const temPergunta = () => !!document.querySelector('.question-quiz-text.ng-binding');

  function temBotaoPergunta() {
    return [...document.querySelectorAll('button[aria-label="Pergunta"]')].some(naTela);
  }

  // ---------- Leitura ----------
  function lerPagina() {
    if (temPergunta()) return null;
    const c = document.body.cloneNode(true);
    c.querySelectorAll('button,input,select,md-icon,svg,md-dialog,md-backdrop,#arFloat,#arToggle,#arNotify,' +
      '[class*="controls"],[class*="toolbar"],[class*="overlay"],[class*="header"],' +
      '[class*="footer"],[class*="sidebar"],[class*="tts"]').forEach(e => e.remove());
    return (c.innerText || '').split('\n').map(s => s.trim()).filter(Boolean)
      .filter(l => !/^\d+%?$/.test(l))
      .filter(l => !/^\d+x$/.test(l))
      .filter(l => !/páginas? para terminar/i.test(l))
      .filter(l => l.length > 2)
      .join('\n').trim();
  }

  function capturar() {
    const t = lerPagina();
    if (!t || t.length < 40 || t === ultimaPagina) return;
    ultimaPagina = t;
    buffer.push(t.slice(0, MAX_CHARS));
    while (buffer.length > MAX_PAGINAS) buffer.shift();
    refreshBuf();
  }

  // ---------- OpenRouter ----------
  async function chamarIA(pergunta, opcoes) {
    const ctx = buffer.length ? 'Contexto:\n"""\n' + buffer.join('\n---\n') + '\n"""\n\n' : '';
    const prompt = `${ctx}Pergunta: ${pergunta}\n\nOpções:\n${opcoes.map((o, i) =>
      String.fromCharCode(65 + i) + ') ' + o).join('\n')}\n\nResponda APENAS com a letra (A-E).`;

    const res = await fetch('https://openrouter.ai/api/v1/chat/completions', {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + apiKey, 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: MODELO, temperature: 0,
        messages: [
          { role: 'system', content: 'Responda só a letra correta (A-E).' },
          { role: 'user', content: prompt }
        ]
      })
    });
    if (!res.ok) throw new Error(res.status);
    const data = await res.json();
    const txt = data?.choices?.[0]?.message?.content || '';
    return txt.match(/[A-E]/i)?.[0]?.toUpperCase() || null;
  }

  // ---------- Quiz ----------
  function marcar(letra) {
    const i = { A: 0, B: 1, C: 2, D: 3, E: 4 }[letra];
    if (i === undefined) return false;
    const r = [...document.querySelectorAll('md-radio-button.choice-radio-button')].filter(naTela);
    const o = [...document.querySelectorAll('.choice-student.choice-new-styles__answer')].filter(naTela);
    if (r[i]) r[i].click();
    if (o[i]) o[i].click();
    return !!(r[i] || o[i]);
  }

  function clicarQuiz() {
    return new Promise(resolve => {
      const tentar = () => {
        const c = document.querySelector('md-dialog-actions.quiz-dialog-buttons');
        if (!c) return false;
        const fin = c.querySelector('button[ng-click="finish()"]');
        if (fin && fin.offsetParent && !fin.disabled) {
          fin.click();
          const obs = new MutationObserver((_, o) => {
            const env = c.querySelector('button[ng-click="sendAnswer()"]');
            if (env && env.offsetParent && !env.disabled) {
              env.click(); o.disconnect();
              setTimeout(() => { fechar(); resolve(true); }, 400);
            }
          });
          obs.observe(c, { childList: true, subtree: true });
          setTimeout(() => { obs.disconnect(); fechar(); resolve(true); }, 5000);
          return true;
        }
        const nx = c.querySelector('button[ng-click="next()"]');
        if (nx && nx.offsetParent && !nx.disabled) { nx.click(); resolve(true); return true; }
        return false;
      };
      if (tentar()) return;
      const obs = new MutationObserver(() => { if (tentar()) obs.disconnect(); });
      obs.observe(document.body, { childList: true, subtree: true });
      setTimeout(() => { obs.disconnect(); resolve(false); }, 5000);
    });
  }

  function fechar() {
    const tentar = () => {
      const b = document.querySelector('md-toolbar button.md-icon-button[ng-click="close()"]');
      if (b && b.offsetParent && !b.disabled) { b.click(); return true; }
      return false;
    };
    if (tentar()) return;
    const obs = new MutationObserver(() => { if (tentar()) obs.disconnect(); });
    obs.observe(document.body, { childList: true, subtree: true });
    setTimeout(() => obs.disconnect(), 5000);
  }

  // ---------- Timer Bypass ----------
  function acharTimers() {
    const els = [];
    const sels = ['[id*="timer"]','[class*="timer"]','[id*="time"]','[class*="time"]',
      '[id*="counter"]','[class*="counter"]','[id*="clock"]','[class*="clock"]'];
    sels.forEach(s => {
      try {
        document.querySelectorAll(s).forEach(el => {
          if (el.textContent && /\d{1,2}:\d{2}/.test(el.textContent)) els.push(el);
        });
      } catch (e) {}
    });
    document.querySelectorAll('*').forEach(el => {
      if (el.textContent && /^\d{1,3}:\d{2}$/.test(el.textContent.trim()) && !els.includes(el))
        els.push(el);
    });
    return els;
  }
  const paraSeg = s => {
    const p = s.split(':');
    return p.length === 2 ? +p[0] * 60 + +p[1]
         : p.length === 3 ? +p[0] * 3600 + +p[1] * 60 + +p[2] : 0;
  };
  const format = s => Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');

  function iniciarBypass() {
    if (!timerBypass) return;
    const els = acharTimers();
    if (!els.length) { status('Sem timer visivel'); return; }
    tempoOriginal = paraSeg(els[0].textContent.trim());
    inicioBypass = Date.now();
    if (bypassInterval) clearInterval(bypassInterval);
    bypassInterval = setInterval(() => {
      if (!timerBypass || !rodando) return;
      const real = Math.floor((Date.now() - inicioBypass) / 1000);
      const novo = Math.max(0, tempoOriginal - real);
      acharTimers().forEach(el => { el.textContent = format(novo); });
      try { document.dispatchEvent(new Event('mousemove', { bubbles: false })); } catch (e) {}
      if (novo <= 0) { clearInterval(bypassInterval); bypassInterval = null; }
    }, 1000);
  }

  // ---------- Loops ----------
  async function loopAnswer() {
    if (!rodando || !autoAnswer || processando || !temPergunta()) return;

    const pEl = document.querySelector('.question-quiz-text.ng-binding');
    const pergunta = (pEl.innerText || '').trim();
    const chave = hash(pergunta);

    if (respondidas.has(chave)) {
      status('Ja respondida, fechando...');
      lockAte = Date.now() + 4000;
      fechar();
      return;
    }

    processando = true;
    lockAte = Date.now() + 30000;
    toggle.classList.add('arWorking');

    try {
      const opcoes = [...document.querySelectorAll('.choice-student.choice-new-styles__answer')]
        .filter(naTela).map(e => e.innerText.trim()).filter(Boolean);
      if (!pergunta || !opcoes.length) return;

      status('Pensando...');
      const letra = await chamarIA(pergunta, opcoes);
      if (!letra) { status('IA falhou'); toggle.classList.add('arErr'); return; }

      status('OK: ' + letra);
      if (marcar(letra)) {
        await wait(1000);
        await clicarQuiz();
        await wait(2000);
        respondidas.add(chave);
      }
      toggle.classList.add('arOk');
    } catch (e) {
      console.error(e);
      status('Erro: ' + e.message);
      toggle.classList.add('arErr');
    } finally {
      processando = false;
      lockAte = Date.now() + 8000;
      toggle.classList.remove('arWorking');
      setTimeout(() => toggle.classList.remove('arOk', 'arErr'), 2600);
    }
  }

  function loopPage() {
    if (!rodando || !autoNextPage) return;
    if (processando) return;

    if (temPergunta()) {
      const pEl = document.querySelector('.question-quiz-text.ng-binding');
      const chave = hash((pEl.innerText || '').trim());
      if (respondidas.has(chave)) {
        fechar();
        lockAte = Date.now() + 4000;
      }
      return;
    }

    if (Date.now() < lockAte) return;

    if (temBotaoPergunta()) {
      const btn = [...document.querySelectorAll('button[aria-label="Pergunta"]')].find(naTela);
      if (btn) {
        btn.click();
        status('Abrindo pergunta...');
        lockAte = Date.now() + 6000;
        return;
      }
    }

    capturar();

    try {
      if (typeof ReadiumSDK !== 'undefined' && ReadiumSDK.reader) {
        const info = ReadiumSDK.reader.getPaginationInfo();
        if (!info || typeof info.canGoRight !== 'function' || info.canGoRight()) {
          ReadiumSDK.reader.openPageRight();
          status('Pagina');
          lockAte = Date.now() + 2500;
        }
      }
    } catch (e) {}
  }

  // ---------- Ícone ----------
  function setMinimized(v) {
    minimized = v;
    gui.classList.toggle('arMini', v);
  }

  let iconDrag = null, iconMoved = false;
  toggle.addEventListener('pointerdown', e => {
    if (e.button !== undefined && e.button !== 0) return;
    const rect = toggle.getBoundingClientRect();
    iconDrag = { id: e.pointerId, startX: e.clientX, startY: e.clientY,
      offsetX: e.clientX - rect.left, offsetY: e.clientY - rect.top };
    iconMoved = false;
    toggle.classList.add('arPressed');
    toggle.classList.remove('arReleased');
    try { toggle.setPointerCapture(e.pointerId); } catch {}
    e.preventDefault();
  });
  toggle.addEventListener('pointermove', e => {
    if (!iconDrag || e.pointerId !== iconDrag.id) return;
    const dx = e.clientX - iconDrag.startX;
    const dy = e.clientY - iconDrag.startY;
    if (Math.abs(dx) > 7 || Math.abs(dy) > 7) iconMoved = true;
    if (!iconMoved) return;
    const x = Math.max(0, Math.min(innerWidth - toggle.offsetWidth, e.clientX - iconDrag.offsetX));
    const y = Math.max(0, Math.min(innerHeight - toggle.offsetHeight, e.clientY - iconDrag.offsetY));
    toggle.style.left = x + 'px';
    toggle.style.top = y + 'px';
    toggle.style.right = 'auto';
    toggle.style.bottom = 'auto';
  });
  toggle.addEventListener('pointerup', e => {
    if (!iconDrag || e.pointerId !== iconDrag.id) return;
    const wasMoved = iconMoved;
    iconDrag = null; iconMoved = false;
    toggle.classList.remove('arPressed');
    toggle.classList.add('arReleased');
    requestAnimationFrame(() => requestAnimationFrame(() => toggle.classList.remove('arReleased')));
    if (!wasMoved) setMinimized(!minimized);
  });
  toggle.addEventListener('pointercancel', () => {
    iconDrag = null; iconMoved = false;
    toggle.classList.remove('arPressed', 'arReleased');
  });
  toggle.addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); });

  // ---------- Arrastar painel ----------
  let panelDrag = null;
  $('arDragHandle').addEventListener('pointerdown', e => {
    const rect = gui.getBoundingClientRect();
    panelDrag = { id: e.pointerId,
      offsetX: e.clientX - rect.left, offsetY: e.clientY - rect.top };
    try { $('arDragHandle').setPointerCapture(e.pointerId); } catch {}
    e.preventDefault(); e.stopPropagation();
  });
  $('arDragHandle').addEventListener('pointermove', e => {
    if (!panelDrag || e.pointerId !== panelDrag.id) return;
    const x = Math.max(0, Math.min(innerWidth - gui.offsetWidth, e.clientX - panelDrag.offsetX));
    const y = Math.max(0, Math.min(innerHeight - gui.offsetHeight, e.clientY - panelDrag.offsetY));
    gui.style.left = x + 'px';
    gui.style.top = y + 'px';
    gui.style.right = 'auto';
    gui.style.bottom = 'auto';
  });
  const finishPanel = e => { if (panelDrag && e.pointerId === panelDrag.id) panelDrag = null; };
  $('arDragHandle').addEventListener('pointerup', finishPanel);
  $('arDragHandle').addEventListener('pointercancel', finishPanel);

  // ---------- Atalhos ----------
  function toggleHiddenMode() {
    hidden = !hidden;
    gui.style.display = hidden ? 'none' : '';
    toggle.style.display = hidden ? 'none' : '';
    notifyBox.style.display = hidden ? 'none' : '';
  }

  document.addEventListener('keydown', e => {
    const tag = (e.target.tagName || '').toLowerCase();
    const digitando = tag === 'input' || tag === 'textarea' || e.target.isContentEditable;

    if (e.key === 'Escape') setMinimized(!minimized);

    if (e.key === 'Alt' && !e.repeat) { e.preventDefault(); toggleHiddenMode(); }

    if (e.altKey && e.key.toLowerCase() === 'q') {
      e.preventDefault();
      btnGo.click();
    }

    if (!digitando && !e.altKey && !e.ctrlKey && !e.metaKey && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      pedirChave();
    }
  });

  document.addEventListener('mousedown', e => {
    if (e.button === 1) { e.preventDefault(); toggleHiddenMode(); }
  });

  window.addEventListener('resize', () => {
    const r = toggle.getBoundingClientRect();
    if (r.right > innerWidth) {
      toggle.style.left = Math.max(0, innerWidth - toggle.offsetWidth) + 'px';
      toggle.style.right = 'auto';
    }
    if (r.bottom > innerHeight) {
      toggle.style.top = Math.max(0, innerHeight - toggle.offsetHeight) + 'px';
      toggle.style.bottom = 'auto';
    }
  });

  status('Pronto');
  refreshBuf();
  notify('LeiaWare carregada!');
  console.log('[LeiaWare] Pronto.');
})();