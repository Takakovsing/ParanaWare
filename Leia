    if (timerBypass && !timerByp) iniciarBypass();
  };

  // ---------------- Helpers ----------------
  const naTela = (el) => {
    if (!el) return false;
    const r = el.getBoundingClientRect();
    return r.width > 0 && r.height > 0;
  };
  const esperar = (ms) => new Promise(r => setTimeout(r, ms));
  const temPergunta = () => !!document.querySelector('.question-quiz-text.ng-binding');

  // ---------------- Leitura ----------------
  function lerPagina() {
    if (temPergunta()) return null;
    const c = document.body.cloneNode(true);
    c.querySelectorAll('button,input,select,md-icon,svg,md-dialog,md-backdrop,#arBox,' +
      '[class*="controls"],[class*="toolbar"],[class*="overlay"],[class*="header"],' +
      '[class*="footer"],[class*="sidebar"],[class*="tts"]').forEach(e => e.remove());
    return (c.innerText || '').split('\n').map(s => s.trim()).filter(Boolean)
      .filter(l => !/^\d+%?$/.test(l))
      .filter(l => !/^\d+x$/.test(l))
      .filter(l => !/páginas? para terminar/i.test(l))
      .filter(l => l.length > 2)
      .join('\n').trim();
  }

  function capturar() {
    const t = lerPagina();
    if (!t || t.length < 40 || t === ultimaPagina) return;
    ultimaPagina = t;
    buffer.push(t.slice(0, MAX_CHARS));
    while (buffer.length > MAX_PAGINAS) buffer.shift();
    refreshBuf();
  }

  // ---------------- IA ----------------
  async function chamarIA(pergunta, opcoes) {
    const ctx = buffer.length ? 'Contexto:\n"""\n' + buffer.join('\n---\n') + '\n"""\n\n' : '';
    const prompt = `${ctx}Pergunta: ${pergunta}\n\nOpções:\n${opcoes.map((o, i) =>
      String.fromCharCode(65 + i) + ') ' + o).join('\n')}\n\nResponda APENAS com a letra (A-E).`;

    const res = await fetch('https://openrouter.ai/api/v1/chat/completions', {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + CHAVE, 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: MODELO, temperature: 0,
        messages: [
          { role: 'system', content: 'Responda só a letra correta (A-E).' },
          { role: 'user', content: prompt }
        ]
      })
    });
    if (!res.ok) throw new Error(res.status);
    const data = await res.json();
    const txt = data?.choices?.[0]?.message?.content || '';
    return txt.match(/[A-E]/i)?.[0]?.toUpperCase() || null;
  }

  // ---------------- Quiz ----------------
  function marcar(letra) {
    const i = { A: 0, B: 1, C: 2, D: 3, E: 4 }[letra];
    if (i === undefined) return false;
    const r = [...document.querySelectorAll('md-radio-button.choice-radio-button')].filter(naTela);
    const o = [...document.querySelectorAll('.choice-student.choice-new-styles__answer')].filter(naTela);
    if (r[i]) r[i].click();
    if (o[i]) o[i].click();
    return !!(r[i] || o[i]);
  }

  function clicarQuiz() {
    return new Promise((resolve) => {
      const tentar = () => {
        const c = document.querySelector('md-dialog-actions.quiz-dialog-buttons');
        if (!c) return false;
        const fin = c.querySelector('button[ng-click="finish()"]');
        if (fin && fin.offsetParent && !fin.disabled) {
          fin.click();
          const obs = new MutationObserver((_, o) => {
            const env = c.querySelector('button[ng-click="sendAnswer()"]');
            if (env && env.offsetParent && !env.disabled) {
              env.click(); o.disconnect();
              setTimeout(() => { fechar(); resolve(true); }, 400);
            }
          });
          obs.observe(c, { childList: true, subtree: true });
          setTimeout(() => { obs.disconnect(); fechar(); resolve(true); }, 5000);
          return true;
        }
        const nx = c.querySelector('button[ng-click="next()"]');
        if (nx && nx.offsetParent && !nx.disabled) { nx.click(); resolve(true); return true; }
        return false;
      };
      if (tentar()) return;
      const obs = new MutationObserver(() => { if (tentar()) obs.disconnect(); });
      obs.observe(document.body, { childList: true, subtree: true });
      setTimeout(() => { obs.disconnect(); resolve(false); }, 5000);
    });
  }

  function fechar() {
    const tentar = () => {
      const b = document.querySelector('md-toolbar button.md-icon-button[ng-click="close()"]');
      if (b && b.offsetParent && !b.disabled) { b.click(); return true; }
      return false;
    };
    if (tentar()) return;
    const obs = new MutationObserver(() => { if (tentar()) obs.disconnect(); });
    obs.observe(document.body, { childList: true, subtree: true });
    setTimeout(() => obs.disconnect(), 5000);
  }

  // ---------------- Bypass ----------------
  function acharTimers() {
    const els = [];
