// ============ CONFIG ============
const SEGUNDOS_PAGINA = 5;
const AUTOSUBMIT      = true;
const DELAY_CLIQUE    = 1500;
const TIMEOUT_QUESTAO = 60000;
const ESPERA_POS_Q    = 2500;

// Lista de modelos: o primeiro é o roteador (mais seguro).
// Se falhar, o script tenta os próximos automaticamente.
const MODELOS = [
    'openrouter/free',                        // roteador automático (recomendado)
    'nvidia/nemotron-3-super-120b-a12b:free',  // bom em raciocínio
    'google/gemma-4-26b-a4b-it:free',         // rápido e estável
    'openai/gpt-oss-120b:free'                // alternativa forte
];

// ============ OPENROUTER COM FALLBACK ============
async function perguntarIA(pergunta, opcoes) {
    const lista = opcoes.map((o, i) => `${i+1}. ${o}`).join('\n');
    const prompt = `Você responde questões de múltipla escolha em português.\n\nPERGUNTA:\n${pergunta}\n\nOPÇÕES:\n${lista}\n\nResponda APENAS com o número da opção correta. Sem texto extra.`;

    let ultimoErro = null;

    for (const modelo of MODELOS) {
        try {
            const r = await fetch('https://openrouter.ai/api/v1/chat/completions', {
                method: 'POST',
                headers: {
                    'Authorization': 'Bearer ' + API_KEY,
                    'Content-Type': 'application/json',
                    'HTTP-Referer': location.origin,
                    'X-Title': 'LeiaParana Auto Reader'
                },
                body: JSON.stringify({
                    model: modelo,
                    messages: [
                        { role: 'system', content: 'Responda apenas com um número.' },
                        { role: 'user', content: prompt }
                    ],
                    temperature: 0,
                    max_tokens: 20
                })
            });

            if (!r.ok) {
                const erroTxt = (await r.text()).slice(0, 120);
                ultimoErro = `${modelo} → ${r.status}: ${erroTxt}`;
                log(`⚠️ ${modelo} falhou (${r.status}). Tentando próximo...`);
                continue; // tenta o próximo modelo
            }

            const data = await r.json();
            const txt = (data?.choices?.[0]?.message?.content || '').trim();
            const num = parseInt(txt.replace(/\D/g, ''), 10);
            log(`✅ Resposta via ${modelo}`);
            return { num, raw: txt, modelo };

        } catch (e) {
            ultimoErro = `${modelo} → ${e.message}`;
            log(`⚠️ ${modelo} erro de rede. Tentando próximo...`);
        }
    }

    throw new Error(`Todos os modelos falharam. Último erro: ${ultimoErro}`);
} 