(() => {
  if (window.__arInit) {
    console.log('[AR] Já está rodando.');
    return;
  }
  window.__arInit = true;

  // ===================== CONFIG =====================
  const CONFIG = {
    intervaloMs: 5000,
    apiKey: 'COLE_SUA_CHAVE_AQUI',
    modelo: 'openai/gpt-4o-mini'
  };
  // ==================================================

  const respondidas = new Set();
  let ocupado = false;
  let ligado = false;
  let timer = null;

  // ---------- helpers ----------
  const visivel = (el) => {
    if (!el) return false;
    const r = el.getBoundingClientRect();
    if (!r.width || !r.height) return false;
    const s = getComputedStyle(el);
    return s.display !== 'none' && s.visibility !== 'hidden';
  };

  const normalizar = (s) => s
    .toLowerCase()
    .replace(/[“”"'`´]/g, '')
    .replace(/\s+/g, ' ')
    .trim();

  // ---------- IA ----------
  async function perguntarIA(pergunta, opcoes) {
    const prompt =
      'Pergunta: ' + pergunta + '\n\n' +
      'Opções:\n' + opcoes.map((o, i) => (i + 1) + '. ' + o).join('\n');

    const res = await fetch('https://openrouter.ai/api/v1/chat/completions', {
      method: 'POST',
      headers: {
        'Authorization': 'Bearer ' + CONFIG.apiKey,
        'Content-Type': 'application/json',
        'HTTP-Referer': location.origin,
        'X-Title': 'AutoReader'
      },
      body: JSON.stringify({
        model: CONFIG.modelo,
        temperature: 0,
        messages: [
          { role: 'system', content: 'Responda só com o texto exato de UMA alternativa, sem numeração, sem aspas, sem explicações.' },
          { role: 'user', content: prompt }
        ]
      })
    });

    if (!res.ok) throw new Error(res.status + ' ' + res.statusText);
    const data = await res.json();
    return (data.choices?.[0]?.message?.content || '').trim();
  }

  // ---------- detectar pergunta aberta ----------
  function detectarPergunta() {
    const radios = Array.from(document.querySelectorAll('md-radio-button.choice-radio-button'))
      .filter(visivel);
    if (!radios.length) return null;

    let container = radios[0];
    for (let i = 0; i < 12 && container; i++) {
      const t = container.innerText || '';
      if (/Tentativas|Terminar/i.test(t) && t.split('\n').length >= 4) break;
      container = container.parentElement;
    }
    if (!container) container = document.body;

    const linhas = (container.innerText || '')
      .split('\n').map(s => s.trim()).filter(Boolean);

    let qIdx = linhas.findIndex(l => /^\d+\.-/.test(l));
    if (qIdx < 0) {
      let melhor = -1, tam = 0;
      linhas.forEach((l, i) => {
        if (l.endsWith('?') && l.length > tam) { melhor = i; tam = l.length; }
      });
      qIdx = melhor;
    }
    if (qIdx < 0) return null;

    const pergunta = linhas[qIdx].replace(/^\d+\.-\s*/, '');
    const opcoes = [];
    for (let i = qIdx + 1; i < linhas.length; i++) {
      const l = linhas[i];
      if (/^(Tentativas|Terminar|Bloco|Teste)/i.test(l)) break;
      opcoes.push(l.replace(/^[“”"']+|[“”"']+$/g, '').trim());
    }

    const botaoTerminar = Array.from(container.querySelectorAll('button'))
      .find(b => /^\s*terminar\s*$/i.test(b.innerText || ''));

    return { pergunta, opcoes, radios, botaoTerminar };
  }

  // ---------- responder ----------
  async function responderPergunta() {
    const q = detectarPergunta();
    if (!q) return false;

    const chave = q.pergunta.slice(0, 120);
    if (respondidas.has(chave)) return true;

    status('🤔 Pensando...');

    try {
      const resposta = await perguntarIA(q.pergunta, q.opcoes);
      const alvo = normalizar(resposta);

      let idx = q.opcoes.findIndex(o => normalizar(o) === alvo);
      if (idx < 0) idx = q.opcoes.findIndex(o => normalizar(o).includes(alvo) || alvo.includes(normalizar(o)));
      if (idx < 0 && /^\d+$/.test(resposta.trim())) idx = parseInt(resposta.trim(), 10) - 1;

      if (idx < 0 || idx >= q.radios.length) {
        status('⚠️ Sem match');
        respondidas.add(chave);
        return true;
      }

      q.radios[idx].click();
      await new Promise(r => setTimeout(r, 700));

      const terminar = q.botaoTerminar
        || Array.from(document.querySelectorAll('button'))
             .find(b => /^\s*terminar\s*$/i.test(b.innerText || '') && visivel(b));

      if (terminar && !terminar.disabled) terminar.click();

      status('✅ ' + (idx + 1) + '/' + q.radios.length);
      respondidas.add(chave);
    } catch (e) {
      console.warn('[AR] Erro:', e);
      status('❌ ' + e.message);
      respondidas.add(chave);
    }
    return true;
  }

  // ---------- abrir modal pergunta ----------
  function abrirPergunta() {
    const btn = Array.from(document.querySelectorAll('button[aria-label="Pergunta"]'))
      .find(visivel);
    if (btn) { btn.click(); return true; }
    return false;
  }

  // ---------- próxima página ----------
  function virarPagina() {
    const btn =
      document.querySelector('#right-page-btn') ||
      document.querySelector('.page-switch-overlay-icon.embedded.next');

    if (btn && !btn.disabled) {
      btn.click();
      return true;
    }
    return false;
  }

  // ---------- loop ----------
  async function loop() {
    if (ocupado || !ligado) return;
    ocupado = true;
    try {
      if (await responderPergunta()) return;
      if (abrirPergunta()) return;
      if (virarPagina()) status('➡️ Página');
      else status('⏳ Aguardando');
    } catch (e) {
      console.warn('[AR] Loop erro:', e);
    } finally {
      ocupado = false;
    }
  }

  // ---------- UI ----------
  function status(txt) {
    const el = document.getElementById('__arStatus');
    if (el) el.textContent = txt;
  }

  function criarUI() {
    if (document.getElementById('__arBox')) return;

    const box = document.createElement('div');
    box.id = '__arBox';
    box.style.cssText = [
      'position:fixed',
      'top:10px',
      'right:10px',
      'z-index:999999',
      'background:#111',
      'color:#eee',
      'font:12px/1.4 system-ui,sans-serif',
      'padding:8px 10px',
      'border-radius:10px',
      'box-shadow:0 4px 14px rgba(0,0,0,.4)',
      'display:flex',
      'gap:8px',
      'align-items:center',
      'cursor:move',
      'user-select:none'
    ].join(';');

    box.innerHTML =
      '<button id="__arBtn" style="all:unset;padding:4px 10px;border-radius:6px;background:#0a0;color:#fff;font-weight:600;cursor:pointer">Iniciar</button>' +
      '<span id="__arStatus" style="opacity:.8">Pronto</span>' +
      '<button id="__arClose" style="all:unset;cursor:pointer;opacity:.5;padding:0 4px">✕</button>';

    document.body.appendChild(box);

    document.getElementById('__arBtn').onclick = () => {
      ligado = !ligado;
      const btn = document.getElementById('__arBtn');
      btn.textContent = ligado ? 'Parar' : 'Iniciar';
      btn.style.background = ligado ? '#c00' : '#0a0';

      if (ligado) {
        loop();
        if (timer) clearInterval(timer);
        timer = setInterval(loop, CONFIG.intervaloMs);
      } else {
        if (timer) clearInterval(timer);
        timer = null;
        status('Parado');
      }
    };

    document.getElementById('__arClose').onclick = () => {
      if (timer) clearInterval(timer);
      box.remove();
      window.__arInit = false;
      ligado = false;
      console.log('%c[AR] Removido.', 'color:#c00');
    };

    // arrastar a janelinha
    let dx = 0, dy = 0, arrastando = false;
    box.onmousedown = (e) => {
      if (e.target.tagName === 'BUTTON') return;
      arrastando = true;
      dx = e.clientX - box.offsetLeft;
      dy = e.clientY - box.offsetTop;
    };
    document.addEventListener('mousemove', (e) => {
      if (!arrastando) return;
      box.style.left = (e.clientX - dx) + 'px';
      box.style.top = (e.clientY - dy) + 'px';
      box.style.right = 'auto';
    });
    document.addEventListener('mouseup', () => { arrastando = false; });
  }

  // ---------- start ----------
  criarUI();
  console.log('%c[AR] Pronto. Clique em "Iniciar" na caixinha.', 'color:#0a0;font-weight:bold');
})();