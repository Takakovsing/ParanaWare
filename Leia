(async function autoReaderComIA() {
    if (window.__autoIA) { window.__autoIA.parar(); return; }

    // ============ CONFIG ============
    const SEGUNDOS_PAGINA = 5;
    const MODELO          = 'openrouter/free';
    const AUTOSUBMIT      = true;
    const DELAY_ANTES_CLIQUE = 300;
    const DELAY_POS_OPCAO    = 900;
    const DELAY_POS_TERMINAR = 1200;
    const TIMEOUT_QUESTAO    = 60000;
    const ESPERA_POS_Q       = 2500;

    let API_KEY = localStorage.getItem('__or_key');
    if (!API_KEY) {
        API_KEY = prompt('Cole sua chave da OpenRouter (sk-or-v1-...):');
        if (!API_KEY) return;
        localStorage.setItem('__or_key', API_KEY);
    }

    // ============ PAINEL ============
    const painel = document.createElement('div');
    painel.style.cssText = `
        position:fixed; bottom:20px; right:20px; z-index:2147483647;
        background:#1a1a1a; color:#fff; font:12px/1.45 system-ui,sans-serif;
        padding:14px 16px; border-radius:10px; max-width:340px;
        box-shadow:0 6px 25px rgba(0,0,0,.6); user-select:none;
    `;
    painel.innerHTML = `
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
            <span id="__dot" style="width:10px;height:10px;background:#4caf50;
                  border-radius:50%;animation:pulse 1s infinite;"></span>
            <strong id="__titulo">📖 Folheando</strong>
        </div>
        <div id="__contador" style="font-size:30px;font-weight:bold;text-align:center;
             color:#4caf50;margin:4px 0;font-variant-numeric:tabular-nums;">5</div>
        <div id="__status" style="color:#ccc;font-size:11px;
             white-space:pre-wrap;margin-bottom:8px;min-height:36px;">
             Páginas: <span id="__total" style="color:#fff;font-weight:bold;">0</span>
        </div>
        <div style="display:flex;gap:6px;margin-bottom:6px;">
            <button id="__btnRepetir" style="flex:2;background:#ff9800;color:#fff;
                border:0;padding:8px;border-radius:6px;font:bold 11px sans-serif;
                cursor:pointer;">🔄 PERGUNTAR DE NOVO</button>
            <button id="__btnKey" style="flex:1;background:#333;color:#fff;border:0;
                padding:8px 10px;border-radius:6px;font:bold 11px sans-serif;
                cursor:pointer;">🔑</button>
        </div>
        <button id="__btnParar" style="width:100%;background:#e91e63;color:#fff;
            border:0;padding:8px;border-radius:6px;font:bold 11px sans-serif;
            cursor:pointer;">⏹ PARAR</button>
        <style>
            @keyframes pulse{
                0%,100%{opacity:1;transform:scale(1)}
                50%{opacity:.4;transform:scale(1.3)}
            }
        </style>
    `;
    document.body.appendChild(painel);

    const elDot      = painel.querySelector('#__dot');
    const elTitulo   = painel.querySelector('#__titulo');
    const elContador = painel.querySelector('#__contador');
    const elTotal    = painel.querySelector('#__total');
    const elStatus   = painel.querySelector('#__status');
    const btnRepetir = painel.querySelector('#__btnRepetir');

    let contador = SEGUNDOS_PAGINA;
    let paginasViradas = 0;
    let modo = 'folheando';
    let ultimaQuestao = '';
    let inicioQuestao = 0;

    const sleep = ms => new Promise(r => setTimeout(r, ms));
    function log(txt) { console.log('[AutoIA]', txt); }

    function setModo(novo) {
        modo = novo;
        if (novo === 'folheando') {
            elTitulo.textContent = '📖 Folheando';
            elDot.style.background = '#4caf50';
            elDot.style.animation = 'pulse 1s infinite';
            elContador.style.color = '#4caf50';
            elContador.textContent = SEGUNDOS_PAGINA;
        } else if (novo === 'resolvendo') {
            elTitulo.textContent = '🧠 Resolvendo...';
            elDot.style.background = '#2196f3';
            elDot.style.animation = 'none';
            elContador.style.color = '#2196f3';
            elContador.textContent = '🤖';
        }
    }

    // ============ DETECÇÃO ============
    function acharBotaoTerminar() {
        for (const b of document.querySelectorAll('button')) {
            if (b.offsetParent === null) continue;
            if (/^terminar$/i.test((b.textContent || '').trim())) return b;
        }
        return null;
    }

    function acharContainerQuestao() {
        const btnT = acharBotaoTerminar();
        if (!btnT) return null;
        let c = btnT.parentElement, i = 0;
        while (c && c !== document.body && i < 15) {
            const t = (c.innerText || '').trim();
            if (/tentativas\s+restantes/i.test(t) && t.length > 60) return c;
            c = c.parentElement; i++;
        }
        return null;
    }

    function extrairQuestao(container) {
        const linhas = (container.innerText || '')
            .split('\n').map(s => s.trim()).filter(Boolean)
            .filter(s =>
                !/^tentativas\s+restantes/i.test(s) &&
                !/^terminar$/i.test(s) &&
                !/^bloco\s*\d+/i.test(s)
            );
        let pergunta = linhas.find(s => s.includes('?') && s.length > 20) || linhas[0];
        const idx = linhas.indexOf(pergunta);
        const opcoes = linhas.slice(idx + 1)
            .filter(s => s.length > 2 && s.length < 300)
            .slice(0, 8);
        return { pergunta, opcoes };
    }

    // ============ ENCONTRAR ELEMENTO DA OPÇÃO ============
    function acharElementoOpcao(texto, container) {
        if (!texto) return null;
        const alvo = texto.trim().toLowerCase();
        const abreviado = alvo.slice(0, 30);
        let melhor = null, melhorLen = Infinity;

        for (const el of container.querySelectorAll('*')) {
            // não descer muito fundo (evita pegar span de 1 letra)
            if (el.children.length > 4) continue;
            const t = (el.innerText || '').trim().toLowerCase();
            if (!t || t.length < 3) continue;

            // match: exato OU contém o começo do texto da opção
            if (t === alvo || t.includes(abreviado)) {
                if (t.length < melhorLen) { melhor = el; melhorLen = t.length; }
            }
        }
        return melhor;
    }

    // Sobe até achar o container clicável da opção (radio, label, ng-click)
    function acharClicavel(el) {
        let c = el, up = 0;
        while (c && up < 10) {
            if (c.tagName === 'MD-RADIO-BUTTON' ||
                c.tagName === 'LABEL' ||
                c.tagName === 'BUTTON' ||
                c.tagName === 'INPUT') return c;
            if (c.hasAttribute && (
                c.hasAttribute('ng-click') ||
                c.hasAttribute('ng-model') ||
                c.getAttribute('role') === 'radio' ||
                c.classList?.contains('md-radio-button') ||
                c.classList?.contains('radio-button')
            )) return c;
            c = c.parentElement; up++;
        }
        return el; // fallback
    }

    // ============ CLICAR NA OPÇÃO (multi-estratégia) ============
    async function clicarOpcao(textoOpcao, container) {
        const alvo = acharElementoOpcao(textoOpcao, container);
        if (!alvo) { log('❌ Não achou elemento da opção'); return false; }

        const clicavel = acharClicavel(alvo);
        log(`Clicando em <${clicavel.tagName.toLowerCase()}>`);

        // Estratégia 1: clique normal
        try { clicavel.click(); } catch(_) {}
        await sleep(150);
        if (opcaoMarcada(clicavel, alvo)) { log('✅ Marcada (click)'); return true; }

        // Estratégia 2: eventos completos de mouse
        try {
            const r = clicavel.getBoundingClientRect();
            const x = r.left + r.width/2, y = r.top + r.height/2;
            ['mousedown','mouseup','click'].forEach(tipo => {
                clicavel.dispatchEvent(new MouseEvent(tipo, {
                    bubbles: true, cancelable: true, view: window,
                    clientX: x, clientY: y, button: 0
                }));
            });
        } catch(_) {}
        await sleep(150);
        if (opcaoMarcada(clicavel, alvo)) { log('✅ Marcada (mouse events)'); return true; }

        // Estratégia 3: chama ng-click via scope do Angular
        try {
            if (window.angular) {
                let s = angular.element(clicavel).scope();
                let n = 0;
                while (s && n < 10) {
                    if (s.$apply) {
                        s.$apply(() => {
                            if (typeof s.select === 'function') s.select();
                            else if (typeof s.click === 'function') s.click();
                            else if (typeof s.toggle === 'function') s.toggle();
                        });
                        break;
                    }
                    s = s.$parent; n++;
                }
            }
        } catch(_) {}
        await sleep(150);
        if (opcaoMarcada(clicavel, alvo)) { log('✅ Marcada (angular scope)'); return true; }

        // Estratégia 4: clica no input radio escondido dentro
        try {
            const radio = clicavel.querySelector('input[type="radio"]');
            if (radio) { radio.click(); radio.checked = true;
                radio.dispatchEvent(new Event('change', { bubbles: true }));
            }
        } catch(_) {}
        await sleep(150);
        if (opcaoMarcada(clicavel, alvo)) { log('✅ Marcada (input radio)'); return true; }

        log('⚠️ Não consegui confirmar marcação, mas enviei os cliques');
        return true; // tenta seguir mesmo assim
    }

    // Verifica se a opção está visualmente marcada
    function opcaoMarcada(clicavel, alvo) {
        try {
            // procura por elementos próximos com aria-checked=true ou classe md-checked
            const wrapper = clicavel.closest('[role="radio"]') ||
                            clicavel.closest('md-radio-button') ||
                            clicavel.parentElement;
            if (wrapper) {
                if (wrapper.getAttribute('aria-checked') === 'true') return true;
                if (wrapper.classList?.contains('md-checked')) return true;
                const inner = wrapper.querySelector('[aria-checked="true"], .md-checked');
                if (inner) return true;
            }
            // qualquer radio visível marcado dentro do alvo
            if (alvo.querySelector('input[type="radio"]:checked')) return true;
        } catch(_) {}
        return false;
    }

    // ============ CLICAR EM TERMINAR ============
    async function clicarTerminar() {
        const btn = acharBotaoTerminar();
        if (!btn) { log('❌ TERMINAR não achado'); return false; }
        log('📤 Clicando em TERMINAR...');
        try { btn.click(); } catch(_) {}
        await sleep(200);
        // se ainda existir, tenta eventos de mouse
        if (document.contains(btn) && btn.offsetParent !== null) {
            ['mousedown','mouseup','click'].forEach(tipo => {
                btn.dispatchEvent(new MouseEvent(tipo, {
                    bubbles: true, cancelable: true, view: window
                }));
            });
        }
        return true;
    }

    // ============ OPENROUTER ============
    async function perguntarIA(pergunta, opcoes, tentativa = 1) {
        const lista = opcoes.map((o, i) => `${i+1}. ${o}`).join('\n');
        const variacoes = [
            'Responda APENAS com o número da opção correta. Sem texto extra.',
            'Analise com cuidado e responda APENAS com o número. Sem explicações.',
            'Pense passo a passo internamente e responda APENAS com o número.'
        ];
        const instrucao = variacoes[Math.min(tentativa - 1, variacoes.length - 1)];
        const prompt =
`Você responde questões de múltipla escolha em português.

PERGUNTA:
${pergunta}

OPÇÕES:
${lista}

${instrucao}`;

        const r = await fetch('https://openrouter.ai/api/v1/chat/completions', {
            method: 'POST',
            headers: {
                'Authorization': 'Bearer ' + API_KEY,
                'Content-Type': 'application/json',
                'HTTP-Referer': location.origin,
                'X-Title': 'LeiaParana Auto Reader'
            },
            body: JSON.stringify({
                model: MODELO,
                messages: [
                    { role: 'system', content: 'Responda apenas com um número.' },
                    { role: 'user', content: prompt }
                ],
                temperature: tentativa > 1 ? 0.3 : 0,
                max_tokens: 20
            })
        });
        if (!r.ok) {
            const erro = (await r.text()).slice(0, 180);
            throw new Error(`OpenRouter ${r.status}: ${erro}`);
        }
        const data = await r.json();
        const txt = (data?.choices?.[0]?.message?.content || '').trim();
        const num = parseInt(txt.replace(/\D/g, ''), 10);
        return { num, raw: txt, modelo: data?.model || MODELO };
    }

    // ============ RESOLVER QUESTÃO COMPLETA ============
    let tentativaAtual = 1;

    async function resolverQuestao(container, tentativa = 1) {
        setModo('resolvendo');
        try {
            const { pergunta, opcoes } = extrairQuestao(container);
            if (!pergunta || opcoes.length < 2) {
                elStatus.textContent = '❌ Não extraí a questão';
                return false;
            }

            elStatus.textContent = `🧠 (t.${tentativa}) "${pergunta.slice(0, 45)}..."`;
            const ia = await perguntarIA(pergunta, opcoes, tentativa);
            const idx = ia.num - 1;
            if (isNaN(idx) || idx < 0 || idx >= opcoes.length) {
                elStatus.textContent = `❌ IA respondeu "${ia.raw}"`;
                return false;
            }

            const textoOpcao = opcoes[idx];
            elStatus.textContent = `✅ (${ia.num}) ${textoOpcao.slice(0, 45)}`;
            log(`IA (${ia.modelo}) escolheu (${ia.num}): ${textoOpcao}`);

            await sleep(DELAY_ANTES_CLIQUE);
            const marcou = await clicarOpcao(textoOpcao, container);
            if (!marcou) {
                elStatus.textContent = '❌ Falha ao marcar opção';
                return false;
            }
            elStatus.textContent = '👆 Marcada. Enviando...';

            if (AUTOSUBMIT) {
                await sleep(DELAY_POS_OPCAO);
                const enviou = await clicarTerminar();
                if (enviou) {
                    await sleep(DELAY_POS_TERMINAR);
                    elStatus.textContent = `📤 Enviado (t.${tentativa})!`;
                } else {
                    elStatus.textContent = '⚠️ TERMINAR não achado';
                }
            }
            return true;
        } catch (e) {
            elStatus.textContent = '❌ ' + e.message.slice(0, 55);
            console.error(e);
            return false;
        }
    }

    // ============ LOOP ============
    let processandoQuestao = false;
    let pedidoRepetir = false;

    async function loopPrincipal() {
        while (modo !== 'parado') {
            const container = acharContainerQuestao();
            if (container && !processandoQuestao) {
                const textoAtual = (container.innerText || '').trim();
                if (textoAtual !== ultimaQuestao ||
                    Date.now() - inicioQuestao > TIMEOUT_QUESTAO ||
                    pedidoRepetir) {
                    ultimaQuestao = textoAtual;
                    inicioQuestao = Date.now();
                    processandoQuestao = true;
                    pedidoRepetir = false;
                    await resolverQuestao(container, tentativaAtual);
                    tentativaAtual = 1;
                    await sleep(ESPERA_POS_Q);
                    let t = 0;
                    while (acharContainerQuestao() && t < 20) { await sleep(500); t++; }
                    processandoQuestao = false;
                    ultimaQuestao = '';
                    setModo('folheando');
                    contador = SEGUNDOS_PAGINA;
                    continue;
                }
            }

            await sleep(1000);
            if (modo === 'parado') break;
            if (processandoQuestao) continue;

            contador--;
            elContador.textContent = contador;
            if (contador <= 0) {
                avancarPagina();
                paginasViradas++;
                elTotal.textContent = paginasViradas;
                contador = SEGUNDOS_PAGINA;
                elContador.textContent = contador;
            }
        }
    }

    function avancarPagina() {
        try {
            const alvo = document.querySelector('[ng-click*="goToNextPage"]')
                      || document.querySelector('.page-switch-overlay-icon.next');
            if (alvo && window.angular) {
                let s = angular.element(alvo).scope(), n = 0;
                while (s && typeof s.goToNextPage !== 'function' && n < 12) {
                    s = s.$parent; n++;
                }
                if (s && typeof s.goToNextPage === 'function') {
                    s.$apply(() => s.goToNextPage()); return;
                }
            }
        } catch (e) {}
        const btn = document.querySelector('.page-switch-overlay-icon.embedded.next');
        if (btn && btn.offsetParent !== null) { btn.click(); return; }
        document.dispatchEvent(new KeyboardEvent('keydown', {
            key:'ArrowRight', code:'ArrowRight', keyCode:39, which:39, bubbles:true
        }));
    }

    // ============ PARAR / BOTÕES ============
    function parar() {
        modo = 'parado';
        setTimeout(() => painel.remove(), 100);
        window.__autoIA = null;
    }
    painel.querySelector('#__btnParar').onclick = parar;
    painel.querySelector('#__btnKey').onclick = () => {
        const nova = prompt('Nova chave OpenRouter:', API_KEY);
        if (nova) { API_KEY = nova; localStorage.setItem('__or_key', nova); }
    };
    btnRepetir.onclick = () => {
        const container = acharContainerQuestao();
        if (!container) { elStatus.textContent = '⚠️ Nenhuma questão na tela'; return; }
        if (processandoQuestao) { elStatus.textContent = '⏳ Já resolvendo...'; return; }
        tentativaAtual++;
        pedidoRepetir = true;
        log(`🔄 Repetir (tentativa ${tentativaAtual})`);
    };

    window.__autoIA = { parar };
    console.log('[AutoIA] Ativo. Modelo:', MODELO);

    setModo('folheando');
    loopPrincipal();
})();