(async function autoReaderCompleto() {
    // ===================== SE JÁ RODANDO, PARA =====================
    if (window.__autoIA) { window.__autoIA.parar(); return; }

    // ===================== CONFIG =====================
    const SEGUNDOS_PAGINA        = 5;
    const RODADAS_VOTACAO        = 3;
    const TENTATIVAS_POR_MODELO  = 2;
    const DELAY_ANTES_CLIQUE     = 300;
    const DELAY_POS_OPCAO        = 900;
    const DELAY_POS_TERMINAR     = 1200;
    const TIMEOUT_QUESTAO        = 60000;
    const ESPERA_POS_Q           = 2500;
    const AUTOSUBMIT             = true;
    const ENVIAR_SEMPRE          = true;
    const VERIFICAR_ANTES_ENVIAR = true;
    const MAX_CHARS_CONTEXTO     = 12000;
    const MAX_PAGINAS_GUARDADAS  = 40;

    // Lista de modelos — tenta em ordem até um responder
    const MODELOS = [
        'openrouter/free',
        'meta-llama/llama-3.3-70b-instruct:free',
        'google/gemini-2.0-flash-exp:free',
        'qwen/qwen-2.5-72b-instruct:free',
        'mistralai/mistral-nemo:free',
        'microsoft/phi-3-medium-128k-instruct:free',
        'openchat/openchat-7b:free',
        'huggingfaceh4/zephyr-7b-beta:free'
    ];

    // ===================== API KEY =====================
    let API_KEY = localStorage.getItem('__or_key');
    if (!API_KEY) {
        API_KEY = prompt('Cole sua chave da OpenRouter (sk-or-v1-...):');
        if (!API_KEY) return;
        localStorage.setItem('__or_key', API_KEY);
    }

    // ===================== MEMÓRIA DE PÁGINAS =====================
    const memoria = { paginas: [], ultimoHash: '', charsTotal: 0 };

    function hashPagina(txt) {
        const t = txt.trim();
        return t.length + '|' + t.slice(0, 100) + '|' + t.slice(-100);
    }

    function capturarTextoPagina() {
        const clone = document.body.cloneNode(true);
        const alvo = clone.querySelector('.page-switch-overlay-icon.next')
                  || clone.querySelector('button[id="finish-btn"]');
        if (alvo) {
            let c = alvo, i = 0;
            while (c && i < 15) {
                const tt = (c.innerText || '').trim();
                if (/tentativas\s+restantes/i.test(tt) && tt.length > 60) {
                    c.remove(); break;
                }
                c = c.parentElement; i++;
            }
        }
        const txt = clone.innerText || '';
        return txt.split('\n').map(s => s.trim())
            .filter(s => s.length > 2 && s.length < 800)
            .filter(s =>
                !/^(tentativas|terminar|bloco|fim da|página para|as aventuras|animais inventores|teste)/i.test(s) &&
                !/^[\d\s%x]+$/.test(s) &&
                !/^\d+\.?\s*\d*\.\-/.test(s) &&
                !/^\d+$/.test(s)
            )
            .join('\n');
    }

    function guardarPaginaAtual() {
        const texto = capturarTextoPagina();
        if (!texto || texto.length < 20) return;
        const hash = hashPagina(texto);
        if (hash === memoria.ultimoHash) return;
        memoria.ultimoHash = hash;
        memoria.paginas.push(texto);
        memoria.charsTotal += texto.length;
        while (memoria.paginas.length > MAX_PAGINAS_GUARDADAS) {
            memoria.charsTotal -= memoria.paginas.shift().length;
        }
        log(`📚 Página guardada (${memoria.paginas.length} págs, ${memoria.charsTotal} chars)`);
    }

    function montarContexto() {
        if (memoria.paginas.length === 0) return '';
        const partes = [];
        let total = 0;
        for (let i = memoria.paginas.length - 1; i >= 0; i--) {
            const p = memoria.paginas[i];
            if (total + p.length > MAX_CHARS_CONTEXTO) break;
            partes.unshift(p);
            total += p.length;
        }
        return partes.join('\n\n---\n\n');
    }

    // ===================== PAINEL =====================
    const painel = document.createElement('div');
    painel.style.cssText = `
        position: fixed; bottom: 20px; right: 20px; z-index: 2147483647;
        background: #1a1a1a; color: #fff;
        font: 12px/1.45 system-ui, sans-serif;
        padding: 14px 16px; border-radius: 10px; max-width: 340px;
        box-shadow: 0 6px 25px rgba(0,0,0,.6); user-select: none;
    `;
    painel.innerHTML = `
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
            <span id="__dot" style="width:10px;height:10px;background:#4caf50;
                  border-radius:50%;animation:pulse 1s infinite;"></span>
            <strong id="__titulo">📖 Folheando</strong>
        </div>
        <div id="__contador" style="font-size:30px;font-weight:bold;text-align:center;
             color:#4caf50;margin:4px 0;">5</div>
        <div id="__status" style="color:#ccc;font-size:11px;
             white-space:pre-wrap;margin-bottom:8px;min-height:36px;">
            Páginas: <span id="__total">0</span> | Memória: <span id="__mem" style="color:#0f0;">0</span>
        </div>
        <div style="display:flex;gap:6px;margin-bottom:6px;">
            <button id="__btnRepetir" style="flex:2;background:#ff9800;color:#fff;
                border:0;padding:8px;border-radius:6px;font:bold 11px sans-serif;">🔄 DE NOVO</button>
            <button id="__btnMem" style="flex:1;background:#2196f3;color:#fff;border:0;
                padding:8px 10px;border-radius:6px;font:bold 11px sans-serif;">📚</button>
            <button id="__btnKey" style="flex:1;background:#333;color:#fff;border:0;
                padding:8px 10px;border-radius:6px;font:bold 11px sans-serif;">🔑</button>
        </div>
        <button id="__btnParar" style="width:100%;background:#e91e63;color:#fff;
            border:0;padding:8px;border-radius:6px;font:bold 11px sans-serif;">⏹ PARAR</button>
        <style>@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(1.3)}}</style>
    `;
    document.body.appendChild(painel);

    const elDot      = painel.querySelector('#__dot');
    const elTitulo   = painel.querySelector('#__titulo');
    const elContador = painel.querySelector('#__contador');
    const elTotal    = painel.querySelector('#__total');
    const elMem      = painel.querySelector('#__mem');
    const elStatus   = painel.querySelector('#__status');
    const btnRepetir = painel.querySelector('#__btnRepetir');

    let contador = SEGUNDOS_PAGINA, paginasViradas = 0, modo = 'folheando';
    let ultimaQuestao = '', inicioQuestao = 0, tentativaAtual = 1;
    let processandoQuestao = false, pedidoRepetir = false;

    const sleep = ms => new Promise(r => setTimeout(r, ms));
    const log = txt => console.log('[AutoIA]', txt);

    function atualizarMem() {
        elMem.textContent = memoria.charsTotal + 'c/' + memoria.paginas.length + 'p';
    }

    function setModo(novo) {
        modo = novo;
        if (novo === 'folheando') {
            elTitulo.textContent = '📖 Folheando';
            elDot.style.background = '#4caf50';
            elDot.style.animation = 'pulse 1s infinite';
            elContador.style.color = '#4caf50';
            elContador.textContent = SEGUNDOS_PAGINA;
        } else if (novo === 'resolvendo') {
            elTitulo.textContent = '🧠 Resolvendo...';
            elDot.style.background = '#2196f3';
            elDot.style.animation = 'none';
            elContador.style.color = '#2196f3';
            elContador.textContent = '🤖';
        } else if (novo === 'erro') {
            elTitulo.textContent = '❌ Erro';
            elDot.style.background = '#f44336';
            elDot.style.animation = 'none';
            elContador.style.color = '#f44336';
            elContador.textContent = '⚠';
        }
    }

    // ===================== DETECÇÃO =====================
    function acharBotaoTerminar() {
        for (const b of document.querySelectorAll('button')) {
            if (b.offsetParent === null) continue;
            if (/^terminar$/i.test((b.textContent || '').trim())) return b;
        }
        return null;
    }

    function acharContainerQuestao() {
        const btnT = acharBotaoTerminar();
        if (!btnT) return null;
        let c = btnT.parentElement, i = 0;
        while (c && c !== document.body && i < 15) {
            const t = (c.innerText || '').trim();
            if (/tentativas\s+restantes/i.test(t) && t.length > 60) return c;
            c = c.parentElement; i++;
        }
        return null;
    }

    function extrairQuestao(container) {
        const linhas = (container.innerText || '')
            .split('\n').map(s => s.trim()).filter(Boolean)
            .filter(s =>
                !/^tentativas\s+restantes/i.test(s) &&
                !/^terminar$/i.test(s) &&
                !/^bloco\s*\d+/i.test(s)
            );
        const pergunta = linhas.find(s => s.includes('?') && s.length > 20) || linhas[0];
        const idx = linhas.indexOf(pergunta);
        const opcoes = linhas.slice(idx + 1)
            .filter(s => s.length > 2 && s.length < 300)
            .slice(0, 8);
        return { pergunta, opcoes };
    }

    // ===================== RADIO: DETECÇÃO E CLIQUE =====================
    function qualEstaMarcado(container) {
        const radios = container.querySelectorAll(
            'md-radio-button, [role="radio"], .md-radio-button'
        );
        const marcados = [];
        radios.forEach((r) => {
            const txt = (r.innerText || '').trim().replace(/\s+/g, ' ');
            if (!txt) return;
            const checked =
                r.getAttribute('aria-checked') === 'true' ||
                (r.classList && r.classList.contains('md-checked')) ||
                (r.querySelector && r.querySelector('.md-checked')) ||
                (r.querySelector && r.querySelector('[aria-checked="true"]')) ||
                (r.querySelector && r.querySelector('input[type="radio"]:checked'));
            if (checked) marcados.push({ texto: txt, el: r });
        });
        return marcados;
    }

    function encontrarRadioPorTexto(textoOpcao, container) {
        const alvo = textoOpcao.trim().toLowerCase().replace(/\s+/g, ' ');
        const radios = container.querySelectorAll(
            'md-radio-button, [role="radio"], .md-radio-button'
        );

        for (const r of radios) {
            const t = (r.innerText || '').trim().toLowerCase().replace(/\s+/g, ' ');
            if (t === alvo) return r;
        }

        const prefixo = alvo.slice(0, 40);
        let melhor = null, melhorDelta = Infinity;
        for (const r of radios) {
            const t = (r.innerText || '').trim().toLowerCase().replace(/\s+/g, ' ');
            if (t.startsWith(prefixo)) {
                const delta = Math.abs(t.length - alvo.length);
                if (delta < melhorDelta) { melhor = r; melhorDelta = delta; }
            }
        }
        return melhor;
    }

    function bateComAlvo(textoMarcado, textoAlvo) {
        const a = textoMarcado.trim().toLowerCase().replace(/\s+/g, ' ');
        const b = textoAlvo.trim().toLowerCase().replace(/\s+/g, ' ');
        const prefixo = b.slice(0, 30);
        return a.startsWith(prefixo) || a === b;
    }

    async function clicarOpcao(textoOpcao, container) {
        const radio = encontrarRadioPorTexto(textoOpcao, container);
        if (!radio) { log('❌ Radio não encontrado'); return false; }

        const textoRadio = (radio.innerText || '').trim().replace(/\s+/g, ' ');
        log(`🎯 Alvo: "${textoRadio.slice(0, 50)}..."`);

        const outlineOrig = radio.style.outline;
        const bgOrig = radio.style.background;
        radio.style.outline = '3px solid #ffeb3b';
        radio.style.background = 'rgba(255,235,59,.25)';
        await sleep(500);

        let marcados = qualEstaMarcado(container);
        if (marcados.length > 0 && bateComAlvo(marcados[0].texto, textoOpcao)) {
            log('ℹ️ Já estava marcada');
            radio.style.outline = outlineOrig; radio.style.background = bgOrig;
            return true;
        }

        // Tentativa 1
        try { radio.click(); } catch(_) {}
        await sleep(300);
        marcados = qualEstaMarcado(container);
        if (marcados.length > 0 && bateComAlvo(marcados[0].texto, textoOpcao)) {
            log('✅ Marcada (click)');
            radio.style.outline = outlineOrig; radio.style.background = bgOrig;
            return true;
        }

        // Tentativa 2
        const inner = radio.querySelector('.md-container') || radio.querySelector('label') || radio.querySelector('span');
        if (inner) {
            try { inner.click(); } catch(_) {}
            await sleep(300);
            marcados = qualEstaMarcado(container);
            if (marcados.length > 0 && bateComAlvo(marcados[0].texto, textoOpcao)) {
                log('✅ Marcada (inner)');
                radio.style.outline = outlineOrig; radio.style.background = bgOrig;
                return true;
            }
        }

        // Tentativa 3
        try {
            const r = radio.getBoundingClientRect();
            const x = r.left + r.width/2, y = r.top + r.height/2;
            ['mousedown','mouseup','click'].forEach(tp => {
                radio.dispatchEvent(new MouseEvent(tp, {
                    bubbles: true, cancelable: true, view: window,
                    clientX: x, clientY: y, button: 0
                }));
            });
        } catch(_) {}
        await sleep(300);
        marcados = qualEstaMarcado(container);
        if (marcados.length > 0 && bateComAlvo(marcados[0].texto, textoOpcao)) {
            log('✅ Marcada (mouse)');
            radio.style.outline = outlineOrig; radio.style.background = bgOrig;
            return true;
        }

        // Tentativa 4
        try {
            if (window.angular) {
                let s = angular.element(radio).scope(), n = 0;
                while (s && n < 10) {
                    if (s.$apply) {
                        s.$apply(() => { if (typeof s.select === 'function') s.select(); });
                        break;
                    }
                    s = s.$parent; n++;
                }
            }
        } catch(_) {}
        await sleep(300);
        marcados = qualEstaMarcado(container);
        if (marcados.length > 0 && bateComAlvo(marcados[0].texto, textoOpcao)) {
            log('✅ Marcada (angular)');
            radio.style.outline = outlineOrig; radio.style.background = bgOrig;
            return true;
        }

        // Tentativa 5
        const inp = radio.querySelector('input[type="radio"]');
        if (inp) {
            try {
                inp.checked = true;
                inp.dispatchEvent(new Event('change', { bubbles: true }));
                inp.click();
            } catch(_) {}
            await sleep(300);
            marcados = qualEstaMarcado(container);
            if (marcados.length > 0 && bateComAlvo(marcados[0].texto, textoOpcao)) {
                log('✅ Marcada (input)');
                radio.style.outline = outlineOrig; radio.style.background = bgOrig;
                return true;
            }
        }

        radio.style.outline = outlineOrig;
        radio.style.background = bgOrig;
        marcados = qualEstaMarcado(container);
        if (marcados.length > 0) log(`❌ Marcou errada: "${marcados[0].texto.slice(0,50)}..."`);
        else log('❌ Nada marcado');
        return false;
    }

    async function clicarTerminar() {
        const btn = acharBotaoTerminar();
        if (!btn) { log('❌ TERMINAR não achado'); return false; }
        log('📤 TERMINAR');
        try { btn.click(); } catch(_) {}
        await sleep(200);
        if (document.contains(btn) && btn.offsetParent !== null) {
            ['mousedown','mouseup','click'].forEach(tp => {
                btn.dispatchEvent(new MouseEvent(tp, { bubbles: true, cancelable: true, view: window }));
            });
        }
        return true;
    }

    // ===================== IA =====================
    function detectarTipoQuestao(pergunta) {
        const p = pergunta.toLowerCase();
        if (/fato|opinião|opiniao|verdade|mentira|realidade|ficção/i.test(p)) return 'fato_opiniao';
        if (/significa|sentido|interpreta|infere|conclui/i.test(p)) return 'interpretacao';
        if (/sinônimo|antônimo|sinonimo|antonimo/i.test(p)) return 'sinonimo';
        if (/ortografia|escrita correta|grafia/i.test(p)) return 'ortografia';
        if (/classe gramatical|substantivo|adjetivo|verbo|advérbio/i.test(p)) return 'gramatica';
        if (/pontuação|vírgula|interrogação/i.test(p)) return 'pontuacao';
        return 'geral';
    }

    function montarPrompt(pergunta, opcoes, contexto, tipo, rodada) {
        const lista = opcoes.map((o, i) => `${i+1}) ${o}`).join('\n');
        const blocoCtx = contexto && contexto.length > 50
            ? `TEXTO DE APOIO (páginas do livro lidas):\n${contexto}\n`
            : '';

        const instrucoesEspeciais = {
            fato_opiniao: `ATENÇÃO — FATO vs OPINIÃO:
- FATO: descreve algo real, objetivo, verificável. Não depende de quem fala.
- OPINIÃO: expressa juízo, crença, sentimento, dúvida, possibilidade, valor ("acho", "talvez", "pode", "com certeza", "pacientemente").
- POSSIBILIDADE (pode/deve/talvez) NÃO é fato.
- ADVÉRBIOS DE MODO subjetivos ("pacientemente", "tristemente") tornam a frase OPINIÃO.
- Descrições de como algo funciona fisicamente SÃO fato.`,

            interpretacao: `Interpretação de texto: use SEMPRE o contexto. A resposta deve ser comprovada pelo texto.`,
            sinonimo: `Substitua mentalmente cada opção na frase original. Escolha a que mantém sentido idêntico.`,
            geral: `Analise cada alternativa com cuidado. Elimine as claramente erradas.`
        };
        const instrucao = instrucoesEspeciais[tipo] || instrucoesEspeciais.geral;

        const variacao = [
            'Escolha UMA opção.',
            'Pense passo a passo internamente, então escolha UMA opção.',
            'Reflita sobre cada alternativa. Elimine as erradas. Escolha a correta.'
        ][(rodada - 1) % 3];

        return `Você é um professor de português experiente corrigindo prova brasileira.

${instrucao}

${blocoCtx}
PERGUNTA:
${pergunta}

ALTERNATIVAS:
${lista}

${variacao}

FORMATO OBRIGATÓRIO — apenas uma linha:
RESPOSTA: N
Não escreva mais nada.`;
    }

    async function perguntarUmaVez(prompt, totalOpcoes, rodada) {
        for (let mi = 0; mi < MODELOS.length; mi++) {
            const modelo = MODELOS[mi];
            for (let t = 0; t < TENTATIVAS_POR_MODELO; t++) {
                try {
                    elStatus.textContent = `🌐 Modelo ${mi+1}/${MODELOS.length}...`;
                    log(`🌐 ${modelo} (tent. ${t+1})`);

                    const r = await fetch('https://openrouter.ai/api/v1/chat/completions', {
                        method: 'POST',
                        headers: {
                            'Authorization': 'Bearer ' + API_KEY,
                            'Content-Type': 'application/json',
                            'HTTP-Referer': location.origin,
                            'X-Title': 'QuizVote'
                        },
                        body: JSON.stringify({
                            model: modelo,
                            messages: [
                                { role: 'system', content: 'Responda SEMPRE no formato "RESPOSTA: N".' },
                                { role: 'user', content: prompt }
                            ],
                            temperature: rodada > 1 ? 0.4 : 0,
                            max_tokens: 400
                        })
                    });

                    if (!r.ok) {
                        const errTxt = (await r.text()).slice(0, 80);
                        log(`  ❌ HTTP ${r.status}: ${errTxt}`);
                        break; // próximo modelo
                    }

                    const d = await r.json();

                    if (d.error) {
                        log(`  ❌ API: ${JSON.stringify(d.error).slice(0,100)}`);
                        break;
                    }

                    const raw = (d.choices && d.choices[0] &&
                                 d.choices[0].message &&
                                 d.choices[0].message.content || '').trim();
                    const modeloReal = (d.model || modelo).split('/').pop();

                    if (!raw) {
                        log(`  ⚠️ Vazio (via ${modeloReal})`);
                        continue;
                    }

                    log(`  📩 "${raw.slice(0,80)}" (via ${modeloReal})`);

                    let num = null;
                    const mResp = raw.match(/RESPOSTA[:\s]*(\d+)/i);
                    if (mResp) num = parseInt(mResp[1], 10);
                    else {
                        const mNum = raw.match(/\b(\d+)\b/g);
                        if (mNum) for (const s of mNum) {
                            const n = parseInt(s, 10);
                            if (n >= 1 && n <= totalOpcoes) { num = n; break; }
                        }
                    }

                    if (num && num >= 1 && num <= totalOpcoes) {
                        log(`  ✅ ${num} via ${modeloReal}`);
                        return { num, raw, modelo: modeloReal };
                    } else {
                        log(`  ⚠️ Sem número válido`);
                    }
                } catch (e) {
                    log(`  ❌ Rede: ${e.message.slice(0,60)}`);
                }
            }
        }
        log('❌ TODOS os modelos falharam');
        return null;
    }

    async function votarQuestao(pergunta, opcoes, contexto) {
        const tipo = detectarTipoQuestao(pergunta);
        log(`📋 Tipo: ${tipo}`);

        const votos = {}, detalhes = [];
        for (let r = 1; r <= RODADAS_VOTACAO; r++) {
            log(`🗳️ Rodada ${r}/${RODADAS_VOTACAO}`);
            const prompt = montarPrompt(pergunta, opcoes, contexto, tipo, r);
            const res = await perguntarUmaVez(prompt, opcoes.length, r);
            if (!res) { log('  ❌ Sem resposta'); continue; }
            votos[res.num] = (votos[res.num] || 0) + 1;
            detalhes.push(res.num);
        }

        let maxVotos = 0, vencedor = null, empate = false;
        for (const k in votos) {
            if (votos[k] > maxVotos) { maxVotos = votos[k]; vencedor = parseInt(k, 10); empate = false; }
            else if (votos[k] === maxVotos) empate = true;
        }
        return { vencedor, votos, detalhes, empate, tipo };
    }

    // ===================== RESOLVER =====================
    async function resolverQuestao(container, tentativa) {
        setModo('resolvendo');
        try {
            const { pergunta, opcoes } = extrairQuestao(container);
            if (!pergunta || opcoes.length < 2) {
                elStatus.textContent = '❌ Não extraí';
                setModo('erro');
                return false;
            }

            const contexto = montarContexto();
            log(`Contexto: ${contexto.length} chars`);
            elStatus.textContent = `🧠 "${pergunta.slice(0, 40)}..."`;

            const resultado = await votarQuestao(pergunta, opcoes, contexto);
            const { vencedor, votos, detalhes, empate } = resultado;

            if (!vencedor) {
                elStatus.textContent = '❌ IA não respondeu.\n' +
                    '• Chave ativa?\n' +
                    '• Crédito grátis ok?\n' +
                    '• Internet?';
                setModo('erro');
                return false;
            }

            const votosStr = `[${detalhes.join(',')}]`;
            log(`Votos: ${JSON.stringify(votos)} | Seq: ${votosStr}`);

            if (empate) {
                log('⚠️ EMPATE');
                elStatus.textContent = `⚠️ Empate ${votosStr}`;
                if (!ENVIAR_SEMPRE) { setModo('erro'); return false; }
            }

            const textoOpcao = opcoes[vencedor - 1];
            log(`Marcar opção ${vencedor}: "${textoOpcao}"`);
            elStatus.textContent = `✅ (${vencedor}) ${textoOpcao.slice(0, 35)} ${votosStr}`;

            await sleep(DELAY_ANTES_CLIQUE);
            const marcou = await clicarOpcao(textoOpcao, container);

            if (VERIFICAR_ANTES_ENVIAR) {
                const marcados = qualEstaMarcado(container);
                if (marcados.length === 0) {
                    log('❌ Nada marcado — abortando');
                    elStatus.textContent = '❌ Nada marcado — abortado';
                    setModo('erro');
                    return false;
                }
                if (!bateComAlvo(marcados[0].texto, textoOpcao)) {
                    log(`❌ Marcou errada — abortando`);
                    elStatus.textContent = '❌ Marcou errada — abortado';
                    setModo('erro');
                    return false;
                }
            }

            if (!marcou) {
                elStatus.textContent = '❌ Não marquei';
                setModo('erro');
                return false;
            }

            elStatus.textContent = '👆 Marcada. Enviando...';

            if (AUTOSUBMIT) {
                await sleep(DELAY_POS_OPCAO);
                const enviou = await clicarTerminar();
                if (enviou) {
                    await sleep(DELAY_POS_TERMINAR);
                    elStatus.textContent = `📤 Enviado! ${votosStr}`;
                } else {
                    elStatus.textContent = '⚠️ TERMINAR não achado';
                }
            }
            return true;
        } catch (e) {
            elStatus.textContent = '❌ ' + e.message.slice(0, 55);
            console.error(e);
            setModo('erro');
            return false;
        }
    }

    // ===================== LOOP =====================
    async function loopPrincipal() {
        guardarPaginaAtual(); atualizarMem();

        while (modo !== 'parado') {
            const container = acharContainerQuestao();
            if (container && !processandoQuestao) {
                const textoAtual = (container.innerText || '').trim();
                if (textoAtual !== ultimaQuestao ||
                    Date.now() - inicioQuestao > TIMEOUT_QUESTAO ||
                    pedidoRepetir) {
                    ultimaQuestao = textoAtual;
                    inicioQuestao = Date.now();
                    processandoQuestao = true;
                    pedidoRepetir = false;
                    await resolverQuestao(container, tentativaAtual);
                    tentativaAtual = 1;
                    await sleep(ESPERA_POS_Q);
                    let t = 0;
                    while (acharContainerQuestao() && t < 20) { await sleep(500); t++; }
                    processandoQuestao = false;
                    ultimaQuestao = '';
                    setModo('folheando');
                    contador = SEGUNDOS_PAGINA;
                    continue;
                }
            }

            await sleep(1000);
            if (modo === 'parado') break;
            if (processandoQuestao) continue;

            contador--;
            elContador.textContent = contador;
            guardarPaginaAtual(); atualizarMem();

            if (contador <= 0) {
                guardarPaginaAtual();
                avancarPagina();
                paginasViradas++;
                elTotal.textContent = paginasViradas;
                contador = SEGUNDOS_PAGINA;
                elContador.textContent = contador;
                await sleep(800);
                guardarPaginaAtual(); atualizarMem();
            }
        }
    }

    function avancarPagina() {
        try {
            const alvo = document.querySelector('[ng-click*="goToNextPage"]')
                      || document.querySelector('.page-switch-overlay-icon.next');
            if (alvo && window.angular) {
                let s = angular.element(alvo).scope(), n = 0;
                while (s && typeof s.goToNextPage !== 'function' && n < 12) { s = s.$parent; n++; }
                if (s && typeof s.goToNextPage === 'function') {
                    s.$apply(() => s.goToNextPage()); return;
                }
            }
        } catch (e) {}
        const btn = document.querySelector('.page-switch-overlay-icon.embedded.next');
        if (btn && btn.offsetParent !== null) { btn.click(); return; }
        document.dispatchEvent(new KeyboardEvent('keydown', {
            key:'ArrowRight', code:'ArrowRight', keyCode:39, which:39, bubbles:true
        }));
    }

    // ===================== BOTÕES =====================
    function parar() {
        modo = 'parado';
        setTimeout(() => painel.remove(), 100);
        window.__autoIA = null;
        console.log('[AutoIA] Parado. Páginas:', paginasViradas);
    }
    painel.querySelector('#__btnParar').onclick = parar;
    painel.querySelector('#__btnKey').onclick = () => {
        const nova = prompt('Nova chave OpenRouter:', API_KEY);
        if (nova) { API_KEY = nova; localStorage.setItem('__or_key', nova); }
    };
    painel.querySelector('#__btnMem').onclick = () => {
        const ctx = montarContexto();
        alert(`📚 Memória: ${memoria.paginas.length} págs, ${memoria.charsTotal} chars\nContexto: ${ctx.length}\n\n--- Prévia ---\n${ctx.slice(0, 400)}...`);
    };
    btnRepetir.onclick = () => {
        const container = acharContainerQuestao();
        if (!container) { elStatus.textContent = '⚠️ Sem questão'; return; }
        if (processandoQuestao) { elStatus.textContent = '⏳ Já resolvendo'; return; }
        tentativaAtual++;
        pedidoRepetir = true;
        log(`🔄 Repetir (tentativa ${tentativaAtual})`);
    };

    // ===================== INICIA =====================
    window.__autoIA = { parar };
    console.log('[AutoIA] Ativo. Modelos:', MODELOS.length, '| Verificação:', VERIFICAR_ANTES_ENVIAR);

    setModo('folheando');
    loopPrincipal();
})();