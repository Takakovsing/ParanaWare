(() => {
  if (document.querySelector("#pIA")) return;

  let key = localStorage.pk || "";
  const box = document.createElement("div");

  box.id = "pIA";
  box.style = "position:fixed;z-index:999999;top:15%;right:8px;width:165px;padding:9px;background:#111;color:white;border:1px solid #444;border-radius:9px;font:12px Arial";

  box.innerHTML = `
    <b>🕸️ PORTUGA IA</b>
    <span id="x" style="float:right;cursor:pointer">✕</span>
    <p id="s">Pronto</p>
    <button id="l">📖 Ler</button>
    <button id="a">✦ IA</button>
    <button id="c">🔑</button>
    <div id="o" style="white-space:pre-wrap;max-height:220px;overflow:auto;margin-top:7px"></div>
  `;

  document.body.append(box);

  const $ = id => box.querySelector("#" + id);
  const texto = () => document.body.innerText.slice(0, 7000);

  $("x").onclick = () => box.remove();

  $("l").onclick = async () => {
    try {
      await navigator.clipboard.writeText(texto());
      $("s").textContent = "Texto copiado!";
    } catch {
      $("s").textContent = "Não foi possível copiar.";
    }
  };

  $("c").onclick = () => {
    const value = prompt("Chave OpenRouter:", key);
    if (value !== null) {
      key = value.trim();
      localStorage.pk = key;
    }
  };

  $("a").onclick = async () => {
    if (!key) {
      $("o").textContent = "Configure a chave 🔑";
      return;
    }

    $("o").textContent = "Pensando...";

    try {
      const response = await fetch(
        "https://openrouter.ai/api/v1/chat/completions",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Authorization": "Bearer " + key
          },
          body: JSON.stringify({
            model: "openrouter/free",
            messages: [{
              role: "user",
              content:
                "Explique o conteúdo e ajude a compreender as perguntas, sem inventar informações:\n" +
                texto()
            }]
          })
        }
      );

      const data = await response.json();

      if (!response.ok)
        throw new Error(data.error?.message || response.status);

      $("o").textContent =
        data.choices?.[0]?.message?.content || "Sem resposta.";

    } catch (error) {
      $("o").textContent = "Erro: " + error.message;
    }
  };
})();